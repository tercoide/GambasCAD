# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,96,68)
  Text = ("Settings")
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  { pSearch Panel
    MoveScaled(1,1,94,4)
    Arrangement = Arrange.Horizontal
    Spacing = True
    { bxSearch ButtonBox
      MoveScaled(0,0,40,4)
      Expand = True
      Placeholder = ("Search settings")
      Button = False
      ClearButton = True
    }
  }
  { pMain Panel
    MoveScaled(1,6,94,54)
    Expand = True
    Arrangement = Arrange.Horizontal
    Spacing = True
    { lstSections ListBox
      MoveScaled(0,0,22,54)
    }
    { svRows ScrollView
      MoveScaled(23,0,70,54)
      Expand = True
      Arrangement = Arrange.Vertical
      Spacing = True
      Margin = True
      ScrollBar = Scroll.Vertical
    }
  }
  { pButtons Panel
    MoveScaled(1,61,94,5)
    Arrangement = Arrange.Horizontal
    Spacing = True
    { btnDefaults Button
      MoveScaled(0,0,20,4)
      Text = ("Restore defaults")
      ToolTip = ("Restore the default values of the settings shown")
    }
    { Spring1 Spring
      MoveScaled(21,0,20,4)
    }
    { btnCancel Button
      MoveScaled(43,0,16,4)
      Text = ("Cancel")
      Cancel = True
    }
    { btnApply Button
      MoveScaled(60,0,16,4)
      Text = ("Apply")
    }
    { btnOK Button
      MoveScaled(77,0,16,4)
      Text = ("OK")
      Default = True
    }
  }
}
