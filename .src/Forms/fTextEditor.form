# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,100,40)
  Text = ("Text editor")
  Stacking = Window.Above
  Utility = True
  SkipTaskbar = True
  { Label1 Label
    MoveScaled(1,1,7,4)
    Text = ("Style")
  }
  { cmbStyle ComboBox
    MoveScaled(8,1,20,4)
    ReadOnly = True
  }
  { Label3 Label
    MoveScaled(30,1,7,4)
    Text = ("Angle")
  }
  { vbAngle ValueBox
    MoveScaled(37,1,9,4)
  }
  { Label2 Label
    MoveScaled(48,1,11,4)
    Text = ("Box width")
  }
  { vbWidth ValueBox
    MoveScaled(59,1,11,4)
    ToolTip = ("Width of the text box; the lines wrap at this width. 0 = no wrapping")
  }
  { pnlFormat Panel
    MoveScaled(1,6,98,4)
    Arrangement = Arrange.Horizontal
    Spacing = True
    { btnUnder ToolButton Fmt
      MoveScaled(0,0,4,4)
      Font = Font["Underline"]
      Tag = "U"
      ToolTip = ("Underline")
      Text = ("U")
    }
    { btnOver ToolButton Fmt
      MoveScaled(4,0,4,4)
      Tag = "O"
      ToolTip = ("Overline")
      Text = ("O")
    }
    { btnStack ToolButton
      MoveScaled(9,0,6,4)
      ToolTip = ("Insert a fraction: 1/2, 1#2 (diagonal) or +0.1^-0.2 (tolerance)")
      Text = ("a/b")
    }
    { cmbSymbol ComboBox
      MoveScaled(16,0,18,4)
      ToolTip = ("Insert a symbol")
      ReadOnly = True
    }
    { btnClear ToolButton
      MoveScaled(35,0,9,4)
      ToolTip = ("Remove the formatting codes from the text")
      Text = ("Clear")
    }
    { Spring2 Spring
      MoveScaled(45,0,32,4)
    }
    { btnParLeft ToolButton Par
      MoveScaled(78,0,4,4)
      Tag = "l"
      ToolTip = ("Align the paragraph to the left")
      Picture = Picture["icon:/small/align-left"]
    }
    { btnParCenter ToolButton Par
      MoveScaled(82,0,4,4)
      Tag = "c"
      ToolTip = ("Center the paragraph")
      Picture = Picture["icon:/small/align-center"]
    }
    { btnParRight ToolButton Par
      MoveScaled(86,0,4,4)
      Tag = "r"
      ToolTip = ("Align the paragraph to the right")
      Picture = Picture["icon:/small/align-right"]
    }
    { btnParJustify ToolButton Par
      MoveScaled(90,0,4,4)
      Tag = "j"
      ToolTip = ("Justify the paragraph")
      Picture = Picture["icon:/small/align-justify"]
    }
  }
  { pnlChar Panel
    MoveScaled(1,11,98,4)
    Arrangement = Arrange.Horizontal
    Spacing = True
    { lblChar Label
      MoveScaled(0,0,10,4)
      Text = ("Insert") & ":"
    }
    { Label4 Label
      MoveScaled(10,0,6,4)
      Text = ("Width")
    }
    { vbWF ValueBox
      MoveScaled(16,0,7,4)
      ToolTip = ("Width factor of the letters, 1 = normal")
    }
    { Label5 Label
      MoveScaled(24,0,7,4)
      Text = ("Oblique")
    }
    { vbOblique ValueBox
      MoveScaled(31,0,7,4)
      ToolTip = ("Slant of the letters, in degrees")
    }
    { lblTrack Label
      MoveScaled(39,0,8,4)
      Text = ("Tracking")
    }
    { vbTrack ValueBox
      MoveScaled(47,0,7,4)
      ToolTip = ("Spacing between letters, 1 = normal")
    }
    { btnApplyChar Button
      MoveScaled(55,0,10,4)
      ToolTip = ("Insert width, oblique and tracking codes at the cursor; what is typed after them takes them")
      Text = ("Apply")
    }
  }
  { lblAttach Label
    MoveScaled(1,17,21,4)
    Text = ("Insertion point")
  }
  { pnlAttach Panel
    MoveScaled(1,22,21,14)
    { tbtAtt1 ToolButton Att
      MoveScaled(0,0,7,4)
      Tag = "1"
      ToolTip = ("Top left")
      Text = ("TL")
      Toggle = True
      Radio = True
    }
    { tbtAtt2 ToolButton Att
      MoveScaled(7,0,7,4)
      Tag = "2"
      ToolTip = ("Top center")
      Text = ("TC")
      Toggle = True
      Radio = True
    }
    { tbtAtt3 ToolButton Att
      MoveScaled(14,0,7,4)
      Tag = "3"
      ToolTip = ("Top right")
      Text = ("TR")
      Toggle = True
      Radio = True
    }
    { tbtAtt4 ToolButton Att
      MoveScaled(0,5,7,4)
      Tag = "4"
      ToolTip = ("Middle left")
      Text = ("ML")
      Toggle = True
      Radio = True
    }
    { tbtAtt5 ToolButton Att
      MoveScaled(7,5,7,4)
      Tag = "5"
      ToolTip = ("Middle center")
      Text = ("MC")
      Toggle = True
      Radio = True
    }
    { tbtAtt6 ToolButton Att
      MoveScaled(14,5,7,4)
      Tag = "6"
      ToolTip = ("Middle right")
      Text = ("MR")
      Toggle = True
      Radio = True
    }
    { tbtAtt7 ToolButton Att
      MoveScaled(0,10,7,4)
      Tag = "7"
      ToolTip = ("Bottom left")
      Text = ("BL")
      Toggle = True
      Radio = True
    }
    { tbtAtt8 ToolButton Att
      MoveScaled(7,10,7,4)
      Tag = "8"
      ToolTip = ("Bottom center")
      Text = ("BC")
      Toggle = True
      Radio = True
    }
    { tbtAtt9 ToolButton Att
      MoveScaled(14,10,7,4)
      Tag = "9"
      ToolTip = ("Bottom right")
      Text = ("BR")
      Toggle = True
      Radio = True
    }
  }
  { lblPrompt Label
    MoveScaled(24,17,75,13)
    Alignment = Align.TopLeft
  }
  { btnCancel Button
    MoveScaled(64,33,16,5)
    Text = ("Cancel")
  }
  { btnOK Button
    MoveScaled(82,33,17,5)
    Text = ("OK")
  }
}
