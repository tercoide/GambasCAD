'' Capa de comandos: ejecuta acciones sobre el dibujo sin mouse ni interfaz.
'' La usan (o la van a usar) las herramientas, la linea de comandos, los scripts, las pruebas y el asistente.
''
'' Cada comando recibe sus argumentos en una Collection (lo mismo que un objeto JSON) y devuelve otra:
''   {"ok": True, "created": [ids], "modified": [ids], "deleted": [ids], ...datos del comando}
''   {"ok": False, "error": "texto"}
'' Las entidades se leen y escriben en el mismo JSON que el formato .gcd (ver JsonFile).
'' Con gcd.Interactive = False no se toca OpenGL ni la interfaz.

Private $bBatch As Boolean               ' entre BeginBatch y EndBatch se redibuja una sola vez, al final
Private $bPendingRefresh As Boolean

'' Ejecuta un comando y devuelve el resultado
Public Function Run(sCommand As String, Optional cArgs As Collection) As Collection

    Dim r As Collection

    r = NewResult()
    If Not cArgs Then cArgs = New Collection
    If Not gcd.Drawing Then Return Fail(r, "No drawing open")

    Select Case UCase(sCommand)
        Case "ADD"
            DoAdd(cArgs, r)
        Case "GET"
            DoGet(cArgs, r)
        Case "ENTITIES"
            DoEntities(cArgs, r)
        Case "LAYERS"
            DoLayers(r)
        Case "INFO"
            DoInfo(r)
        Case "DELETE"
            DoDelete(cArgs, r)
        Case "MOVE"
            DoMove(cArgs, r)
        Case "COPY"
            DoCopy(cArgs, r)
        Case "ROTATE"
            DoRotate(cArgs, r)
        Case "SCALE"
            DoScale(cArgs, r)
        Case "MIRROR"
            DoMirror(cArgs, r)
        Case "SET"
            DoSet(cArgs, r)
        Case "UNDO"
            DoUndo(r, False)
        Case "REDO"
            DoUndo(r, True)
        Case "LIST"
            r["commands"] = List()
        Case Else
            Return Fail(r, "Unknown command " & sCommand)
    End Select

    If r["ok"] Then AfterCommand(r)
    Return r

Catch
    Try gcd.Drawing.uUndo.CloseUndoStage()      ' que un error no deje el undo bloqueado
    Return Fail(r, Error.Text & " (" & Error.Where & ")")

End

'' Lo mismo en texto JSON: {"command": "ADD", "args": {...}} -> resultado en JSON
Public Function RunJson(sJson As String) As String

    Dim c As Collection
    Dim r As Collection

    Try c = JSON.Decode(sJson, True)
    If Error Or If Not c Then
        r = Fail(NewResult(), "Invalid JSON")
    Else If TypeOf(c["command"]) <> gb.String Then
        r = Fail(NewResult(), "Missing \"command\"")
    Else
        r = Run(c["command"], c["args"])
    Endif
    Return JSON.Encode(r)

End

'' Lo mismo desde una linea de texto, como en la linea de comandos:
''   LINE 0,0 10,0 @0,5        CIRCLE 5,5 2          MOVE 10,0        ROTATE 90 0,0 ids=4003,4004
'' Puntos x,y o x,y,z (@ = relativo al ultimo punto), numeros, opciones clave=valor, y "textos" entre comillas.
Public Function RunText(sLine As String) As Collection

    Dim aTok As String[]
    Dim sWord, sRest As String
    Dim r As Collection

    sLine = Trim(sLine)
    aTok = SplitWords(sLine)
    If aTok.Count = 0 Then Return Fail(NewResult(), "Empty command")
    sWord = ResolveWord(aTok[0])

    ' ADD lleva el JSON tal cual
    If sWord = "ADD" Then
        sRest = Trim(Mid(sLine, Len(aTok[0]) + 1))
        Return RunTextAdd(sRest)
    Endif

    r = NewResult()
    If Not ParseTokens(aTok, sWord, r) Then Return r
    Return RunParsed(sWord, r)

End

'' True si la linea es para la capa de comandos y no para arrancar una herramienta interactiva:
'' las palabras que solo existen como comando siempre; las demas (LINE, MOVE...) solo si traen argumentos.
Public Function HandlesText(sLine As String) As Boolean

    Dim aTok As String[]
    Dim sWord As String

    aTok = SplitWords(Trim(sLine))
    If aTok.Count = 0 Then Return False
    sWord = ResolveWord(aTok[0])
    If ["ADD", "GET", "ENTITIES", "LAYERS", "INFO", "DELETE", "SET", "UNDO", "REDO", "LIST"].Exist(sWord) Then Return True
    If ["LINE", "CIRCLE", "ARC", "POINT", "MOVE", "COPY", "ROTATE", "SCALE", "MIRROR"].Exist(sWord) Then Return aTok.Count > 1
    Return False

End

'' Como se escribe cada comando en la linea de texto
Public Function TextHelp() As Collection

    Dim c As New Collection

    c["LINE"] = "LINE x,y x,y [x,y ...]   (one line per segment)"
    c["CIRCLE"] = "CIRCLE x,y radius"
    c["ARC"] = "ARC x,y radius start end   (angles in degrees, counterclockwise)"
    c["POINT"] = "POINT x,y [x,y ...]"
    c["ADD"] = "ADD {entity JSON} | [entity JSON, ...]"
    c["MOVE"] = "MOVE dx,dy | MOVE from to   [ids=a,b]"
    c["COPY"] = "COPY dx,dy | COPY from to   [ids=a,b]"
    c["ROTATE"] = "ROTATE angle [base]   [ids=a,b]"
    c["SCALE"] = "SCALE factor [base]   [ids=a,b]"
    c["MIRROR"] = "MIRROR p1 p2 | MIRROR base angle   [keep=yes] [ids=a,b]"
    c["SET"] = "SET layer=NAME color=N linetype=NAME linewidth=N   [ids=a,b]"
    c["DELETE"] = "DELETE [id id ...]   (default: selection)"
    c["GET"] = "GET id"
    c["ENTITIES"] = "ENTITIES [layer=NAME] [entity=TYPE] [limit=N] [x0,y0 x1,y1]"
    c["LAYERS"] = "LAYERS"
    c["INFO"] = "INFO"
    c["UNDO"] = "UNDO"
    c["REDO"] = "REDO"
    c["LIST"] = "LIST"
    c["options"] = "layer=, color=, linetype=, linewidth= also work on LINE, CIRCLE, ARC and POINT"
    Return c

End

'' Catalogo de comandos: nombre -> descripcion de lo que hace y sus argumentos
Public Function List() As Collection

    Dim c As New Collection

    c["ADD"] = "Add entities. Args: entity (one entity JSON, same format as a .gcd file) or entities (array). Layer, line type and color default to the current ones. Returns created ids."
    c["GET"] = "Get one entity as JSON. Args: id."
    c["ENTITIES"] = "List entities of the current sheet. Args (all optional): layer, entity (type, e.g. LINE), bbox [x0,y0,x1,y1], limit (default 1000). Returns entities and count."
    c["LAYERS"] = "List layers with their properties and entity count."
    c["INFO"] = "Summary of the drawing: file, sheets, current layer and style, layers, entity count by type, extents, selection, undo."
    c["DELETE"] = "Delete entities, in one undo step. Args: ids (default: current selection). Returns deleted ids and notfound ids."
    c["MOVE"] = "Move entities, in one undo step. Args: ids (default: current selection), dx, dy, dz (default 0)."
    c["COPY"] = "Copy entities displaced by dx, dy, dz (default 0) into the current sheet, in one undo step. Args: ids (default: selection), dx, dy, dz. Returns created ids."
    c["ROTATE"] = "Rotate entities around a point, in one undo step. Args: ids (default: selection), angle (degrees, counterclockwise), base [x, y] (default [0, 0])."
    c["SCALE"] = "Scale entities uniformly from a point, in one undo step. Args: ids (default: selection), factor (> 0), base [x, y] (default [0, 0])."
    c["MIRROR"] = "Mirror entities about a line through base with the given angle, in one undo step. Args: ids (default: selection), base [x, y] (default [0, 0]), angle (degrees of the mirror line, default 90), keep (true: mirror copies and keep the originals; default false)."
    c["SET"] = "Change properties of entities, in one undo step. Args: ids (default: selection), and any of layer, color, linetype, linewidth."
    c["UNDO"] = "Undo the last change."
    c["REDO"] = "Redo the last undone change."
    c["LIST"] = "This list."
    Return c

End

'=============================================== COMANDOS ===============================================

Private Sub DoAdd(cArgs As Collection, r As Collection)

    Dim aList As New Variant[]
    Dim v As Variant
    Dim c As Collection
    Dim e As Entity

    If cArgs["entity"] Then aList.Add(cArgs["entity"])
    If cArgs["entities"] Then
        For Each v In cArgs["entities"]
            aList.Add(v)
        Next
    Endif
    If aList.Count = 0 Then
        Fail(r, "ADD needs entity or entities")
        Return
    Endif

    ' primero valido todo, asi no queda nada a medias
    For Each v In aList
        If TypeOf(v) <> gb.Object Or If Not (v Is Collection) Then
            Fail(r, "Each entity must be a JSON object")
            Return
        Endif
        c = v
        If Not gcd.CCC.Exist(c["entity"]) Then
            Fail(r, "Unknown entity type " & c["entity"])
            Return
        Endif
        If c.Exist("layer") And If Not gcd.Drawing.Layers.Exist(c["layer"]) Then
            Fail(r, "Unknown layer " & c["layer"])
            Return
        Endif
    Next

    ' todo el ADD es un solo paso de undo
    gcd.Drawing.uUndo.OpenUndoStage(("Add entities"), Undo.TypeCreate)
    For Each c In aList
        e = JsonFile.JsonToEntity(c, gcd.Drawing.Sheet.Block, True)       ' sin Finish: lo hace AddEntity
        If Not e Then
            gcd.Drawing.uUndo.CloseUndoStage()
            Fail(r, "Can't create " & c["entity"])
            Return
        Endif

        ' los ids los decide el dibujo, y lo que no viene toma los valores actuales
        e.Id = ""
        If Not c.Exist("layer") Then e.pLayer = gcd.Drawing.CurrLayer
        If Not c.Exist("linetype") And If gcd.Drawing.CurrLineType Then e.LineType = gcd.Drawing.CurrLineType
        If e.LineWidth = 0 Then e.LineWidth = 1                          ' igual que cadEntityBuilder

        gcd.AddEntity(e,, True)
        gcd.Drawing.uUndo.AddUndoItem(e)
        gcd.CCC[e.Gender].ImportJsonParts(e, c)
        r["created"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()

End

'' Como JsonFile.EntityToJson, pero con los puntos en "p" como pares x,y: el mismo formato que acepta ADD
Private Function EntityToCmdJson(e As Entity) As Collection

    Dim j As Collection

    j = JsonFile.EntityToJson(e)
    If j.Exist("pts") Then j.Remove("pts")
    j["p"] = puntos.ToXY(e.P)
    Return j

End

Private Sub DoGet(cArgs As Collection, r As Collection)

    Dim e As Entity

    e = FindEntity(cArgs["id"])
    If Not e Then
        Fail(r, "No entity " & cArgs["id"])
        Return
    Endif
    r["entity"] = EntityToCmdJson(e)

End

Private Sub DoEntities(cArgs As Collection, r As Collection)

    Dim e As Entity
    Dim aList As New Collection[]
    Dim fBox As Float[]
    Dim iLimit As Integer = 1000
    Dim iCount As Integer

    If cArgs["bbox"] Then
        fBox = JsonFile.ToFloats(cArgs["bbox"])
        If fBox.Count <> 4 Then
            Fail(r, "bbox must be [x0, y0, x1, y1]")
            Return
        Endif
    Endif
    If cArgs.Exist("limit") Then iLimit = cArgs["limit"]

    For Each e In gcd.Drawing.Sheet.Entities
        If cArgs["layer"] And If e.pLayer.Name <> cArgs["layer"] Then Continue
        If cArgs["entity"] And If UCase(e.Gender) <> UCase(cArgs["entity"]) Then Continue
        If fBox Then
            ' se superponen los limites de la entidad y el recuadro
            If e.Limits[2] < fBox[0] Or e.Limits[0] > fBox[2] Or e.Limits[3] < fBox[1] Or e.Limits[1] > fBox[3] Then Continue
        Endif
        Inc iCount
        If aList.Count < iLimit Then aList.Add(EntityToCmdJson(e))
    Next

    r["entities"] = aList
    r["count"] = iCount                 ' puede ser mayor que lo devuelto, si se paso el limite

End

Private Sub DoLayers(r As Collection)

    Dim l As Layer
    Dim e As Entity
    Dim j As Collection
    Dim cCount As New Collection
    Dim aList As New Collection[]

    For Each e In gcd.Drawing.Sheet.Entities
        If cCount.Exist(e.pLayer.Name) Then
            cCount[e.pLayer.Name] += 1
        Else
            cCount[e.pLayer.Name] = 1
        Endif
    Next

    For Each l In gcd.Drawing.Layers
        j = l.ExportJson()
        j["entities"] = IIf(cCount.Exist(l.Name), cCount[l.Name], 0)
        j["current"] = (l = gcd.Drawing.CurrLayer)
        aList.Add(j)
    Next
    r["layers"] = aList

End

Private Sub DoDelete(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity
    Dim c As Collection

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return

    gcd.Drawing.uUndo.OpenUndoStage(("Delete entities"), Undo.TypeDelete)
    For Each e In aEnt
        gcd.Drawing.uUndo.AddUndoItem(e)
        If e.Container Then
            c = e.Container.entities
            If c.Exist(e.Id) Then c.Remove(e.Id)
        Endif
        For Each s As Sheet In gcd.Drawing.Sheets
            If s.Entities.Exist(e.Id) Then s.Entities.Remove(e.Id)
            If s.EntitiesVisibles.Exist(e.Id) Then s.EntitiesVisibles.Remove(e.Id)
            If s.EntitiesSelected.Exist(e.Id) Then s.EntitiesSelected.Remove(e.Id)
        Next
        r["deleted"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoMove(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity
    Dim dx, dy, dz As Float

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return
    If Not GetFloat(cArgs, "dx", 0, r, ByRef dx) Then Return
    If Not GetFloat(cArgs, "dy", 0, r, ByRef dy) Then Return
    If Not GetFloat(cArgs, "dz", 0, r, ByRef dz) Then Return

    gcd.Drawing.uUndo.OpenUndoStage(("Move entities"), Undo.TypeModify)
    For Each e In aEnt
        gcd.Drawing.uUndo.AddUndoItem(e)
        gcd.CCC[e.Gender].Translate(e, dx, dy, dz)
        r["modified"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoCopy(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e, eCopy As Entity
    Dim dx, dy, dz As Float

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return
    If Not GetFloat(cArgs, "dx", 0, r, ByRef dx) Then Return
    If Not GetFloat(cArgs, "dy", 0, r, ByRef dy) Then Return
    If Not GetFloat(cArgs, "dz", 0, r, ByRef dz) Then Return

    ' las copias van a la hoja actual, aunque el original este en otra
    gcd.Drawing.uUndo.OpenUndoStage(("Copy entities"), Undo.TypeCreate)
    For Each e In aEnt
        eCopy = clsEntities.ClonEntity(e, True)
        gcd.CCC[eCopy.Gender].Translate(eCopy, dx, dy, dz)
        gcd.AddEntity(eCopy,, True)
        gcd.Drawing.uUndo.AddUndoItem(eCopy)
        r["created"].Add(eCopy.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()

End

Private Sub DoRotate(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity
    Dim fAngle As Float
    Dim fBase As Float[]

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return
    If Not cArgs.Exist("angle") Then
        Fail(r, "ROTATE needs angle")
        Return
    Endif
    If Not GetFloat(cArgs, "angle", 0, r, ByRef fAngle) Then Return
    fBase = GetPoint(cArgs, "base", r)
    If Not fBase Then Return

    gcd.Drawing.uUndo.OpenUndoStage(("Rotate"), Undo.TypeModify)
    For Each e In aEnt
        gcd.Drawing.uUndo.AddUndoItem(e)
        gcd.CCC[e.Gender].Translate(e, -fBase[0], -fBase[1], 0)
        gcd.CCC[e.Gender].Rotate(e, Rad(fAngle))
        gcd.CCC[e.Gender].Translate(e, fBase[0], fBase[1], 0)
        gcd.CCC[e.Gender].BuildGeometry(e)
        r["modified"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoScale(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity
    Dim fFactor As Float
    Dim fBase As Float[]

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return
    If Not GetFloat(cArgs, "factor", 0, r, ByRef fFactor) Then Return
    If fFactor <= 0 Then
        Fail(r, "SCALE needs factor > 0")
        Return
    Endif
    fBase = GetPoint(cArgs, "base", r)
    If Not fBase Then Return

    gcd.Drawing.uUndo.OpenUndoStage(("Scale"), Undo.TypeModify)
    For Each e In aEnt
        gcd.Drawing.uUndo.AddUndoItem(e)
        gcd.CCC[e.Gender].Translate(e, -fBase[0], -fBase[1], 0)
        gcd.CCC[e.Gender].Scale(e, fFactor, fFactor)
        gcd.CCC[e.Gender].Translate(e, fBase[0], fBase[1], 0)
        gcd.CCC[e.Gender].BuildGeometry(e)
        r["modified"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoMirror(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity
    Dim fAngle As Float
    Dim fBase As Float[]
    Dim bKeep As Boolean

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return
    If Not GetFloat(cArgs, "angle", 90, r, ByRef fAngle) Then Return
    fBase = GetPoint(cArgs, "base", r)
    If Not fBase Then Return
    If cArgs.Exist("keep") Then bKeep = cArgs["keep"]

    If bKeep Then
        gcd.Drawing.uUndo.OpenUndoStage(("Mirror"), Undo.TypeCreate)
    Else
        gcd.Drawing.uUndo.OpenUndoStage(("Mirror"), Undo.TypeModify)
    Endif

    For Each e In aEnt
        If bKeep Then
            e = clsEntities.ClonEntity(e, True)
        Else
            gcd.Drawing.uUndo.AddUndoItem(e)
        Endif

        ' simetria respecto de X y luego rotacion del doble del angulo = simetria respecto de la recta
        gcd.CCC[e.Gender].Translate(e, -fBase[0], -fBase[1], 0)
        gcd.CCC[e.Gender].Scale(e, 1, -1)
        gcd.CCC[e.Gender].Rotate(e, Rad(2 * fAngle))
        gcd.CCC[e.Gender].Translate(e, fBase[0], fBase[1], 0)

        If bKeep Then
            gcd.AddEntity(e,, True)
            gcd.Drawing.uUndo.AddUndoItem(e)
            r["created"].Add(e.Id)
        Else
            gcd.CCC[e.Gender].BuildGeometry(e)
            r["modified"].Add(e.Id)
        Endif
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoSet(cArgs As Collection, r As Collection)

    Dim aEnt As Entity[]
    Dim e As Entity

    aEnt = Targets(cArgs, r)
    If Not aEnt Then Return

    ' primero valido, asi no queda nada a medias
    If cArgs.Exist("layer") And If Not gcd.Drawing.Layers.Exist(cArgs["layer"]) Then
        Fail(r, "Unknown layer " & cArgs["layer"])
        Return
    Endif
    If cArgs.Exist("linetype") And If Not gcd.Drawing.LineTypes.Exist(cArgs["linetype"]) Then
        Fail(r, "Unknown line type " & cArgs["linetype"])
        Return
    Endif
    If Not (cArgs.Exist("layer") Or cArgs.Exist("color") Or cArgs.Exist("linetype") Or cArgs.Exist("linewidth")) Then
        Fail(r, "SET needs layer, color, linetype or linewidth")
        Return
    Endif

    gcd.Drawing.uUndo.OpenUndoStage(("Change properties"), Undo.TypeModify)
    For Each e In aEnt
        gcd.Drawing.uUndo.AddUndoItem(e)
        If cArgs.Exist("layer") Then e.pLayer = gcd.Drawing.Layers[cArgs["layer"]]
        If cArgs.Exist("color") Then e.Colour = CInt(cArgs["color"])
        If cArgs.Exist("linetype") Then e.LineType = gcd.Drawing.LineTypes[cArgs["linetype"]]
        If cArgs.Exist("linewidth") Then e.LineWidth = CInt(cArgs["linewidth"])
        r["modified"].Add(e.Id)
    Next
    gcd.Drawing.uUndo.CloseUndoStage()
    gcd.Drawing.RequiresSaving = True

End

Private Sub DoInfo(r As Collection)

    Dim drw As Drawing = gcd.Drawing
    Dim s As Sheet
    Dim e As Entity
    Dim l As Layer
    Dim cCur, cTypes, cSel As New Collection
    Dim aSheets, aLayers, aSelIds As New String[]
    Dim fBox As Float[] = [1e100, 1e100, -1e100, -1e100]
    Dim iCount As Integer

    r["file"] = drw.FileName
    r["sheet"] = drw.Sheet.Name
    For Each s In drw.Sheets
        aSheets.Add(s.Name)
    Next
    r["sheets"] = aSheets
    r["is3d"] = drw.Sheet.Is3D

    Try cCur["layer"] = drw.CurrLayer.Name
    Try cCur["linetype"] = drw.CurrLineType.Name
    Try cCur["textstyle"] = drw.CurrTextStyle.name
    Try cCur["dimstyle"] = drw.CurrDimStyle.name
    cCur["color"] = drw.CurrColor
    cCur["linewidth"] = drw.CurrLineWt
    r["current"] = cCur

    For Each l In drw.Layers
        aLayers.Add(l.Name)
    Next
    r["layer_names"] = aLayers

    ' entidades por tipo y extension, en la hoja actual
    For Each e In drw.Sheet.Entities
        Inc iCount
        If cTypes.Exist(e.Gender) Then
            cTypes[e.Gender] += 1
        Else
            cTypes[e.Gender] = 1
        Endif
        If Abs(e.Limits[0]) < 1e90 And Abs(e.Limits[2]) < 1e90 Then
            fBox[0] = Min(fBox[0], e.Limits[0])
            fBox[1] = Min(fBox[1], e.Limits[1])
            fBox[2] = Max(fBox[2], e.Limits[2])
            fBox[3] = Max(fBox[3], e.Limits[3])
        Endif
    Next
    r["entity_count"] = iCount
    r["by_type"] = cTypes
    If fBox[0] <= fBox[2] Then r["extents"] = fBox

    For Each e In drw.Sheet.EntitiesSelected
        If aSelIds.Count < 50 Then aSelIds.Add(e.Id)
    Next
    cSel["count"] = drw.Sheet.EntitiesSelected.Count
    cSel["ids"] = aSelIds                 ' como mucho 50
    r["selection"] = cSel

    r["can_undo"] = drw.uUndo.cUndo.Count > 0
    r["can_redo"] = drw.uUndo.cRedo.Count > 0

End

'' El nombre de un paso de undo: el del grupo si es parte de uno
Private Function StageName(st As UndoStage) As String

    If st.GroupId <> 0 Then Return st.GroupName
    Return st.Name

End

'' Varios comandos seguidos (por ejemplo, las herramientas que pide el asistente): la pantalla se actualiza una vez, en EndBatch
Public Sub BeginBatch()

    $bBatch = True
    $bPendingRefresh = False

End

Public Sub EndBatch()

    $bBatch = False
    If $bPendingRefresh Then
        $bPendingRefresh = False
        Refresh()
    Endif

End

Private Sub DoUndo(r As Collection, bRedo As Boolean)

    Dim u As Undo = gcd.Drawing.uUndo

    If bRedo Then
        If u.cRedo.Count = 0 Then
            Fail(r, "Nothing to redo")
            Return
        Endif
        r["message"] = ("Redo") & ": " & StageName(u.cRedo.Last)
        u.DoRedo()
    Else
        If u.cUndo.Count = 0 Then
            Fail(r, "Nothing to undo")
            Return
        Endif
        r["message"] = ("Undo") & ": " & StageName(u.cUndo.Last)
        u.DoUndo()
    Endif
    r["changed"] = True                 ' no se sabe que entidades cambiaron
    gcd.Drawing.RequiresSaving = True

End

'=============================================== TEXTO ===============================================

Private $aPoints As New Float[][]        ' los puntos de la linea, en orden
Private $aRaw As New Float[][]           ' los mismos, tal como se escribieron (sin sumar el @)
Private $aNumbers As New Float[]         ' los numeros sueltos
Private $aWords As New String[]          ' las palabras sueltas (ids, nombres)
Private $cOptions As New Collection      ' clave=valor
Private $fLast As Float[]                ' ultimo punto, base de @

Private Function RunParsed(sWord As String, r As Collection) As Collection

    Dim cArgs As Collection
    Dim aList As New Collection[]
    Dim c As Collection
    Dim i As Integer
    Dim f, f2 As Float[]

    cArgs = CopyOptions()

    Select Case sWord

        Case "LINE"
            If $aPoints.Count < 2 Or $aNumbers.Count + $aWords.Count > 0 Then Return Usage(r, sWord)
            For i = 0 To $aPoints.Count - 2
                c = EntityOptions("LINE")
                c["p"] = [$aPoints[i][0], $aPoints[i][1], $aPoints[i + 1][0], $aPoints[i + 1][1]]
                aList.Add(c)
            Next
            Return Run("ADD", ["entities": aList])

        Case "POINT"
            If $aPoints.Count < 1 Or $aNumbers.Count + $aWords.Count > 0 Then Return Usage(r, sWord)
            For Each f In $aPoints
                c = EntityOptions("POINT")
                c["p"] = [f[0], f[1]]
                aList.Add(c)
            Next
            Return Run("ADD", ["entities": aList])

        Case "CIRCLE"
            If $aPoints.Count <> 1 Or $aNumbers.Count <> 1 Or $aWords.Count > 0 Then Return Usage(r, sWord)
            If $aNumbers[0] <= 0 Then Return Fail(r, "The radius must be > 0")
            c = EntityOptions("CIRCLE")
            c["p"] = [$aPoints[0][0], $aPoints[0][1]]
            c["fparam"] = [$aNumbers[0]]
            Return Run("ADD", ["entity": c])

        Case "ARC"
            If $aPoints.Count <> 1 Or $aNumbers.Count <> 3 Or $aWords.Count > 0 Then Return Usage(r, sWord)
            If $aNumbers[0] <= 0 Then Return Fail(r, "The radius must be > 0")
            c = EntityOptions("ARC")
            c["p"] = [$aPoints[0][0], $aPoints[0][1]]
            c["fparam"] = [$aNumbers[0], $aNumbers[1], $aNumbers[2]]
            Return Run("ADD", ["entity": c])

        Case "MOVE", "COPY"
            If $aNumbers.Count + $aWords.Count > 0 Then Return Usage(r, sWord)
            If $aPoints.Count = 1 Then              ' el desplazamiento tal cual
                f = $aRaw[0]
                cArgs["dx"] = f[0]
                cArgs["dy"] = f[1]
                cArgs["dz"] = f[2]
            Else If $aPoints.Count = 2 Then         ' desde - hasta
                f = $aPoints[0]
                f2 = $aPoints[1]
                cArgs["dx"] = f2[0] - f[0]
                cArgs["dy"] = f2[1] - f[1]
                cArgs["dz"] = f2[2] - f[2]
            Else If Not cArgs.Exist("dx") And Not cArgs.Exist("dy") Then
                Return Usage(r, sWord)
            Endif
            Return Run(sWord, cArgs)

        Case "ROTATE", "SCALE"
            If $aNumbers.Count > 1 Or $aPoints.Count > 1 Or $aWords.Count > 0 Then Return Usage(r, sWord)
            If $aNumbers.Count = 1 Then cArgs[IIf(sWord = "ROTATE", "angle", "factor")] = $aNumbers[0]
            If $aPoints.Count = 1 Then cArgs["base"] = [$aPoints[0][0], $aPoints[0][1]]
            Return Run(sWord, cArgs)

        Case "MIRROR"
            If $aWords.Count > 0 Or $aNumbers.Count > 1 Or $aPoints.Count > 2 Then Return Usage(r, sWord)
            If $aPoints.Count = 2 Then              ' recta por dos puntos
                f = $aPoints[0]
                f2 = $aPoints[1]
                If f[0] = f2[0] And f[1] = f2[1] Then Return Fail(r, "The two points must be different")
                cArgs["base"] = [f[0], f[1]]
                cArgs["angle"] = Deg(ATan2(f2[1] - f[1], f2[0] - f[0]))
            Else
                If $aPoints.Count = 1 Then cArgs["base"] = [$aPoints[0][0], $aPoints[0][1]]
                If $aNumbers.Count = 1 Then cArgs["angle"] = $aNumbers[0]
            Endif
            Return Run(sWord, cArgs)

        Case "DELETE", "GET"
            If $aPoints.Count > 0 Then Return Usage(r, sWord)
            If $aWords.Count > 0 Then
                If sWord = "GET" Then
                    cArgs["id"] = $aWords[0]
                Else
                    cArgs["ids"] = $aWords
                Endif
            Endif
            If sWord = "GET" And Not cArgs.Exist("id") Then Return Usage(r, sWord)
            Return Run(sWord, cArgs)

        Case "ENTITIES"
            If $aNumbers.Count + $aWords.Count > 0 Or ($aPoints.Count <> 0 And $aPoints.Count <> 2) Then Return Usage(r, sWord)
            If $aPoints.Count = 2 Then
                f = $aPoints[0]
                f2 = $aPoints[1]
                cArgs["bbox"] = [Min(f[0], f2[0]), Min(f[1], f2[1]), Max(f[0], f2[0]), Max(f[1], f2[1])]
            Endif
            Return Run(sWord, cArgs)

        Case "SET", "LAYERS", "INFO", "UNDO", "REDO"
            If $aPoints.Count + $aNumbers.Count + $aWords.Count > 0 Then Return Usage(r, sWord)
            Return Run(sWord, cArgs)

        Case "LIST"
            ' en texto, lo util es como se escribe cada comando
            r["usage"] = TextHelp()
            Return r

        Case Else
            Return Fail(r, "Unknown command " & sWord)

    End Select

End

'' Separa la linea en palabras; lo que esta entre comillas es una sola palabra
Private Function SplitWords(sLine As String) As String[]

    Dim aTok As New String[]
    Dim sTok, sCar As String
    Dim bQuote, bHave As Boolean
    Dim i As Integer

    For i = 1 To Len(sLine)
        sCar = Mid(sLine, i, 1)
        If sCar = Chr(34) Then
            bQuote = Not bQuote
            bHave = True
        Else If (sCar = " " Or sCar = gb.Tab) And Not bQuote Then
            If bHave Then aTok.Add(sTok)
            sTok = ""
            bHave = False
        Else
            sTok &= sCar
            bHave = True
        Endif
    Next
    If bHave Then aTok.Add(sTok)
    Return aTok

End

'' La palabra del comando, en mayusculas y con los alias de Config resueltos (l -> LINE, m -> MOVE...)
Private Function ResolveWord(sWord As String) As String

    If Config.oAlias And If Config.oAlias.Exist(LCase(sWord)) Then Return UCase(Config.oAlias[LCase(sWord)])
    Return UCase(sWord)

End

'' Clasifica los argumentos en puntos, numeros, palabras y opciones. Devuelve False (y marca el error) si alguno esta mal.
'' Para DELETE y GET los numeros son ids ("DELETE 4003"); para los demas, numeros.
Private Function ParseTokens(aTok As String[], sCommand As String, r As Collection) As Boolean

    Dim i, iPos As Integer
    Dim sTok, sKey As String
    Dim f, fRaw As Float[]
    Dim fNum As Float
    Dim bIds As Boolean

    bIds = (sCommand = "DELETE" Or sCommand = "GET")
    $aPoints = New Float[][]
    $aRaw = New Float[][]
    $aNumbers = New Float[]
    $aWords = New String[]
    $cOptions = New Collection
    If Not $fLast Then $fLast = [0.0, 0.0, 0.0]

    For i = 1 To aTok.Max
        sTok = aTok[i]
        iPos = InStr(sTok, "=")
        If iPos > 1 Then
            sKey = LCase(Left(sTok, iPos - 1))
            $cOptions[sKey] = OptionValue(sKey, Mid(sTok, iPos + 1))
        Else If Left(sTok) = "@" Or InStr(sTok, ",") > 0 Then
            fRaw = ParsePoint(sTok)
            If Not fRaw Then
                Fail(r, "Bad point " & sTok & ": use x,y or x,y,z, and @dx,dy for relative")
                Return False
            Endif
            f = fRaw.Copy()
            If Left(sTok) = "@" Then
                f[0] += $fLast[0]
                f[1] += $fLast[1]
                f[2] += $fLast[2]
            Endif
            $aRaw.Add(fRaw)
            $aPoints.Add(f)
            $fLast = f
        Else If Not bIds And If IsNumberText(sTok, ByRef fNum) Then
            $aNumbers.Add(fNum)
        Else
            $aWords.Add(sTok)
        Endif
    Next
    Return True

End

'' x,y o x,y,z (con @ adelante o no); los valores tal como se escribieron
Private Function ParsePoint(sTok As String) As Float[]

    Dim aPart As String[]
    Dim f As New Float[3]
    Dim i As Integer
    Dim fNum As Float

    If Left(sTok) = "@" Then sTok = Mid(sTok, 2)
    aPart = Split(sTok, ",")
    If aPart.Count < 2 Or aPart.Count > 3 Then Return Null
    For i = 0 To aPart.Max
        If Not IsNumberText(Trim(aPart[i]), ByRef fNum) Then Return Null
        f[i] = fNum
    Next
    Return f

End

'' Solo numeros simples (sin Eval: esta linea tambien puede venir de afuera)
Private Function IsNumberText(sText As String, ByRef fValue As Float) As Boolean

    If sText = "" Then Return False
    If InStr("+-.0123456789", Left(sText)) = 0 Then Return False
    Try fValue = CFloat(sText)
    Return Not Error

End

Private Function OptionValue(sKey As String, sValue As String) As Variant

    Dim fNum As Float

    If sKey = "ids" Then Return Split(sValue, ",")
    Select Case LCase(sValue)
        Case "yes", "y", "true", "si", "s"
            Return True
        Case "no", "n", "false"
            Return False
    End Select
    If sKey <> "layer" And sKey <> "linetype" And IsNumberText(sValue, ByRef fNum) Then Return fNum
    Return sValue

End

Private Function CopyOptions() As Collection

    Dim c As New Collection
    Dim v As Variant

    For Each v In $cOptions
        c[$cOptions.Key] = v
    Next
    Return c

End

'' Una entidad nueva en JSON, con las opciones comunes que se hayan escrito
Private Function EntityOptions(sGender As String) As Collection

    Dim c As New Collection
    Dim sKey As String

    c["entity"] = sGender
    For Each sKey In ["layer", "linetype", "color", "linewidth"]
        If $cOptions.Exist(sKey) Then c[sKey] = $cOptions[sKey]
    Next
    Return c

End

Private Function RunTextAdd(sJson As String) As Collection

    Dim v As Variant
    Dim c As Collection

    Try v = JSON.Decode(sJson, True)
    If Error Or If IsNull(v) Then Return Fail(NewResult(), "ADD needs an entity JSON: " & TextHelp()["ADD"])
    If v Is Array Then Return Run("ADD", ["entities": v])
    If Not (v Is Collection) Then Return Fail(NewResult(), "ADD needs an entity JSON: " & TextHelp()["ADD"])
    c = v
    If TypeOf(c["entity"]) = gb.String Then Return Run("ADD", ["entity": c])       ' una entidad
    Return Run("ADD", c)                                                            ' ya son los argumentos

End

Private Function Usage(r As Collection, sCommand As String) As Collection

    Return Fail(r, "Usage: " & TextHelp()[sCommand])

End

'=============================================== AUXILIARES ===============================================

'' Las entidades a modificar: los ids de "ids" o, si no vienen, la seleccion actual.
'' Devuelve Null (y marca el error) si no hay ninguna.
Private Function Targets(cArgs As Collection, r As Collection) As Entity[]

    Dim aEnt As New Entity[]
    Dim aNotFound As New String[]
    Dim v As Variant
    Dim e As Entity

    If cArgs.Exist("ids") Then
        For Each v In cArgs["ids"]
            e = FindEntity(v)
            If e Then
                aEnt.Add(e)
            Else
                aNotFound.Add(CStr(v))
            Endif
        Next
        r["notfound"] = aNotFound
    Else
        For Each e In gcd.Drawing.Sheet.EntitiesSelected
            aEnt.Add(e)
        Next
    Endif

    If aEnt.Count = 0 Then
        Fail(r, "No entities to work on")
        Return Null
    Endif
    Return aEnt

End

'' Lee un numero opcional. Devuelve False (y marca el error) si no es un numero.
Private Function GetFloat(cArgs As Collection, sKey As String, fDefault As Float, r As Collection, ByRef fValue As Float) As Boolean

    fValue = fDefault
    If Not cArgs.Exist(sKey) Or If TypeOf(cArgs[sKey]) = gb.Null Then Return True
    Select Case TypeOf(cArgs[sKey])
        Case gb.Integer, gb.Long, gb.Float, gb.Single, gb.Short, gb.Byte
            fValue = cArgs[sKey]
            Return True
    End Select
    Fail(r, sKey & " must be a number")
    Return False

End

'' Lee un punto opcional [x, y]; por defecto [0, 0]. Devuelve Null (y marca el error) si esta mal.
Private Function GetPoint(cArgs As Collection, sKey As String, r As Collection) As Float[]

    Dim f As Float[]

    If Not cArgs.Exist(sKey) Or If TypeOf(cArgs[sKey]) = gb.Null Then Return [0.0, 0.0]
    Try f = JsonFile.ToFloats(cArgs[sKey])
    If Error Or If f.Count < 2 Then
        Fail(r, sKey & " must be [x, y]")
        Return Null
    Endif
    Return f

End

'' Ids de la seleccion actual, para que las herramientas llamen a los comandos
Public Function SelectionIds() As String[]

    Return IdsOf(gcd.Drawing.Sheet.EntitiesSelected)

End

'' Ids de una coleccion de entidades
Public Function IdsOf(cEntities As Collection) As String[]

    Dim e As Entity
    Dim aIds As New String[]

    For Each e In cEntities
        aIds.Add(e.Id)
    Next
    Return aIds

End

'' Una linea con lo que hizo un comando, para mostrar al usuario
Public Function Summary(r As Collection) As String

    Dim aParts As New String[]

    If Not r["ok"] Then Return ("Error") & ": " & r["error"]
    If r["created"].Count Then aParts.Add(r["created"].Count & " " & ("created"))
    If r["modified"].Count Then aParts.Add(r["modified"].Count & " " & ("modified"))
    If r["deleted"].Count Then aParts.Add(r["deleted"].Count & " " & ("deleted"))
    If r.Exist("notfound") And If r["notfound"].Count Then aParts.Add(r["notfound"].Count & " " & ("not found") & " (" & r["notfound"].Join(", ") & ")")
    If r.Exist("count") Then aParts.Add(r["count"] & " " & ("entities"))
    If r.Exist("message") Then aParts.Add(r["message"])
    If aParts.Count = 0 Then aParts.Add("OK")
    Return aParts.Join(", ")

End

Private Function NewResult() As Collection

    Dim r As New Collection

    r["ok"] = True
    r["created"] = New String[]
    r["modified"] = New String[]
    r["deleted"] = New String[]
    Return r

End

Private Function Fail(r As Collection, sError As String) As Collection

    r["ok"] = False
    r["error"] = sError
    Return r

End

'' Busca una entidad por id en la hoja actual y, si no esta, en las demas
Private Function FindEntity(vId As Variant) As Entity

    Dim s As Sheet
    Dim sId As String

    If IsNull(vId) Then Return Null
    sId = CStr(vId)
    If gcd.Drawing.Sheet.Entities.Exist(sId) Then Return gcd.Drawing.Sheet.Entities[sId]
    For Each s In gcd.Drawing.Sheets
        If s.Entities.Exist(sId) Then Return s.Entities[sId]
    Next
    Return Null

End

'' En la aplicacion: regenera los graficos y redibuja. En scripts y pruebas no hace nada.
Private Sub AfterCommand(r As Collection)

    If Not gcd.Interactive Then Return
    If r["created"].Count + r["modified"].Count + r["deleted"].Count = 0 And If Not r["changed"] Then Return

    If $bBatch Then
        $bPendingRefresh = True
    Else
        Refresh()
    Endif

End

Private Sub Refresh()

    If Not gcd.Interactive Then Return
    clsEntities.glGenDrawVBO()
    ' clsEntities.CollectVisibleEntities() DEPRE
    gcd.redraw

End
