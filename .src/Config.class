'' Describes the variables the user can edit in fSettings, keyed by variable name:
'' [section, title, editor, extra, help]
'' editor: "switch" Boolean, "color" Gambas color, "integer" and "float" with extra = [min, max],
'' "list" with extra = String[] of choices, or "@icons" / "@fonts" for lists read at run time.
'' Variables not listed here are still loaded and saved, but are not shown to the user.
Static Public Function Behaviour() As Collection

    Dim o As New Collection

    '' DISPLAY
    o.Add(["Display", ("Background color"), "color", Null, ("Background of the drawing area. White and black entities switch automatically to stay visible.")], "ModelBackgroundColor")
    o.Add(["Display", ("Grip link line color"), "color", Null, ("Line joining a grip to the grip it depends on.")], "GripLineColor")
    o.Add(["Display", ("Icon set"), "list", "@icons", ("Takes effect after restarting GambasCAD.")], "IconFamily")

    '' DRAWING
    o.Add(["Drawing", ("Default line weight (mm)"), "float", [0.0, 5.0], ("Used when the layer or block has no line weight.")], "DefLineWt")
    o.Add(["Drawing", ("Arc segment length (pixels)"), "float", [1.0, 100.0], ("Smaller values draw smoother arcs, circles and splines.")], "ArcDensity")
    o.Add(["Drawing", ("Regenerate on zoom"), "switch", Null, ("Rebuild the geometry when the zoom changes a lot.")], "AutoRegen")
    o.Add(["Drawing", ("Zoom factor for regeneration"), "integer", [2, 20], ("How many times the zoom must change before regenerating.")], "AutoRegenFactor")

    '' SNAP AND SELECTION
    o.Add(["Snap and selection", ("Snap distance (pixels)"), "integer", [2, 100], ("How close the cursor must be to snap to a point.")], "SnapDistancePix")
    o.Add(["Snap and selection", ("Pick tolerance (pixels)"), "integer", [1, 50], ("How close the cursor must be to pick an entity.")], "SelectTolerancePixDistance")
    o.Add(["Snap and selection", ("Grip size (pixels)"), "integer", [3, 30], ""], "GripSize")
    o.Add(["Snap and selection", ("On-screen text font"), "list", "@fonts", ("Font of the measurements shown while drawing.")], "GripTextOnScreenFont")

    '' UNITS
    o.Add(["Units", ("Decimals for coordinates"), "integer", [0, 8], ("Digits after the decimal point in the coordinates bar.")], "DigitsCoord")
    o.Add(["Units", ("Decimals for inquiries"), "integer", [0, 8], ("Digits after the decimal point in distances, areas and other inquiries.")], "DigitsInquiries")

    '' FILES
    o.Add(["Files", ("DWG converter"), "list", ["ODA", "LibreDWG"], ("External program used to open and save DWG files.")], "FileConversion")

    Return o

End

'' Keeps the values the editable variables have before the configuration file is read
Public Sub StoreDefaults()

    Dim sName As String

    $cDefaults = New Collection
    For Each sName In Behaviour().Keys
        $cDefaults[sName] = Object.GetProperty(Me, sName)
    Next

End

Public Function HasDefault(sName As String) As Boolean

    If Not $cDefaults Then Return False
    Return $cDefaults.Exist(sName)

End

Public Function DefaultValue(sName As String) As Variant

    Return $cDefaults[sName]

End

'' Returns the value of a configuration variable by name
Public Function GetValue(sName As String) As Variant

    Return Object.GetProperty(Me, sName)

End

'' Sets a configuration variable by name
Public Sub SetValue(sName As String, vValue As Variant)

    Object.SetProperty(Me, sName, vValue)

End

'' Sets the variables that are derived from the edited ones
Public Sub UpdateDerived()

    FormatCoord = DigitsFormat(DigitsCoord)
    FormatInquiries = DigitsFormat(DigitsInquiries)

End

Private Function DigitsFormat(iDigits As Integer) As String

    If iDigits <= 0 Then Return "0"
    Return "0." & String(iDigits, "0")

End

Public Sub Load(sFile As String)

    Dim cConfig As Collection
    Dim sSymbol As String
    Dim obj As Object = Me
    Dim MyClass As Class = Object.Class(obj)

    If Exist(sFile) Then
        cConfig = JSON.FromString(File.Load(sFile))
        For Each sSymbol In myClass.Symbols
            If cConfig.Exist(sSymbol) Then
                Object.SetProperty(obj, sSymbol, cConfig[sSymbol])
            Endif
        Next
    Endif

End

Static Public Sub Save(sFile As String, Optional j As JSONCollection)

    Dim jConfig As New JSONCollection
    Dim obj As Object = Me
    Dim MyClass As Class = Object.Class(obj)
    Dim sSymbol As String
    Dim Var As String
    Dim Valor As Variant

    If Not Exist(File.Dir(sFile)) Then
        Shell "mkdir -p " & File.Dir(sFile) Wait
    Endif

    If j Then
        For Each sSymbol In myClass.Symbols
            If j.Exist(sSymbol) Then
                Object.SetProperty(obj, sSymbol, j[sSymbol])
            Endif
        Next
    Endif

    For Each Var In myClass.Symbols
        If (MyClass[var].kind = Class.Variable) Or (MyClass[var].kind = Class.Property) Then
            valor = Object.GetProperty(obj, var)
            jConfig.Add(Valor, var)
        End If
    Next

    File.Save(sFile, JSON.Encode2(jConfig))

End
