' Gambas class file

' Describe un VBO

' lines
Public Vertex As New Float[]
Public Colors As New Single[]

' triangles
Public VertexTriangle As New Float[]
Public ColorsTriangle As New Single[]

' points
Public VertexPoints As New Float[]
Public ColorsPoints As New Single[]

Public Normals As New Single[]

' GPU picking: entity id as RGB, one color per vertex, parallel to Vertex/VertexTriangle/VertexPoints
Public PickColors As New Single[]
Public PickColorsTriangle As New Single[]
Public PickColorsPoints As New Single[]
Public IdPickColors As Integer
Public IdPickColorsTriangle As Integer
Public IdPickColorsPoints As Integer
Public NormalsTriangle As New Single[]      ' flat normals, one per triangle vertex, built on first lit draw
Public TextureUV As New Single[]

Public IdNormals As Integer

Public IdColors As Integer
Public IdVertex As Integer

Public IdColorsPoints As Integer
Public IdVertexPoints As Integer

Public IdColorsTriangle As Integer
Public IdVertexTriangle As Integer
Public IdNormalsTriangle As Integer

Public UseNormals As Boolean = False
Public UseTexture As Boolean = False
Public TriangleAlpha As Single = 0.5          '' transparencia de los triangulos: 1 = opacos, 0 = invisibles

Public SelectedDraw As Boolean
Public HoveredDraw As Boolean
Public SelectedVertexOffset As Integer
Public SelectedVertexTriangleOffset As Integer
Public SelectedVertexPointsOffset As Integer
Public SelectedVertexCount As Integer
Public SelectedVertexTriangleCount As Integer
Public SelectedVertexPointsCount As Integer

Public Sub _new()

End

Public Sub _free()

    If glx.glIsBuffer(IdVertex) Then glx.glDeleteBuffers(1, VarPtr(IdVertex))
    If glx.glIsBuffer(IdColors) Then glx.glDeleteBuffers(1, VarPtr(IdColors))

    If glx.glIsBuffer(IdVertexTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdVertexTriangle))
    If glx.glIsBuffer(IdColorsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdColorsTriangle))

    If glx.glIsBuffer(IdVertexpoints) Then glx.glDeleteBuffers(1, VarPtr(IdVertexPoints))
    If glx.glIsBuffer(IdColorsPoints) Then glx.glDeleteBuffers(1, VarPtr(IdColorsPoints))

    If glx.glIsBuffer(IdNormalsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdNormalsTriangle))
    IdNormalsTriangle = 0

    If glx.glIsBuffer(IdPickColors) Then glx.glDeleteBuffers(1, VarPtr(IdPickColors))
    If glx.glIsBuffer(IdPickColorsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdPickColorsTriangle))
    If glx.glIsBuffer(IdPickColorsPoints) Then glx.glDeleteBuffers(1, VarPtr(IdPickColorsPoints))
    IdPickColors = 0
    IdPickColorsTriangle = 0
    IdPickColorsPoints = 0

End

Public Sub Clear()

    If glx.glIsBuffer(IdVertex) Then glx.glDeleteBuffers(1, VarPtr(IdVertex))
    If glx.glIsBuffer(IdColors) Then glx.glDeleteBuffers(1, VarPtr(IdColors))

    If glx.glIsBuffer(IdVertexTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdVertexTriangle))
    If glx.glIsBuffer(IdColorsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdColorsTriangle))

    If glx.glIsBuffer(IdVertexPoints) Then glx.glDeleteBuffers(1, VarPtr(IdVertexPoints))
    If glx.glIsBuffer(IdColorsPoints) Then glx.glDeleteBuffers(1, VarPtr(IdColorsPoints))

    If glx.glIsBuffer(IdNormalsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdNormalsTriangle))
    IdNormalsTriangle = 0

    If glx.glIsBuffer(IdPickColors) Then glx.glDeleteBuffers(1, VarPtr(IdPickColors))
    If glx.glIsBuffer(IdPickColorsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdPickColorsTriangle))
    If glx.glIsBuffer(IdPickColorsPoints) Then glx.glDeleteBuffers(1, VarPtr(IdPickColorsPoints))
    IdPickColors = 0
    IdPickColorsTriangle = 0
    IdPickColorsPoints = 0
    NormalsTriangle.Clear

    PickColors.Clear
    PickColorsTriangle.Clear
    PickColorsPoints.Clear

    colors.Clear
    Vertex.Clear

    ColorsTriangle.Clear
    VertexTriangle.Clear

    ColorsPoints.Clear
    VertexPoints.Clear

    Normals.Clear
    TextureUV.Clear

End

Public Sub SendBuffersToGPU(Optional mode As Integer = glx.STATIC_DRAW)

    _free()
    NormalsTriangle.Clear                       ' la geometria cambio, se recalculan al dibujar con luces
    IdVertex = glx.createVBO(Vertex.Data, Vertex.Count * SizeOf(Vertex.Type), mode)
    IdColors = glx.createVBO(colors.Data, colors.Count * SizeOf(colors.Type), mode)
    IdVertexTriangle = glx.createVBO(VertexTriangle.Data, VertexTriangle.Count * SizeOf(VertexTriangle.Type), mode)
    IdColorsTriangle = glx.createVBO(ColorsTriangle.Data, ColorsTriangle.Count * SizeOf(ColorsTriangle.Type), mode)
    IdVertexPoints = glx.createVBO(VertexPoints.Data, VertexPoints.Count * SizeOf(VertexPoints.Type), mode)
    IdColorsPoints = glx.createVBO(ColorsPoints.Data, ColorsPoints.Count * SizeOf(ColorsPoints.Type), mode)

    ' solo los VBO de layers llevan ids de picking
    If PickColors.Count + PickColorsTriangle.Count + PickColorsPoints.Count > 0 Then
        TagPick(0)                              ' lo que se agrego sin id queda como "nada"
        IdPickColors = glx.createVBO(PickColors.Data, PickColors.Count * SizeOf(PickColors.Type), mode)
        IdPickColorsTriangle = glx.createVBO(PickColorsTriangle.Data, PickColorsTriangle.Count * SizeOf(PickColorsTriangle.Type), mode)
        IdPickColorsPoints = glx.createVBO(PickColorsPoints.Data, PickColorsPoints.Count * SizeOf(PickColorsPoints.Type), mode)
    End If

End

'' Usage options:
'' 0 = use color array
'' -1 = brigther color
'' -2 = darker color
'' -3 = background color
''  > 0 = that color
Public Sub Draw(Optional mode As Integer = 0)

    Dim UseShader As Boolean = glx.Matrices.Active
    Dim Lit As Boolean
    Dim Transparent As Boolean
    Dim PrevBlend As Boolean

    '--------HIGHLIGHTING-------------------------------------------------
    If HoveredDraw Then

        EnableArrays(UseShader, False)
        SetColor(UseShader, Color.Lighter(Config.ColorForSelected), 0.55)

        SetPositions(UseShader, IdVertex)
        glx.glDrawArrays(gl.LINES, SelectedVertexOffset / 3, SelectedVertexCount / 3)  ' es /3 porque hay 3 coordenadas por vertice

        SetPositions(UseShader, IdVertexTriangle)
        glx.glDrawArrays(gl.TRIANGLES, SelectedVertexTriangleOffset, SelectedVertexTriangleCount / 3)

        ' '--------points--------------------------------------------
        SetPositions(UseShader, IdVertexPoints)
        glx.glDrawArrays(gl.POINTS, SelectedVertexPointsOffset / 3, SelectedVertexPointsCount / 3)

        gl.Disable(gl.BLEND)
    End If

    HoveredDraw = False
    SelectedDraw = False

    '--------lines--------------------------------------------
    EnableArrays(UseShader, mode <> -3)
    SetPositions(UseShader, IdVertex)

    If mode = 0 Then
        SetColors(UseShader, IdColors)
    Else If mode > 0 Then
        SetColor(UseShader, mode)
    Else If mode = -3 Then
        SetColor(UseShader, Color.Black)
    End If

    glx.glDrawArrays(gl.LINES, 0, Vertex.Count / 3)

    ' '--------triangles--------------------------------------------
    ' en 3D las caras se iluminan (vertex1.txt/fragment1.txt), lineas y puntos no tienen normales
    Lit = False
    If UseShader And VertexTriangle.Count > 0 Then Lit = glx.Matrices.BeginLit()

    EnableArrays(UseShader, mode <> 3)
    SetPositions(UseShader, IdVertexTriangle)

    If mode <> 3 Then
        SetColors(UseShader, IdColorsTriangle)
    Else
        SetColor(UseShader, Config.WindowBackColor)
    End If

    If Lit Then SetTriangleNormals()

    ' transparencia: alfa constante para todos los triangulos, sirve con o sin shader
    Transparent = TriangleAlpha < 1
    If Transparent Then
        PrevBlend = gl.IsEnabled(gl.BLEND)
        glx.glEnable(glx.BLEND)
        glx.glBlendColor(0, 0, 0, Max(TriangleAlpha, 0))
        glx.glBlendFunc(glx.CONSTANT_ALPHA, glx.ONE_MINUS_CONSTANT_ALPHA)
        glx.glDepthMask(0)                      ' las caras transparentes no tapan lo que esta detras
    End If

    glx.glDrawArrays(gl.TRIANGLES, 0, VertexTriangle.Count / 3)

    If Transparent Then
        glx.glDepthMask(1)
        glx.glBlendFunc(glx.ONE, glx.ZERO)      ' la funcion por defecto de OpenGL
        If Not PrevBlend Then glx.glDisable(glx.BLEND)
    End If

    If Lit Then
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_NORMAL)
        glx.Matrices.EndLit()
    End If

    ' '--------points--------------------------------------------
    SetPositions(UseShader, IdVertexPoints)

    If mode <> 3 Then
        SetColors(UseShader, IdColorsPoints)
    Else
        SetColor(UseShader, Config.WindowBackColor)
    End If

    glx.glDrawArrays(gl.POINTS, 0, VertexPoints.Count / 3)

    '---------limpieza----------------------------------------------
    glx.glBindBuffer(gl.ARRAY_BUFFER, 0)

    If UseShader Then
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_POSITION)
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
    Else
        glx.glDisableClientState(glx.VERTEX_ARRAY)
        glx.gldisableClientState(glx.COLOR_ARRAY)
    End If

End

'' Gives the picking id to every vertex added since the last call (call right after drawing an entity)
Public Sub TagPick(iId As Integer)

    Dim r, g, b As Single

    r = (Shr(iId, 16) And 255) / 255
    g = (Shr(iId, 8) And 255) / 255
    b = (iId And 255) / 255

    FillPick(PickColors, Vertex.Count, r, g, b)
    FillPick(PickColorsTriangle, VertexTriangle.Count, r, g, b)
    FillPick(PickColorsPoints, VertexPoints.Count, r, g, b)

End

Private Sub FillPick(aPick As Single[], iCount As Integer, r As Single, g As Single, b As Single)

    While aPick.Count < iCount
        aPick.Add(r)
        aPick.Add(g)
        aPick.Add(b)
    Wend

End

'' Draws the geometry with the picking ids as colors, into PickBuffer
Public Sub DrawPick()

    Dim UseShader As Boolean = glx.Matrices.Active

    If IdPickColors = 0 And IdPickColorsTriangle = 0 And IdPickColorsPoints = 0 Then Return

    EnableArrays(UseShader, True)

    SetPositions(UseShader, IdVertex)
    SetColors(UseShader, IdPickColors)
    glx.glDrawArrays(gl.LINES, 0, Vertex.Count / 3)

    SetPositions(UseShader, IdVertexTriangle)
    SetColors(UseShader, IdPickColorsTriangle)
    glx.glDrawArrays(gl.TRIANGLES, 0, VertexTriangle.Count / 3)

    SetPositions(UseShader, IdVertexPoints)
    SetColors(UseShader, IdPickColorsPoints)
    glx.glDrawArrays(gl.POINTS, 0, VertexPoints.Count / 3)

    glx.glBindBuffer(gl.ARRAY_BUFFER, 0)
    If UseShader Then
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_POSITION)
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
    Else
        glx.glDisableClientState(glx.VERTEX_ARRAY)
        glx.gldisableClientState(glx.COLOR_ARRAY)
    End If

End

'' Feeds flat triangle normals to the lighting shader, building them if the geometry changed
Private Sub SetTriangleNormals()

    If NormalsTriangle.Count <> VertexTriangle.Count Or IdNormalsTriangle = 0 Then
        BuildTriangleNormals()
        If glx.glIsBuffer(IdNormalsTriangle) Then glx.glDeleteBuffers(1, VarPtr(IdNormalsTriangle))
        IdNormalsTriangle = glx.createVBO(NormalsTriangle.Data, NormalsTriangle.Count * SizeOf(NormalsTriangle.Type), glx.STATIC_DRAW)
    End If

    glx.glBindBuffer(gl.ARRAY_BUFFER, IdNormalsTriangle)
    glx.glEnableVertexAttribArray(ShaderMatrices.ATTRIB_NORMAL)
    glx.glVertexAttribPointer(ShaderMatrices.ATTRIB_NORMAL, 3, gl.FLOAT, False, 0, 0)

End

'' One normal per triangle, (v1 - v0) x (v2 - v0), repeated for its 3 vertices.
'' The winding may come out either way from the triangulation; fragment1.txt lights both sides.
Private Sub BuildTriangleNormals()

    Dim i, k As Integer
    Dim ax, ay, az, bx, by, bz, nx, ny, nz, l As Float

    NormalsTriangle.Clear
    NormalsTriangle.Resize(VertexTriangle.Count)

    For i = 0 To VertexTriangle.Count - 9 Step 9
        ax = VertexTriangle[i + 3] - VertexTriangle[i]
        ay = VertexTriangle[i + 4] - VertexTriangle[i + 1]
        az = VertexTriangle[i + 5] - VertexTriangle[i + 2]
        bx = VertexTriangle[i + 6] - VertexTriangle[i]
        by = VertexTriangle[i + 7] - VertexTriangle[i + 1]
        bz = VertexTriangle[i + 8] - VertexTriangle[i + 2]

        nx = ay * bz - az * by
        ny = az * bx - ax * bz
        nz = ax * by - ay * bx

        l = Sqr(nx * nx + ny * ny + nz * nz)
        If l > 0 Then
            nx /= l
            ny /= l
            nz /= l
        Else
            nx = 0
            ny = 0
            nz = 1
        End If

        For k = 0 To 6 Step 3
            NormalsTriangle[i + k] = nx
            NormalsTriangle[i + k + 1] = ny
            NormalsTriangle[i + k + 2] = nz
        Next
    Next

End

' Shader path: positions/colors go to the attribute locations of .hidden/shaders/basic.vert
' Fixed-function path: legacy client arrays, used when the shader could not be loaded

Private Sub EnableArrays(UseShader As Boolean, PerVertexColor As Boolean)

    If UseShader Then
        glx.glEnableVertexAttribArray(ShaderMatrices.ATTRIB_POSITION)
        If PerVertexColor Then
            glx.glEnableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
        Else
            glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
        End If
    Else
        glx.glEnableClientState(glx.VERTEX_ARRAY)
        If PerVertexColor Then
            glx.glEnableClientState(glx.COLOR_ARRAY)
        Else
            glx.glDisableClientState(glx.COLOR_ARRAY)
        End If
    End If

End

Private Sub SetPositions(UseShader As Boolean, IdBuffer As Integer)

    glx.glBindBuffer(gl.ARRAY_BUFFER, IdBuffer)
    If UseShader Then
        glx.glVertexAttribPointer(ShaderMatrices.ATTRIB_POSITION, 3, gl.DOUBLE, False, 0, 0)  '' ojo con el tipo d datos gbFLOAT = glDOUBLE
    Else
        glx.glVertexPointer(3, gl.DOUBLE, 0, 0) '' ojo con el tipo d datos gbFLOAT = glDOUBLE
    End If

End

Private Sub SetColors(UseShader As Boolean, IdBuffer As Integer)

    glx.glBindBuffer(gl.ARRAY_BUFFER, IdBuffer)
    If UseShader Then
        glx.glEnableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
        glx.glVertexAttribPointer(ShaderMatrices.ATTRIB_COLOR, 3, gl.FLOAT, False, 0, 0)
    Else
        glx.glEnableClientState(glx.COLOR_ARRAY)
        glx.glColorPointer(3, gl.Float, 0, 0)
    End If

End

'' Constant color for every vertex (attribute array disabled)
Private Sub SetColor(UseShader As Boolean, gbColor As Integer, Optional alpha As Float = -1)

    Dim rgba As Single[]

    If UseShader Then
        rgba = glx.GetColorRGBA(gbColor)
        If alpha > 0 Then rgba[3] = alpha
        glx.glDisableVertexAttribArray(ShaderMatrices.ATTRIB_COLOR)
        glx.glVertexAttrib4f(ShaderMatrices.ATTRIB_COLOR, rgba[0], rgba[1], rgba[2], rgba[3])
    Else
        glx.glDisableClientState(glx.COLOR_ARRAY)
        glx.glColorGb(gbColor, alpha)
    End If

End
