Create Static       ' This two preposition are the same as creating a module instead of a
Create Private      ' class in Gambas.
'Fast Unsafe        ' alwways set this after debugging
Public HookSize As Integer = 16                       ' for use with poi
Public NumericTolerance As Float = 1e-7
Private UseAddMethod As Boolean = True
Public Const pi2 As Float = 6.28318530717959

'' Returns center, radious, start angle, length of an arc defined by 3 given points
'' Angles will be fixed so the ARC is counterclock
Public Function Arc3Point(px1 As Float, py1 As Float, px2 As Float, py2 As Float, px3 As Float, py3 As Float) As Float[]

    Dim answer As Float[]

    ' mid points of segments
    Dim mx1, my1, mx2, my2 As Float

    mx1 = (px1 + px2) / 2
    my1 = (py1 + py2) / 2

    mx2 = (px3 + px2) / 2
    my2 = (py3 + py2) / 2

    ' angles
    Dim Ang1, Ang2, angm As Float
    Ang1 = Ang(px2 - px1, py2 - py1)
    Ang2 = Ang(px3 - px2, py3 - py2)

    ' anther point in the normal to segments
    Dim Ax1, Ay1, Ax2, Ay2 As Float
    Ax1 = mx1 - 100 * Sin(ang1)
    Ay1 = my1 + 100 * Cos(ang1)

    Ax2 = mx2 - 100 * Sin(ang2)
    Ay2 = my2 + 100 * Cos(ang2)

    ' the center is the intersection of the normals
    answer = lineLineIntersection2(mx1, my1, ax1, ay1, mx2, my2, ax2, ay2)

    If answer.Count > 0 Then

        ' the radious
        answer.Add(distancia(px1, py1, answer[0], answer[1]))

        ' start and end angles
        ang1 = Ang(px1 - answer[0], py1 - answer[1])
        ang2 = Ang(px3 - answer[0], py3 - answer[1])

        angm = Ang(px2 - answer[0], py2 - answer[1])            ' mid angle

        ' Tengo que usar solo valores positivos
        If ang1 < 0 Then ang1 += Pi2
        If ang2 < 0 Then ang2 += Pi2
        If angm < 0 Then angm += Pi2

        If ang1 > ang2 Then ang2 += Pi2
        If angm < ang1 And angM < ang2 Then angm += pi2

        ' ahora hay dos casos, angM cae en medio o no
        If angm >= ang1 And angm <= ang2 Then

        Else

            Swap ang2, ang1
            If ang2 < ang1 Then ang2 += Pi2
        Endif

        answer.Add(ang1)

        answer.Add(ang2 - ang1)
        Return answer

    Else

        Return []

    Endif

End

'' Igual que Arc3Point pero con tres puntos 3D: el arco esta en el plano que forman los tres puntos.
'' Devuelve [cx, cy, cz, radio, angulo inicial, angulo final, nx, ny, nz], o [] si los puntos estan alineados.
'' Los angulos (radianes) se miden en el plano del arco con los ejes de EjesLocales(normal), los mismos que usa LocalToGlobal,
'' y van en sentido antihorario visto desde la punta de la normal. El angulo final puede ser mayor que 2*Pi.
'' La normal (normalizada) sale del lado de Normal si se pasa; si no, del lado positivo: Z > 0, o si es horizontal Y > 0, o si no X > 0.
'' Con los tres puntos en un plano Z constante da los mismos valores que Arc3Point.
Public Function Arc3Point3d(p1 As Punto3d, p2 As Punto3d, p3 As Punto3d, Optional Normal As Punto3d) As Float[]

    Dim n, a, b, c As Punto3d
    Dim q As Quaternion
    Dim l1, l2, l3 As Punto3d
    Dim arco As Float[]

    a = Operate(p2, p1, 1)
    b = Operate(p3, p1, 1)
    n = Cross(a, b)
    If longitud(n) <= NumericTolerance * longitud(a) * longitud(b) Then Return []      ' alineados
    Normalizar(n)

    ' elijo el lado de la normal
    If Normal Then
        If Dot3P(n, Normal) < 0 Then Mult3D(n, -1)
    Else If Abs(n.z) > NumericTolerance Then
        If n.z < 0 Then Mult3D(n, -1)
    Else If Abs(n.y) > NumericTolerance Then
        If n.y < 0 Then Mult3D(n, -1)
    Else
        If n.x < 0 Then Mult3D(n, -1)
    Endif

    ' paso los puntos al plano del arco (origen en p1, z local = 0 para los tres) y resuelvo en 2D
    q = CuaternionGlobalToLocal(n)
    l1 = GlobalToLocalQ(p1, p1, q)
    l2 = GlobalToLocalQ(p2, p1, q)
    l3 = GlobalToLocalQ(p3, p1, q)
    arco = Arc3Point(l1.x, l1.y, l2.x, l2.y, l3.x, l3.y)
    If arco.Count < 5 Then Return []

    ' el centro vuelve a coordenadas globales
    c = LocalToGlobal(p1, n, arco[0], arco[1])

    Return [c.x, c.y, c.z, arco[2], arco[3], arco[3] + arco[4], n.x, n.y, n.z]

End

