'     cCROSSap = cx * apy - cy * apx
'     bCROSScp = bx * cpy - by * cpx
'
'     ' vemos el caso especial doonde coincide
'     If cpx = 0 And cpy = 0 Then Return False
'     If bpx = 0 And bpy = 0 Then Return False
'     If apx = 0 And apy = 0 Then Return False
'
