' Gambas class file

' un type importante

Public x As Float
Public y As Float
Public z As Float

Fast Public Sub _new(Optional x As Float = 0, y As Float = 0, z As Float = 0)

    Me.x = x
    Me.y = y
    Me.z = z

End

'' Devuelve una copia independiente de este punto
Public Function Copy() As Punto3d

    Dim p As Punto3d

    p = New Punto3d(Me.x, Me.y, Me.z)
    Return p

End
