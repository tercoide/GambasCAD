' Gambas class file

Public Origin As New Punto3d
Public Direction As New Punto3d

Public Sub _new(Optional p1 As Punto3d, p2 As Punto3d)

    If IsNull(p1) Then
        Me.Origin = New Punto3d(0, 0, 0)
    Else
        Me.Origin = p1.Copy()

    End If
    If IsNull(p2) Then
        Me.Direction = New Punto3d(0, 0, 1)
    Else
        Me.Direction = New Punto3d(p2.x - p1.x, p2.y - p1.y, p2.z - p1.z)
        puntos.Normalizar(Me.Direction)
    End If

End
