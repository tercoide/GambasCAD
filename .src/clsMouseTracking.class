Public Function CheckBestPOI(xr As Float, Yr As Float, Optional eExclude As Entity) As Collection

    Dim CurrentPoint, BestPoint As Punto3d
    Dim d, ShortestDistance As Float
    Dim e As Entity
    Dim rJson, rta As Collection
    Dim p As New Punto3d(xr, yr, gcd.Drawing.Sheet.Level)

    ShortestDistance = 1e10

    rta = ["mode": 0, "point": Null, "distance": ShortestDistance]

    For Each e In gcd.Drawing.HoveredEntities

        If e = eExclude Then Continue
        If e = gcd.Drawing.Sheet.SkipSearch Then Continue

        If e.Gender = "INSERT" Then Continue

        '  If gcd.Drawing.Sheet.Is3D Then
        rJson = CheckPOI3D(e, p)
        If rJson["mode"] = 0 Then
            'p = puntos.RayPlaneIntersection(gcd.Drawing.Sheet.ray, gcd.Drawing.Sheet.GetPlane())
        Else
            If rJson["distance"] < rta["distance"] Then ' es un mejor punto
                rta = rJson.Copy()
            End If
        Endif

    Next

    Return rta

End

