'' This is called by MouseMove events, so make sure its fast
'' and its called form there
'' Returns pair like: "point" as Vertex, "description" as text of finding, "edge" as [vertex1, vertex2], "face" as Face where the point was found

Public Sub CheckPOI3D(e As Entity, Eye As Punto3d, Optional ToolRay As Ray, RefPoint1 As Punto3d, RefPoint2 As Punto3d) As Collection

    Dim rData As Collection = ["mode": 0]

    Dim CurrentPoint As New Float[], e2, ePart As Entity
    Dim i, iInter, iPoligon, iLine As Integer
    Dim pend1, base1, pend2, base2 As Float ' vars para las ecuacionesde las rectas
    Dim pTesting, pMid, pInFace, pNea, puntoB, puntoA As New Punto3d
    Dim pIntersection As New Punto3d[]
    Dim flxPath As Float[]

    Dim end1X, end1Y, end2X, end2Y As Float
    Dim P0, P1, Pr As Punto3d, xr, yr As Float
    ' distancias  los enganches, para determinar cual es el mas cercano al puntero
    Dim DistPer As Float = 1e6
    Dim DistEnd1 As Float = 1e6
    Dim DistEnd2 As Float = 1e6
    Dim DistMId As Float = 1e6
    Dim DistBase As Float = 1e6
    Dim DistTang As Float = 1e6
    Dim DistQuad As Float = 1e6
    Dim DistCenter As Float = 1e6
    Dim DistInter As Float = 1e6
    Dim DistNearest As Float = 1e6
    Dim Dist As Float = 1e5  ' el menor
    Dim tolerance As Float
    Dim d As Float
    Dim ShortestDistance As Float

    ' If Me.flgSearchingPOI Then Return   ' no nesting this

    ' Debug "Iniciando busqueda de POI", Rnd(0, 1000)

    tolerance = gcd.Metros(16)
    xr = Eye.x
    yr = Eye.y
    'Debug "Checking POI"

    iPoligon = -1
    iLine = -1

    If Not e Then

        gcd.Drawing.eLastEntity = Null

        Return rData
    End If
    ' If iLine > 0 Then e = gcd.CurrDrawing.arrEntities[gcd.CurrDrawing.poiLinesEntities[iLine]]
    ' If iPoligon > 0 Then e = gcd.CurrDrawing.arrEntities[iPoligon]

    'Debug "Encontrada entidad ", e.Gender, " en ", Timer - t

    Select Case e.Gender

        Case "INSERT"
            ' Stop
            ' ShortestDistance = 1e10
            ' For Each ePart In e.pBlock.Entities
            '     If gcd.flgQuitSearch Then Break
            '     If WaitEnabled Then Wait 0
            '     CurrentPoint = CheckPOI(Xr, Yr, ePart)
            '
            '     If CurrentPoint[2] > 0 Then
            '         d = puntos.distancia(xr, yr, CurrentPoint[0], CurrentPoint[1])
            '
            '         If d < ShortestDistance Then
            '             ShortestDistance = d
            '             rData[0] = CurrentPoint[0]
            '             rData[1] = CurrentPoint[1]
            '             rData[2] = CurrentPoint[2]
            '         Endif
            '
            '     Endif
            ' Next

        Case "LINE"

            ' perpendicular
            If gcd.Drawing.Sheet.LastPoint Then                     ' tengo un punto anterior

                If e.P[1].x - e.P[0].x <> 0 Then
                    pend1 = (e.P[1].y - e.P[0].y) / (e.P[1].x - e.P[0].x)
                    base1 = e.P[0].y - pend1 * e.P[0].x                 ' Y = pend1 X + base1

                    ' ecuacion de la recta perpendicular que pasa por el punto anterior
                    If pend1 <> 0 Then
                        pend2 = -1 / pend1
                        base2 = gcd.Drawing.Sheet.LastPoint.y - pend2 * gcd.Drawing.Sheet.LastPoint.x

                        ' necesito otro punto
                        If gcd.Drawing.Sheet.LastPoint.x <> 0 Then
                            puntoA.x = 0
                            puntoA.y = base2
                        Else
                            puntoA.x = 1
                            puntoA.y = (pend2 + base2)

                        End If

                        ' determino la interseccion de ambas
                        puntoB.FromXYZ(puntos.lineLineIntersection([gcd.drawing.sheet.lastpoint.x, gcd.drawing.sheet.lastpoint.y], [puntoA.x, puntoA.y], [e.P[0].x, e.P[0].y], [e.P[1].x, e.P[1].y]))
                    Else ' la recta es horizontal

                        puntoB = New Punto3d(gcd.drawing.sheet.lastpoint.x, e.P[0].y)

                    End If
                Else        ' la recta es vertical

                    puntoB = New Punto3d(e.P[0].x, gcd.drawing.sheet.lastpoint.y, 0)

                End If

                ' veo si el punto b esta entre los extremos de la linea , aunque deberia estarlo!!!
                If puntos.onSegment(e.P[0].x, e.P[0].y, puntoB.x, puntoB.y, e.P[1].x, e.P[1].y) Then

                    ' determino la distancia al puntero para ofrecerlo como opcion de enganche
                    DistPer = puntos.distancia(puntoB.x, puntoB.y, xr, yr)

                Endif
            End If

        Case "CIRCLE"
            If gcd.Drawing.Sheet.LastPoint Then                     ' tengo un punto anterior

                ' buscamos una tangente..

                ' Extraido de StackExchange
                ' #Data Section, change As You need #
                ' Cx, Cy = coordenadas del centro
                Dim Cx As Float = e.p[0].x
                Dim Cy As Float = e.p[0].y
                Dim tx, ty, t1x, t1y, t2x, t2y As Float
                Dim r As Float = e.fParam[0]

                Dim Px As Float = gcd.Drawing.Sheet.LastPoint.x
                Dim Py As Float = gcd.Drawing.Sheet.LastPoint.y

                Dim dx As Float = Px - Cx
                Dim dy As Float = Py - Cy
                Dim dxr As Float = -dy
                Dim dyr As Float = dx
                DistCenter = Sqr(dx ^ 2 + dy ^ 2)               ' y ya que estoy veo el Center

                If DistCenter >= r Then
                    Dim rho As Float = r / DistCenter
                    Dim ad As Float = rho ^ 2
                    Dim bd As Float = rho * Sqr(1 - rho ^ 2)

                    ' los puntos tangente
                    T1x = Cx + ad * dx + bd * dxr
                    T1y = Cy + ad * dy + bd * dyr
                    T2x = Cx + ad * dx - bd * dxr
                    T2y = Cy + ad * dy - bd * dyr

                    If (DistCenter / r - 1) < 1E-8 Then
                        'P is on the circumference
                    Else    ' determino cual de las dos tangentes es la mas cercana

                        If puntos.distancia(xr, yr, t1x, t1y) > puntos.distancia(xr, yr, t2x, t2y) Then
                            Tx = T2x
                            Ty = T2y
                        Else
                            Tx = T1x
                            Ty = T1y

                        Endif
                        DistTang = puntos.distancia(xr, yr, tx, ty)
                    End If
                Else ' esta dentro del circulo

                    DistTang = 1e6
                    ' No tangent Is Possible
                End If
            End If

            ' busco los quadrants
            Dim qx, qy, q1, q2, q3, q4 As Float
            q1 = puntos.distancia(e.P[0].x - e.fParam[0], e.P[0].y, xr, yr)
            q2 = puntos.distancia(e.P[0].x + e.fParam[0], e.P[0].y, xr, yr)
            q3 = puntos.distancia(e.P[0].x, e.P[0].y - e.fParam[0], xr, yr)
            q4 = puntos.distancia(e.P[0].x, e.P[0].y + e.fParam[0], xr, yr)

            DistQuad = 1e10
            If DistQuad > q1 Then
                DistQuad = q1
                qx = e.P[0].x - e.fParam[0]
                qy = e.P[0].y
            End If
            If DistQuad > q2 Then
                DistQuad = q2
                qx = e.P[0].x + e.fParam[0]
                qy = e.P[0].y
            End If
            If DistQuad > q3 Then
                DistQuad = q3
                qx = e.P[0].x
                qy = e.P[0].y - e.fParam[0]
            End If
            If DistQuad > q4 Then
                DistQuad = q4
                qx = e.P[0].x
                qy = e.P[0].y + e.fParam[0]
            End If

    End Select

    ' busco tambien intersecciones con las otras entidades debajo del mouse
    If gcd.SnapMode And gcd.poiIntersection Then
        flxPath = PathXYZ(e)
        If flxPath.Count >= 6 Then
            For Each e2 In gcd.Drawing.HoveredEntities
                If e2 = e Then Continue
                AddIntersections(flxPath, PathXYZ(e2), Eye, tolerance, pIntersection)
            Next
        End If
        For i = 0 To pIntersection.Max
            d = puntos.distancia(xr, yr, pIntersection[i].x, pIntersection[i].y)
            If d < DistInter Then
                DistInter = d
                iInter = i
            End If
        Next
    End If
    '
    ' otros puntos contra elementos lineales
    ' necsito una referencia dentro de la entidad lineal
    ' tengo un rayo Eye y una entidad lineal, seria

    Select Case e.Gender
        Case "LINE"

            DistEnd1 = puntos.Distancia3D(eye, e.P[0])
            puntoA = e.P[0].Copy()

            DistEnd2 = puntos.Distancia3D(eye, e.P[1])
            puntoB = e.P[1].Copy()

            pMid = New Punto3d((e.P[1].X + e.P[0].x) / 2, (e.P[1].y + e.P[0].y) / 2, (e.P[1].z + e.P[0].z) / 2)
            DistMId = puntos.Distancia3D(eye, pMid)

            ' para obtener el punto mas cercano necesito evaluar la interseccion de un plano del rayo Eye con la recta del segmento:
            ' Caso 1: la recta esta contenida en el plano --> devuelvo el punto medio
            ' Caso 2: la recta es // al plano --> no deberia esta en esta rutina!!!
            ' Caso 3: la recta intersacta el plano

            'pNea = puntos.FindNearest(xr, yr, puntos.ToXY(e.p))

        Case "TEXT", "MTEXT"

            DistBase = puntos.Distancia3D(eye, e.P[0])

        Case "CIRCLE"
            DistCenter = puntos.Distancia3D(eye, e.P[0])

            ' pNea = puntos.NearestToPolyLine(xr, yr, e.PolyLine)
            '
            ' DistNearest = puntos.distancia(xr, yr, pNea[0], pNea[1])
            '
        Case "ELLIPSE", "ARC", "SPLINE"

            DistCenter = puntos.Distancia3D(eye, e.P[0])

            ' If e.PolyLine.count > 0 Then
            '     DistEnd1 = puntos.distancia(e.PolyLine[0], e.PolyLine[1], xr, yr)
            '     end1X = e.PolyLine[0]
            '     end1Y = e.PolyLine[1]
            '     DistEnd2 = puntos.distancia(e.PolyLine[e.PolyLine.Max - 1], e.PolyLine[e.PolyLine.max], xr, yr)
            '     end2X = e.PolyLine[e.PolyLine.Max - 1]
            '     end2Y = e.PolyLine[e.PolyLine.Max]
            '
            '     pNea = puntos.NearestToPolyLine(xr, yr, e.PolyLine)
            ' End If
            ' DistNearest = puntos.distancia(xr, yr, pNea[0], pNea[1])
            '
        Case "LWPOLYLINE", "SOLID"
            ' tengo que ver cual es el mas cercano

            For i = 0 To e.P.count - 2

                d = puntos.Distancia3D(eye, e.P[i])
                If DistEnd1 > d Then
                    DistEnd1 = d
                    puntoA = e.P[i].Copy()
                End If

                D = puntos.Distancia3D(eye, e.P[i + 1])

                If DistEnd2 > d Then
                    DistEnd2 = d
                    puntoB = e.P[i + 1].Copy()
                End If

                pTesting = New Punto3d((e.P[i + 1].X + e.P[i].x) / 2, (e.P[i + 1].y + e.P[i].y) / 2, (e.P[i + 1].z + e.P[i].z) / 2)

                d = puntos.Distancia3D(eye, pTesting)

                If DistMId > d Then
                    DistMId = d
                    pMid = pTesting.Copy()
                Endif

                ' ' perpendicular
                ' If gcd.Drawing.Sheet.LastPointPrevious Then                     ' tengo un punto anterior
                '
                '     If x1 - x0 <> 0 Then
                '         pend1 = (y1 - y0) / (x1 - x0)
                '         base1 = y1 - pend1 * x0                 ' Y = pend1 X + base1
                '
                '         ' ecuacion de la recta perpendicular que pasa por el punto anterior
                '         If pend1 <> 0 Then
                '             pend2 = -1 / pend1
                '             base2 = gcd.drawing.sheet.lastpoint[1] - pend2 * gcd.drawing.sheet.lastpoint[0]
                '
                '             ' necesito otro punto
                '             If gcd.drawing.sheet.lastpoint[0] <> 0 Then
                '                 puntoA.Add(0)
                '                 puntoA.Add(base2)
                '             Else
                '                 puntoA.Add(1)
                '                 puntoA.Add(pend2 + base2)
                '
                '             End If
                '
                '             ' determino la interseccion de ambas
                '             puntoB = puntos.lineLineIntersection(gcd.drawing.sheet.lastpoint, puntoA, [x0, y0], [x1, y1])
                '         Else ' la recta es horizontal
                '
                '             puntoB.Add(gcd.drawing.sheet.lastpoint[0])
                '             puntoB.Add(y0)
                '
                '         End If
                '     Else        ' la recta es vertical
                '
                '         puntoB.Add(x0)
                '         puntoB.Add(gcd.drawing.sheet.lastpoint[1])
                '
                '     End If
                '
                '     ' veo si el punto b esta entre los extremos de la linea , aunque deberia estarlo!!!
                '     If puntos.onSegment(x0, y0, puntoB[0], puntoB[1], x1, y1) Then
                '
                '         ' determino la distancia al puntero para ofrecerlo como opcion de enganche
                '         DistPer = puntos.distancia(puntoB[0], puntoB[1], xr, yr)
                '
                '     Endif
                ' End If
                '
                ' Break

            Next

            ' pNea = puntos.NearestToPolyLine(xr, yr, puntos.ToXY(e.P))
            '
            ' DistNearest = puntos.distancia(xr, yr, pNea[0], pNea[1])

    End Select

    ' veo cual es la opcion mas cercana al puntero

    ' dist = Min(DistBase, DistCenter, DistEnd1, DistEnd2, DistMid, DistPer, DistQuad) ' NO FUNCIONA

    If gcd.SnapMode And gcd.poiBasePoint Then
        If Dist > DistBase Then dist = DistBase
    End If
    If gcd.SnapMode And gcd.poiCenter Then
        If Dist > DistCenter Then dist = DistCenter
    End If
    If gcd.SnapMode And gcd.poiEndPoint Then
        If Dist > DistEnd1 Then dist = DistEnd1
        If Dist > DistEnd2 Then dist = DistEnd2
    End If
    If gcd.SnapMode And gcd.poiMIdPoint Then
        If Dist > DistMId Then dist = DistMId
    End If
    ' TODO: perpendicular, LastPoint is now the cursor position, not the previous click
    ' If gcd.SnapMode And gcd.poiPerpendicular Then
    '     If Dist > DistPer Then dist = DistPer
    ' End If
    If gcd.SnapMode And gcd.poiQuadrant Then
        If Dist > DistQuad Then dist = DistQuad
    End If
    ' TODO: tangent, same as perpendicular
    ' If gcd.SnapMode And gcd.poiTangent Then
    '     If Dist > DistTang Then dist = DistTang
    ' End If
    If gcd.SnapMode And gcd.poiIntersection Then
        If Dist > DistInter Then dist = DistInter
    End If

    If gcd.SnapMode And gcd.poiNearest Then
        If Dist > DistNearest Then dist = 0 'DistNearest
    End If

    ' ofrezco ese punto
    If dist = DistEnd1 Then
        rData = ["point": puntoA, "desc": "EndPoint", "mode": gcd.poiEndPoint]
        DrawingAIds.txtSnapTo = "EndPoint"
    End If

    If dist = DistEnd2 Then
        rData = ["point": puntoB, "desc": "EndPoint", "mode": gcd.poiEndPoint]
        DrawingAIds.txtSnapTo = "EndPoint"
    End If

    ' ofrezco ese punto
    If dist = DistMId Then
        rData = ["point": pMid, "desc": "MidPoint", "mode": gcd.poiMIdPoint]
        DrawingAIds.txtSnapTo = "MidPoint"
    End If

    ' ofrezco ese punto
    If dist = DistInter Then
        rData = ["point": pIntersection[iInter], "desc": "Intersection", "mode": gcd.poiIntersection]
        DrawingAIds.txtSnapTo = "Intersection"
    End If

    ' ' ofrezco ese punto
    ' If dist = DistPer Then
    '
    '     rData[0] = puntoB[0]
    '     rData[1] = puntoB[1]
    '     rData[2] = gcd.poiPerpendicular
    '     DrawingAIds.txtSnapTo = "Perpendicular"
    ' End If

    ' If dist = DistTang Then
    '
    '     rData[0] = tx
    '     rData[1] = ty
    '     rData[2] = gcd.poiTangent
    '     DrawingAIds.txtSnapTo = "Tangent"
    ' End If

    ' ofrezco ese punto
    If dist = DistCenter Then
        rData = ["point": e.p[0].Copy(), "desc": "Center", "mode": gcd.poiCenter]
        DrawingAIds.txtSnapTo = "Center"
    End If

    If dist = DistQuad Then
        rData = ["point": puntos.P3d(qx, qy, e.P[0].z), "desc": "Quadrant", "mode": gcd.poiQuadrant]
        DrawingAIds.txtSnapTo = "Quadrant"
    End If

    If dist = DistBase Then
        rData = ["point": e.p[0].Copy(), "desc": "Base point", "mode": gcd.poiBasePoint]
        DrawingAIds.txtSnapTo = "Base point"
    End If

    If dist = DistNearest Then
        rData = ["point": pNea, "desc": "Nearest"]
        DrawingAIds.txtSnapTo = "Nearest"
    End If

    Me.LastPointToCursorDistance = dist
    gcd.Drawing.eLastEntity = e
    rdata.Add(dist, "distance")
    Return rData

End

'' Devuelve el recorrido de la entidad como x,y,z planos, para buscar intersecciones
Private Function PathXYZ(e As Entity) As Float[]

    Dim flx As Float[]

    Select Case e.Gender
        Case "CIRCLE", "ARC", "ELLIPSE", "SPLINE", "RECTANGLE", "LWPOLYLINE"
            ' estas arman la PolyLine con x,y,z
            If e.PolyLine.Count >= 6 Then Return e.PolyLine
            If e.Gender = "LWPOLYLINE" Then Return puntos.ToXYZ(e.P)
        Case "LINE"
            Return puntos.ToXYZ(e.P)
        Case "SOLID"
            flx = puntos.ToXYZ(e.P)
            If e.P.Count > 2 Then flx.Insert(e.P[0].ToXYZ())
            Return flx
    End Select
    Return []

End

'' Agrega a pFound las intersecciones (en el plano XY) de los tramos de flxA cercanos a pCursor
'' con los tramos de flxB. Ambos son x,y,z planos, z se interpola sobre el tramo de flxA
Private Sub AddIntersections(flxA As Float[], flxB As Float[], pCursor As Punto3d, fTolerance As Float, pFound As Punto3d[])

    Dim i, j As Integer
    Dim f As Float[]
    Dim fLength, z As Float

    For i = 0 To flxA.Count - 6 Step 3
        ' solo me interesan los tramos de A que estan cerca del cursor
        If pCursor.x < Min(flxA[i], flxA[i + 3]) - fTolerance Or pCursor.x > Max(flxA[i], flxA[i + 3]) + fTolerance Then Continue
        If pCursor.y < Min(flxA[i + 1], flxA[i + 4]) - fTolerance Or pCursor.y > Max(flxA[i + 1], flxA[i + 4]) + fTolerance Then Continue

        For j = 0 To flxB.Count - 6 Step 3
            If Not puntos.doIntersect(flxA[i], flxA[i + 1], flxA[i + 3], flxA[i + 4], flxB[j], flxB[j + 1], flxB[j + 3], flxB[j + 4]) Then Continue
            f = puntos.lineLineIntersection2(flxA[i], flxA[i + 1], flxA[i + 3], flxA[i + 4], flxB[j], flxB[j + 1], flxB[j + 3], flxB[j + 4])
            If f.Count < 2 Then Continue    ' paralelas

            z = flxA[i + 2]
            fLength = puntos.distancia(flxA[i], flxA[i + 1], flxA[i + 3], flxA[i + 4])
            If fLength > 0 Then z += (flxA[i + 5] - flxA[i + 2]) * puntos.distancia(flxA[i], flxA[i + 1], f[0], f[1]) / fLength
            pFound.Add(puntos.P3d(f[0], f[1], z))
        Next
    Next

End

