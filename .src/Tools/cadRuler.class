' Tool maintained by Terco
Inherits ToolsBase
Create Static
Public Const Gender As String = "RULER"

Private Poli As New Punto3d[]
Private fLength As Float
Private fLengthTotal As Float

Public Function Start(Optional ElemToBuild As Variant, Optional _Mode As Integer = 0) As Boolean
    ' Llamada por FCAD al inicio de la aplicacion de esta herramienta

    ' Aprovechamos para establecer los helpers (comentarios de ayuda en pantalla)
    Me.PointsDone = 0
    Me.PointsTotal = 1e10

    Me.Prompt = ("mark points")
    Me.SelEndP = New Punto3d
    poli.Clear
    Poli.Add(Me.SelEndP.Copy())

    Me.Active = True

End

Public Sub NewParameter(tipo As String, vValor As Variant, Optional definitive As Boolean = False)

    Select Case LCase(tipo)
        Case "point"
            Me.SelEndP = vValor.copy()

            If definitive Then

                Inc Me.PointsDone

                Poli[Poli.max] = Me.SelEndP.Copy()
                Poli.Add(Me.SelEndp.Copy())

            Else

                If Poli.Count = 0 Then Return
                Poli[Poli.max] = Me.SelEndP.Copy()

                If Me.PointsDone >= 1 Then

                    fLengthTotal = puntos.PoligonLength(puntos.ToXY(poli))

                    fLength = puntos.distancia(poli[poli.max - 1].x, poli[poli.max - 1].y, poli[poli.max].x, poli[poli.max].y)
                    Me.Prompt = ("Last trame") & " = " & Format(fLength, Config.FormatInquiries) & " - " & ("Total length") & " = " & Format(fLengthTotal, Config.FormatInquiries)

                Endif

                gcd.Redraw
            End If
        Case Else

            If Trim(LCase(vvalor)) = "_cancel" Then Me.Cancel
    End Select

End

Public Sub Draw()               ' called by gcd.CurrDrawing.drwArea_Draw

    glx.PolyLinesP(Poli, Color.DarkBlue, Color.RGB(0, 255, 100, 200))

End

Public Sub Finish()

    If poli.Count > 3 Then poli.Resize(poli.Count - 1)
    fLengthTotal = puntos.PoligonLength(puntos.ToXY(poli))

    gcd.debugInfo(("Last trame") & " = " & Format(fLength, Config.FormatInquiries),, True)
    gcd.debugInfo(("Total length") & " = " & Format(fLengthTotal, Config.FormatInquiries),, True)
    Super.Finish()

End
