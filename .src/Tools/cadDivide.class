Inherits ToolsBase
Create Static
Public Const Gender As String = "DIVIDE"

Public Offset As Float
Public EntitySelected As Entity
' Workflow
'   1 Select entity/face if 3D
'   2 If entity is valid to offset, select point to split it or start point of poly
'   3 Second point or end point of poly if 3D

Public Function Start(Optional ElemToBuild As Variant, Optional _Mode As Integer = 0) As Boolean

    ' chequeamos si hubo seleccion previa

    If gcd.Drawing.Sheet.EntitiesSelected.Count <> 1 Then
        clsEntities.DeSelection()
        Me.Prompt = ("Select only one entity")
        If gcd.Drawing.Sheet.Is3D Then Me.Prompt = ("Select only one face")
        gcd.clsJobCallBack = Me
        gcd.clsJob = cadSelection
        cadSelection.ReturnOnFirstSelection = True
        cadSelection.SelectType = cadSelection.SelectTypeFace

    Else
        ' verificamos si la entidad puede ser partida
        Me.EntitySelected = gcd.Drawing.Sheet.EntitiesSelected[gcd.Drawing.Sheet.EntitiesSelected.First]

        Select Me.EntitySelected.Gender
            Case "LINE", "LWPOLYLINE", "CIRCLE", "ARC", "ELLIPSE", "SPLINE"
                clsEntities.SelectElem(Me.EntitySelected)
                DrawingAIds.Helper.texto = ("First breakpoint of entity")
                Me.ExpectedParam = "first"
            Case "MESH"
                ' verifico que haya elegido una face
                If Not gcd.Drawing.Sheet.LastFace Then

                Endif
                Me.ExpectedParam = "first"

            Case Else
                Me.EntitySelected = Null
                DrawingAIds.ErrorMessage = ("Can't divide that entity")
        End Select

    Endif

End

'' cadSelection o algun otro proceso nos devuelve el control
Public Sub Run()

    If gcd.Drawing.Sheet.EntitiesSelected.Count = 0 Then                                     ' we have no elements in the selection

        Me.Prompt = ("Select only one entity")
        gcd.clsJobCallBack = Me
        gcd.clsJob = cadSelection
        cadSelection.ReturnOnFirstSelection = True

    Else                                                                    ' need the first point

        ' verificamos si la entidad puede ser partida
        Me.EntitySelected = gcd.Drawing.Sheet.EntitiesSelected[gcd.Drawing.Sheet.EntitiesSelected.First]

        Select Me.EntitySelected.Gender
            Case "LINE", "LWPOLYLINE", "CIRCLE", "ARC", "ELLIPSE", "SPLINE", "MESH"
                clsEntities.SelectElem(Me.EntitySelected)
                Me.Prompt = ("First breakpoint of entity")
                Me.ExpectedParam = "first"
            Case Else
                Me.EntitySelected = Null
                DrawingAIds.ErrorMessage = ("Can't break that entity")
        End Select

    Endif

End

Public Sub NewParameter(tipo As String, vValor As Variant, Optional definitive As Boolean = False)

    Dim flxIntersec As Float[]
    Dim e, e2 As Entity
    ' si llegue aca es porque ya tengo una entidad seleccionada
    e = Me.EntitySelected       ' esto lo hago para reducir el largo del codigo
    If LCase(tipo) <> "point2d" Or LCase(tipo) <> "point3d" Then

        DrawingAIds.ErrorMessage = ("Invalid input")
        Return

    Endif

    If Me.ExpectedParam = "first" Then ' marco el primer punto

        Me.SelStartP = New Punto3d(vValor.x, vValor.y, vValor.z)
        Me.ExpectedParam = "end"

        If gcd.Drawing.HoveredEntity <> Me.EntitySelected Then ' el mouse se fue de la entidad a romper
            DrawingAIds.ErrorMessage = ("Invalid breakpoint, must be in the same " & Me.EntitySelected.Gender)
            Return
        End If

        ' supongo que el primer punto esta ok

        Select e.Gender
            Case "LINE"
                flxIntersec = clsMouseTracking.GetNearestPoint(e, Me.SelStartP.x, Me.SelStartp.Y)
                Me.SelStartP.x = flxIntersec[0]
                Me.SelStartp.y = flxIntersec[1]
                Me.Prompt = ("Second breakpoint of entity")
                Me.ExpectedParam = "next"

            Case Else
                Me.iEntitySelected = Null
                DrawingAIds.ErrorMessage = ("Can't offset that entity")
        End Select

    Else If Me.ExpectedParam = "next" Then ' acabo de marcar el segundo punto
        Me.SelEndP = New Punto3d(vValor.x, vValor.y, vValor.z)
        If gcd.Drawing.HoveredEntity <> Me.EntitySelected Then ' el mouse se fue de la entidad a romper
            DrawingAIds.ErrorMessage = ("InvalId breakpoint")
            Return
        End If
        gcd.Drawing.uUndo.OpenUndoStage("Divide", Undo.TypeModify)
        gcd.Drawing.uUndo.AddUndoItem(e)
        Select e.Gender
            Case "LINE"
                flxIntersec = clsMouseTracking.GetNearestPoint(e, Me.SelEndP.x, Me.SelEndP.y)
                Me.SelEndP.x = flxIntersec[0]
                Me.SelEndP.y = flxIntersec[1]

                ' ahora tengo que partir la entidad, pero puede ocurrir que el punto sea uno de los dos endpoints
                ' If (flxIntersec[0] = e.P[0] And flxIntersec[1] = e.P[1]) Or (flxIntersec[0] = e.P[2] And flxIntersec[1] = e.P[3]) Then
                '     DrawingAids.ErrorMessage = "Invalid breakpoint"
                '     Return
                ' Endif
                ' entonces parto la entidad
                e2 = clsEntities.ClonEntity(e, True)          ' primero la clono

                ' veo cual esta mas cerca del punto inicial
                If puntos.distancia(e.P[0], e.P[1], Me.SelStartp.X, Me.SelStartp.Y) > puntos.distancia(e.P[0], e.P[1], Me.Selendp.X, Me.SelEndP.Y) Then

                    e2.P[2] = Me.SelEndP.X                   ' corrijo los puntos
                    e2.P[3] = Me.SelEndP.Y

                    e.P[0] = Me.SelStartP.X                 ' y ahora recorto la entidad original
                    e.P[1] = Me.SelStartP.y
                Else
                    e2.P[0] = Me.SelEndP.X                   ' corrijo los puntos
                    e2.P[1] = Me.SelEndP.Y

                    e.P[2] = Me.SelStartP.X                 ' y ahora recorto la entidad original
                    e.P[3] = Me.SelStartP.y

                End If

                ' tareas finales en las entidades
                Gcd.CCC[e2.gender].finish(e2)
                gcd.Drawing.uUndo.AddUndoItem(e2, Undo.TypeCreate)
                gcd.Drawing.Sheet.Entities.Add(e2, e2.Id)       ' la agrego al dibujo
                gcd.CCC[e.gender].finish(e)                ' para regenerar los POI

                ' regenro las listas openGL de ambas entidades
                ' fix clsEntities. glGenDrawList(e)
                ' fix clsEntities. glGenDrawList(e2)

                Me.Finish

            Case Else
                Me.iEntitySelected = Null
                DrawingAIds.ErrorMessage = ("Can't divide that entity")
        End Select
        gcd.Drawing.uUndo.CloseUndoStage()
    End If

End
