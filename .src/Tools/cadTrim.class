Inherits ToolsBase
Create Static
Public Const Gender As String = "TRIM"

Private Tijeras As New Collection
Private Recortes As New Collection
Private eRecortar As Entity
Private eNewPart As Entity
Private Multiple As Boolean

Public Function Start(Optional ElemToBuild As Variant, Optional _Mode As Integer = 0) As Boolean

    ' Aprovechamos para establecer los helpers (comentarios de ayuda en pantalla)
    Me.PointsDone = 0
    Me.PointsTotal = 2

    gcd.clsJob.EntityChecking = True
    Tijeras.Clear
    gcd.Drawing.Sheet.EntitiesSelected.Clear
    '    If gcd.Drawing.Sheet.EntitiesSelected.Count = 0 Then                                     ' we have no elements in the selection

    Me.Prompt = ("Select cutting edges")
    gcd.clsJobPrevious = Me
    gcd.clsJobCallBack = Me
    gcd.clsJob = cadSelection

    ' preparo cadSelection para lo que necesito

    cadSelection.ReturnOnFirstSelection = False
    cadSelection.AllowGripEdit = False
    cadSelection.AllowPolySelection = True
    cadSelection.AllowRectSelection = True
    cadSelection.AllowSingleSelection = True
    cadSelection.AllowTextInput = False

    ' Else                                                               ' TENEMOS QUE PEDIR MAS ENTIDADES PARA CORTAR
    '
    '     ' recolecto las tijeras
    '     Tijeras = clsEntities.SelectionCombine(Null, gcd.Drawing.Sheet.EntitiesSelected, "new")
    '     gcd.clsJobPrevious = Me
    '     gcd.clsJob = cadSelection
    '     cadSelection.Prompt = Me.Prompt
    '     Me.Prompt &= ": " & ("entities to cut")
    '     cadSelection.ReturnOnFirstSelection = True
    '     'DrawingAids.CmdLineHelper = DrawingAids.CmdLineHelper & str(gcd.Drawing.oSelected.count) & (" elements")
    '
    ' Endif
    gcd.Drawing.Sheet.GlSheet.PopupMenu = ""
    fmain.PopupMenu = ""
    DrawingAIds.Helper.texto = Me.Prompt

End

'' cadSelection o algun otro proceso nos devuelve el control
Public Sub Run()

    Dim e As Entity

    Me.SelEndXr = cadSelection.SelEndXr ' gcd.Xreal(mouse.x)
    Me.SelEndyr = cadSelection.SelEndyr 'gcd.Yreal(mouse.y)
    If Me.PointsDone = 0 Then ' estamos recolectando tijeras para el Trim

        ' recolecto las tijeras
        Tijeras = clsEntities.SelectionCombine(Null, gcd.Drawing.Sheet.EntitiesSelected, "new")
        If Tijeras.Count = 0 Then
            Me.Prompt = ("Select cutting edges")
            DrawingAIds.Helper.texto = Me.Prompt
            gcd.clsJobCallBack = Me
            gcd.clsJob = cadSelection

            cadSelection.ReturnOnFirstSelection = False

        Else
            gcd.clsJobCallBack = Me
            gcd.clsJob = cadSelection
            gcd.Drawing.Sheet.EntitiesSelected.Clear
            Me.Prompt = ("entities to cut")
            DrawingAIds.Helper.texto = Me.Prompt

            cadSelection.SelectCrossing = True
            cadSelection.ReturnOnFirstSelection = True
            Me.PointsDone = 1
        Endif
    Else    ' estamos recolectando entodades a recortar

        ' verifico que el user haya terminado de recortar
        If gcd.Drawing.Sheet.EntitiesSelected.Count = 0 Then
            Me.Finish
            Return
        Endif
        If gcd.Drawing.Sheet.EntitiesSelected.Count > 1 Then Multiple = True Else Multiple = False

        gcd.Drawing.uUndo.OpenUndoStage("Trim entities", Undo.TypeModify)
        For Each e In gcd.Drawing.Sheet.EntitiesSelected
            eRecortar = e
            DoTrim
            gcd.Drawing.Sheet.EntitiesSelected.Remove(e.id)
        Next

        gcd.Drawing.uUndo.CloseUndoStage()

        ' vuelvo  a buscar entidades paara recortar
        gcd.clsJobCallBack = Me
        gcd.clsJob = cadSelection

    End If

End

'' Esta sub recorta una linea con otras cosas
Public Sub DoTrim()

    'gcd.Drawing.uUndo.OpenUndoStage("Trim", Undo.TypeModify)
    gcd.Drawing.uUndo.AddUndoItem(eRecortar, Undo.TypeModify)
    Select Case eRecortar.Gender
        Case "LINE"
            DoTrimLine
        Case "LWPOLYLINE"
            DoTrimPline
        Case "CIRCLE"
            DoTrimCircle
        Case "ARC", "ELLIPSE"
            DoTrimArc

    End Select
    gcd.Drawing.uUndo.AddUndoItem(eNewPart, Undo.TypeCreate)
    'gcd.Drawing.uUndo.CloseUndoStage

End

'' Esta sub recorta una linea con otras cosas
Public Sub DoTrimLine()

    Dim i As Integer, flxIntersec As New Float[]
    Dim Xcorte As Float
    Dim eTijera As Entity

    Dim C1x, C1y, C2x, C2y As Float ' candidatos al recorte, C1 es el que esta mas cerca de P01 y C2 de P23
    Dim Ycorte As Float

    If Multiple Then
        If eRecortar.Psel[0] Then

            Xcorte = eRecortar.P[0].x
            Ycorte = eRecortar.P[0].y
        Else
            Xcorte = eRecortar.P[1].x
            Ycorte = eRecortar.P[1].y
        End If
    Else

        Xcorte = Me.SelEndXr
        Ycorte = Me.SelEndyr
    Endif
    ' debo encontrar los puntos de corte mas cercanos a cada lado del punto que esta sobre la entidad a recortar
    C1x = eRecortar.P[0].x
    C1y = eRecortar.P[0].y        ' inicialmente estan en los limites
    C2x = eRecortar.P[1].x
    C2y = eRecortar.P[1].y

    For Each eTijera In Tijeras
        Select Case eTijera.Gender
            Case "LINE"
                If puntos.doIntersect(eRecortar.P[0].x, eRecortar.P[0].y, eRecortar.P[1].x, eRecortar.P[1].y, eTijera.P[0].x, eTijera.P[0].y, eTijera.P[1].x, eTijera.P[1].y) Then

                    ' obtengo el punto de interseccion
                    flxIntersec = puntos.lineLineIntersection([eRecortar.P[0].x, eRecortar.P[0].y], [eRecortar.P[1].x, eRecortar.P[1].y], [eTijera.P[0].x, eTijera.P[0].y], [eTijera.P[1].x, eTijera.P[1].y])
                    If flxIntersec.Count = 0 Then Continue
                    ' ahora veo cual es el lado a recortar
                    ' necesito encontrar los vectores, si van en direccion contraria, es el punto a recortar
                    '       P1------X--------------|----------------P2
                    '            click           tijera

                    If puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, flxIntersec[0], flxIntersec[1]) Then

                        ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                        If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                            C1x = flxIntersec[0]
                            C1y = flxIntersec[1]
                        End If

                    Endif

                    ' lo mismo para P23
                    If puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, flxIntersec[0], flxIntersec[1]) Then

                        ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                        If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                            C2x = flxIntersec[0]
                            C2y = flxIntersec[1]
                        End If

                    Endif

                Endif
            Case "LWPOLYLINE"

                For i = 0 To eTijera.P.Count - 2         ' Idem linea, pero  para todos los tramos de la polilinea

                    If puntos.doIntersect(eRecortar.P[0].x, eRecortar.P[0].y, eRecortar.P[1].x, eRecortar.P[1].y, eTijera.P[i].x, eTijera.P[i].y, eTijera.P[i + 1].x, eTijera.P[i + 1].y) Then

                        ' obtengo el punto de interseccion
                        flxIntersec = puntos.lineLineIntersection([eRecortar.P[0].x, eRecortar.P[0].y], [eRecortar.P[1].x, eRecortar.P[1].y], [eTijera.P[i].x, eTijera.P[i].y], [eTijera.P[i + 1].x, eTijera.P[i + 1].y])
                        If flxIntersec.Count = 0 Then Continue
                        If puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                C1x = flxIntersec[0]
                                C1y = flxIntersec[1]
                            End If

                        Endif

                        ' lo mismo para P23
                        If puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                C2x = flxIntersec[0]
                                C2y = flxIntersec[1]
                            End If

                        Endif

                    Endif

                Next

            Case "Text", "MText"

                For i = 0 To eTijera.Polygon.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                    If puntos.doIntersect(eRecortar.P[0].x, eRecortar.P[0].y, eRecortar.P[1].x, eRecortar.P[1].y, eTijera.polygon[i + 0], eTijera.polygon[i + 1], eTijera.polygon[i + 2], eTijera.polygon[i + 3]) Then

                        ' obtengo el punto de interseccion
                        flxIntersec = puntos.lineLineIntersection([eRecortar.P[0].x, eRecortar.P[0].y], [eRecortar.P[1].x, eRecortar.P[1].y], [eTijera.polygon[i + 0], eTijera.polygon[i + 1]], [eTijera.polygon[i + 2], eTijera.polygon[i + 3]])
                        If flxIntersec.Count = 0 Then Continue
                        If puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                C1x = flxIntersec[0]
                                C1y = flxIntersec[1]
                            End If

                        Endif

                        ' lo mismo para P23
                        If puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                C2x = flxIntersec[0]
                                C2y = flxIntersec[1]
                            End If

                        Endif

                    Endif

                Next
            Case "ARC", "ELLIPSE", "CIRCLE"

                For i = 0 To eTijera.polyline.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                    If puntos.doIntersect(eRecortar.P[0].x, eRecortar.P[0].y, eRecortar.P[1].x, eRecortar.P[1].y, eTijera.polyline[i + 0], eTijera.polyline[i + 1], eTijera.polyline[i + 2], eTijera.polyline[i + 3]) Then

                        ' obtengo el punto de interseccion
                        flxIntersec = puntos.lineLineIntersection([eRecortar.P[0].x, eRecortar.P[0].y], [eRecortar.P[1].x, eRecortar.P[1].y], [eTijera.polyline[i + 0], eTijera.polyline[i + 1]], [eTijera.polyline[i + 2], eTijera.polyline[i + 3]])
                        If flxIntersec.Count = 0 Then Continue
                        If puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[0].x, eRecortar.P[0].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                C1x = flxIntersec[0]
                                C1y = flxIntersec[1]
                            End If

                        Endif

                        ' lo mismo para P23
                        If puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, Xcorte, Ycorte) > puntos.distancia(eRecortar.P[1].x, eRecortar.P[1].y, flxIntersec[0], flxIntersec[1]) Then

                            ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                            If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                C2x = flxIntersec[0]
                                C2y = flxIntersec[1]
                            End If

                        Endif

                    Endif

                Next
        End Select
    Next
    ' termine la busqueda de puntos de recorte
    'ahora recorto la entidad
    ' primer o determino si debo partir la entidad o si solo se recorta
    If (eRecortar.P[0].x = C1x) And (eRecortar.P[0].y = C1y) And (eRecortar.P[1].x = C2x) And (eRecortar.P[1].y = C2y) Then
        ' este entidad no sera recortada

    Else If (eRecortar.P[0].x = C1x) And (eRecortar.P[0].y = C1y) Then ' elimino el tramo P01 - C2

        eRecortar.P[0].x = C2x
        eRecortar.P[0].y = C2y

    Else If (eRecortar.P[1].x = C2x) And (eRecortar.P[1].y = C2y) Then ' elimino el tramo p23 - C1

        eRecortar.P[1].x = C1x
        eRecortar.P[1].y = C1y

    Else ' se parte en dos la entidad

        eNewPart = clsEntities.ClonEntity(eRecortar)          ' primero la clono
        eNewPart.P[0].x = C2x
        eNewPart.P[0].y = C2y

        ' tareas finales en las entidades
        Gcd.CCC[eNewPart.gender].finish(eNewPart)
        gcd.Drawing.Sheet.Entities.Add(eNewPart, eNewPart.Id)                ' la agrego al dibujo

        eRecortar.P[1].x = C1x
        eRecortar.P[1].y = C1y
        Gcd.CCC[eRecortar.gender].finish(eRecortar)                ' para regenerar los POI

    End If
    gcd.Regen

End

'' Esta sub recorta una polilinea con otras cosas
Public Sub DoTrimPline()

    Dim i As Integer, flxIntersec As New Float[]
    Dim Xcorte As Float
    Dim eTijera As Entity

    Dim C1x, C1y, C2x, C2y As Float ' candidatos al recorte, C1 es el que esta mas cerca de P01 y C2 de P23
    Dim TramoC1, TramoC2 As Integer ' tramos donde estan los puntos para recortar
    Dim T1x, T1y, T2x, T2y As Float ' puntos del tramo en cuestion
    Dim Ycorte As Float
    Dim TramoCorte, t, tramo As Integer

    Xcorte = Me.SelEndXr
    Ycorte = Me.SelEndyr

    ' necesito encontrar el tramo donde esta el punto
    TramoCorte = puntos.inPolySegment(puntos.ToXY(eRecortar.P), Xcorte, Ycorte, gcd.Metros(16))

    ' debo encontrar los puntos de corte mas cercanos a cada lado del punto que esta sobre la entidad a recortar
    C1x = eRecortar.P[0].x
    C1y = eRecortar.P[0].y        ' inicialmente estan en los limites
    C2x = eRecortar.P[eRecortar.P.Max].x
    C2y = eRecortar.P[eRecortar.P.Max].y

    TramoC1 = 0                         ' y los tramos en el primero y el ultimo
    TramoC2 = eRecortar.P.Count

    For t = 0 To eRecortar.P.Count - 2         ' Idem linea, pero  para todos los tramos de la polilinea
        Tramo = t + 1
        T1x = eRecortar.P[t].x
        T1y = eRecortar.P[t].y
        T2x = eRecortar.P[t + 1].x
        T2y = eRecortar.P[t + 1].y

        For Each eTijera In Tijeras
            Select Case eTijera.Gender
                Case "LINE"
                    If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[0].x, eTijera.P[0].y, eTijera.P[1].x, eTijera.P[1].y) Then

                        ' obtengo el punto de interseccion
                        flxIntersec = puntos.lineLineIntersection([T1x, T1y], [T2x, T2y], [eTijera.P[0].x, eTijera.P[0].y], [eTijera.P[1].x, eTijera.P[1].y])
                        If flxIntersec.Count = 0 Then Continue
                        ' veo si este tramo es mas cercano al del punto de corte
                        If tramo <= TramoCorte And tramo >= TramoC1 Then

                            If puntos.distancia(T1x, T1y, Xcorte, Ycorte) > puntos.distancia(T1x, T1y, flxIntersec[0], flxIntersec[1]) Then
                                TramoC1 = tramo
                                ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                                If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                    C1x = flxIntersec[0]
                                    C1y = flxIntersec[1]
                                End If

                            Endif
                        End If

                        ' veo si este tramo es mas cercano al del punto de corte, pasando el mismo
                        If tramo >= TramoCorte And tramo <= TramoC2 Then

                            ' lo mismo para P23
                            If puntos.distancia(T2x, T2y, Xcorte, Ycorte) > puntos.distancia(T2x, T2y, flxIntersec[0], flxIntersec[1]) Then
                                TramoC2 = tramo
                                ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                                If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                    C2x = flxIntersec[0]
                                    C2y = flxIntersec[1]
                                End If

                            Endif
                        End If

                    Endif
                Case "LWPOLYLINE"

                    For i = 0 To eTijera.P.Count - 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[i].x, eTijera.P[i].y, eTijera.P[i + 1].x, eTijera.P[i + 1].y) Then

                            ' obtengo el punto de interseccion
                            flxIntersec = puntos.lineLineIntersection([T1x, T1y], [T2x, T2y], [eTijera.P[i].x, eTijera.P[i].y], [eTijera.P[i + 1].x, eTijera.P[i + 1].y])
                            If flxIntersec.Count = 0 Then Continue
                            If tramo <= TramoCorte And tramo >= TramoC1 Then

                                If puntos.distancia(T1x, T1y, Xcorte, Ycorte) > puntos.distancia(T1x, T1y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC1 = tramo
                                    ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                        C1x = flxIntersec[0]
                                        C1y = flxIntersec[1]
                                    End If

                                Endif
                            End If
                            ' lo mismo para P23
                            If tramo >= TramoCorte And tramo <= TramoC2 Then

                                If puntos.distancia(T2x, T2y, Xcorte, Ycorte) > puntos.distancia(T2x, T2y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC2 = tramo
                                    ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                        C2x = flxIntersec[0]
                                        C2y = flxIntersec[1]
                                    End If

                                Endif
                            Endif
                        Endif

                    Next

                Case "Text", "MText"

                    For i = 0 To eTijera.Polygon.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polygon[i + 0], eTijera.polygon[i + 1], eTijera.polygon[i + 2], eTijera.polygon[i + 3]) Then

                            ' obtengo el punto de interseccion
                            flxIntersec = puntos.lineLineIntersection([T1x, T1y], [T2x, T2y], [eTijera.polygon[i + 0], eTijera.polygon[i + 1]], [eTijera.polygon[i + 2], eTijera.polygon[i + 3]])
                            If tramo <= TramoCorte And tramo >= TramoC1 Then
                                If flxIntersec.Count = 0 Then Continue
                                If puntos.distancia(T1x, T1y, Xcorte, Ycorte) > puntos.distancia(T1x, T1y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC1 = tramo
                                    ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                        C1x = flxIntersec[0]
                                        C1y = flxIntersec[1]
                                    End If

                                Endif
                            End If
                            ' lo mismo para P23
                            If tramo >= TramoCorte And tramo <= TramoC2 Then

                                If puntos.distancia(T2x, T2y, Xcorte, Ycorte) > puntos.distancia(T2x, T2y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC2 = tramo
                                    ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                        C2x = flxIntersec[0]
                                        C2y = flxIntersec[1]
                                    End If

                                Endif
                            End If
                        Endif

                    Next
                Case "ARC", "ELLIPSE", "CIRCLE"

                    For i = 0 To eTijera.polyline.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polyline[i + 0], eTijera.polyline[i + 1], eTijera.polyline[i + 2], eTijera.polyline[i + 3]) Then

                            ' obtengo el punto de interseccion
                            flxIntersec = puntos.lineLineIntersection([T1x, T1y], [T2x, T2y], [eTijera.polyline[i + 0], eTijera.polyline[i + 1]], [eTijera.polyline[i + 2], eTijera.polyline[i + 3]])
                            If flxIntersec.Count = 0 Then Continue
                            If tramo <= TramoCorte And tramo >= TramoC1 Then

                                If puntos.distancia(T1x, T1y, Xcorte, Ycorte) > puntos.distancia(T1x, T1y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC1 = tramo
                                    ' el punto encontrado esta a la izq del click, entonces lo asignamos a C1, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C1x, C1y, Xcorte, Ycorte) Then
                                        C1x = flxIntersec[0]
                                        C1y = flxIntersec[1]
                                    End If

                                Endif
                            End If
                            ' lo mismo para P23
                            If tramo >= TramoCorte And tramo <= TramoC2 Then

                                If puntos.distancia(T2x, T2y, Xcorte, Ycorte) > puntos.distancia(T2x, T2y, flxIntersec[0], flxIntersec[1]) Then
                                    TramoC2 = tramo
                                    ' el punto encontrado esta a la derecha del click, entonces lo asignamos a C2, pero solo si es mas cercano
                                    If puntos.distancia(Xcorte, Ycorte, flxIntersec[0], flxIntersec[1]) < puntos.distancia(C2x, C2y, Xcorte, Ycorte) Then
                                        C2x = flxIntersec[0]
                                        C2y = flxIntersec[1]
                                    End If

                                Endif
                            End If
                        Endif

                    Next
            End Select
        Next
    Next
    ' termine la busqueda de puntos de recorte
    'ahora recorto la entidad
    ' primer o determino si debo partir la entidad o si solo se recorta
    If (TramoC1 = 0) And (TramoC2 = eRecortar.P.Count) Then
        ' este entidad no sera recortada

    Else If (TramoC1 >= 1) And (TramoC2 = eRecortar.P.Count) Then
        ' elimino el tramo inicial al corte

        eRecortar.P[TramoC1].x = C1x
        eRecortar.P[TramoC1].y = C1y
        ' elimino el resto
        eRecortar.P.Remove(TramoC1 + 1, eRecortar.P.Max - TramoC1)

    Else If (TramoC1 = 0) And (TramoC2 <= eRecortar.P.Count - 1) Then
        ' elimino el tramo del corte al final

        eRecortar.P[TramoC2 - 1].x = C2x
        eRecortar.P[TramoC2 - 1].y = C2y
        ' elimino el resto
        eRecortar.P.Remove(0, TramoC2 - 1)

    Else ' se parte en dos la entidad

        eNewPart = clsEntities.ClonEntity(eRecortar)          ' primero la clono

        eNewPart.P[TramoC2 - 1].x = C2x
        eNewPart.P[TramoC2 - 1].y = C2y
        ' elimino el resto
        eNewPart.P.Remove(0, TramoC2 - 1)

        ' tareas finales en las entidades

        gcd.Drawing.Sheet.Entities.Add(eNewPart, eNewPart.Id)                ' la agrego al dibujo

        eRecortar.P[TramoC1].x = C1x
        eRecortar.P[TramoC1].y = C1y
        ' elimino el resto
        eRecortar.P.Remove(TramoC1 + 1, eRecortar.P.Max - TramoC1)

    End If

    gcd.Regen

End

'' Esta sub recorta una cosa con otras cosas
Public Sub DoTrimCircle()

    Dim i As Integer
    Dim Xcorte As Float
    Dim eTijera As Entity

    Dim C1, C2 As Float ' candidatos al recorte, C1 es el que esta mas cerca de 0 y C2 de 360
    Dim T1x, T1y, T2x, T2y As Float ' puntos del tramo en cuestion
    Dim Ycorte, theta, angle_increment As Float
    Dim AngCorte As Float

    Xcorte = Me.SelEndXr    ' el lugar donde e user hizo click en la entidad a cortar
    Ycorte = Me.SelEndyr
    AngCorte = Ang(Xcorte - eRecortar.P[0].x, Ycorte - eRecortar.P[0].y)
    If AngCorte < 0 Then AngCorte += 2 * Pi

    ' debo encontrar los puntos de corte mas cercanos a cada lado del punto que esta sobre la entidad a recortar
    ' es este caso son angulos

    C1 = 0        ' inicialmente estan en los limites
    C2 = 2 * Pi

    angle_increment = Pi * 2 / 360
    For theta = (0 + angle_increment) To (2 * Pi) Step angle_increment
        ' el punto considerando 0,0 al centro
        T1x = eRecortar.P[0].x + eRecortar.fParam[0] * Cos(theta - angle_increment)
        T1y = eRecortar.P[0].y + eRecortar.fParam[0] * Sin(theta - angle_increment)

        T2x = eRecortar.P[0].x + eRecortar.fParam[0] * Cos(theta)
        T2y = eRecortar.P[0].y + eRecortar.fParam[0] * Sin(theta)

        For Each eTijera In Tijeras
            Select Case eTijera.Gender
                Case "LINE"
                    If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[0].x, eTijera.P[0].y, eTijera.P[1].x, eTijera.P[1].y) Then

                        If theta > C1 And theta <= AngCorte Then C1 = theta
                        If theta < C2 And theta > AngCorte Then C2 = theta

                    Endif
                Case "PLine"

                    For i = 0 To eTijera.P.Count - 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[i].x, eTijera.P[i].y, eTijera.P[i + 1].x, eTijera.P[i + 1].y) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta

                        Endif

                    Next

                Case "Text", "MText"

                    For i = 0 To eTijera.Polygon.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polygon[i + 0], eTijera.polygon[i + 1], eTijera.polygon[i + 2], eTijera.polygon[i + 3]) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta
                        Endif

                    Next
                Case "ARC", "ELLIPSE", "CIRCLE"

                    For i = 0 To eTijera.polyline.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polyline[i + 0], eTijera.polyline[i + 1], eTijera.polyline[i + 2], eTijera.polyline[i + 3]) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta

                        Endif

                    Next
            End Select
        Next
    Next
    ' termine la busqueda de puntos de recorte
    'ahora recorto la entidad
    ' primer o determino si debo partir la entidad o si solo se recorta
    If (0 = C1) And (2 * Pi = C2) Then
        ' este entidad no sera recortada

    Else ' se transforma la etidad en un arco

        ' tareas finales en las entidades
        eRecortar.Gender = "ARC"
        Gcd.CCC[eRecortar.gender] = cadArc
        eRecortar.fParam.Add(Deg(C2))
        eRecortar.fParam.Add(Deg(C1))
        eRecortar.fParam.Add(1)

    End If
    gcd.Regen

End

'' Esta sub recorta una cosa con otras cosas
Public Sub DoTrimArc()

    Dim i As Integer
    Dim Xcorte As Float
    Dim eTijera As Entity

    Dim C1, C2 As Float ' candidatos al recorte, C1 es el que esta mas cerca de 0 y C2 de 360
    Dim T1x, T1y, T2x, T2y As Float ' puntos del tramo en cuestion
    Dim Ycorte, theta, angle_increment As Float
    Dim AngCorte As Float
    Dim major, minor, angle As Float

    Xcorte = Me.SelEndXr    ' el lugar donde e user hizo click en la entidad a cortar
    Ycorte = Me.SelEndyr
    AngCorte = Ang(Xcorte - eRecortar.P[0].x, Ycorte - eRecortar.P[0].y)
    If AngCorte < 0 Then AngCorte += 2 * Pi

    ' debo encontrar los puntos de corte mas cercanos a cada lado del punto que esta sobre la entidad a recortar
    ' es este caso son angulos

    C1 = eRecortar.fParam[1] / 180 * Pi       ' inicialmente estan en los limites
    C2 = eRecortar.fParam[2] / 180 * Pi       ' estos paramertros estaban en GRADOS

    angle_increment = Pi * 2 / 360

    If eRecortar.Gender = "ELLIPSE" Then ' aditional data
        major = Sqr((eRecortar.P[1].x - eRecortar.P[0].x) ^ 2 + (eRecortar.P[1].y - eRecortar.P[0].y) ^ 2)
        angle = Ang(eRecortar.P[1].x - eRecortar.P[0].x, eRecortar.P[1].y - eRecortar.P[0].y)          ' Los coordenadas del eje mayor son relativas al centro
        Minor = major * eRecortar.fParam[0]
        If major = 0 Then major = 1
    End If

    For theta = eRecortar.fParam[1] / 180 * Pi + angle_increment To eRecortar.fParam[2] / 180 * Pi Step angle_increment

        If eRecortar.Gender = "ELLIPSE" Then
            ' el punto considerando 0,0 al centro

            T1x = eRecortar.P[0].x + major * Cos(theta - angle_increment) * Cos(angle) - minor * Sin(theta - angle_increment) * Sin(angle)
            T1y = eRecortar.P[0].y + major * Cos(theta - angle_increment) * Sin(angle) + minor * Sin(theta - angle_increment) * Cos(angle)

            T2x = eRecortar.P[0].x + major * Cos(theta) * Cos(angle) - minor * Sin(theta) * Sin(angle)
            T2y = eRecortar.P[0].y + major * Cos(theta) * Sin(angle) + minor * Sin(theta) * Cos(angle)

        Else
            ' el punto considerando 0,0 al centro
            T1x = eRecortar.P[0].x + eRecortar.fParam[0] * Cos(theta - angle_increment)
            T1y = eRecortar.P[0].y + eRecortar.fParam[0] * Sin(theta - angle_increment)

            T2x = eRecortar.P[0].x + eRecortar.fParam[0] * Cos(theta)
            T2y = eRecortar.P[0].y + eRecortar.fParam[0] * Sin(theta)

        End If

        For Each eTijera In Tijeras
            Select Case eTijera.Gender
                Case "LINE"
                    If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[0].x, eTijera.P[0].y, eTijera.P[1].x, eTijera.P[1].y) Then

                        If theta > C1 And theta <= AngCorte Then C1 = theta
                        If theta < C2 And theta > AngCorte Then C2 = theta

                    Endif
                Case "LWPOLYLINE"

                    For i = 0 To eTijera.P.Count - 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.P[i].x, eTijera.P[i].y, eTijera.P[i + 1].x, eTijera.P[i + 1].y) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta

                        Endif

                    Next

                Case "Text", "MText"

                    For i = 0 To eTijera.Polygon.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polygon[i + 0], eTijera.polygon[i + 1], eTijera.polygon[i + 2], eTijera.polygon[i + 3]) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta
                        Endif

                    Next
                Case "ARC", "ELLIPSE", "CIRCLE"

                    For i = 0 To eTijera.polyline.count - 4 Step 2         ' Idem linea, pero  para todos los tramos de la polilinea

                        If puntos.doIntersect(T1x, T1y, T2x, T2y, eTijera.polyline[i + 0], eTijera.polyline[i + 1], eTijera.polyline[i + 2], eTijera.polyline[i + 3]) Then

                            If theta > C1 And theta <= AngCorte Then C1 = theta
                            If theta < C2 And theta > AngCorte Then C2 = theta

                        Endif

                    Next
            End Select
        Next
    Next
    ' termine la busqueda de puntos de recorte
    ' ahora recorto la entidad
    ' primer o determino si debo partir la entidad o si solo se recorta

    ' vuelvo a GRADOS
    c1 *= 180 / Pi
    c2 *= 180 / Pi
    AngCorte *= 180 / Pi

    If (eRecortar.fParam[1] = C1) And (eRecortar.fParam[2] = C2) Then
        ' esta entidad no sera recortada

    Else If (eRecortar.fParam[1] = C1) And (AngCorte < C2) Then ' elimino el tramo P01 - C2

        eRecortar.fParam[1] = C2

    Else If (eRecortar.fParam[2] = C2) And (AngCorte > C1) Then ' elimino el tramo p23 - C1

        eRecortar.fParam[2] = C1

    Else ' se parte en dos la entidad

        eNewPart = clsEntities.ClonEntity(eRecortar)          ' primero la clono

        eNewPart.fParam[1] = C2

        gcd.Drawing.Sheet.Entities.Add(eNewPart, eNewPart.Id)                ' la agrego al dibujo

        eRecortar.fParam[2] = C1

    End If
    gcd.Regen

End
