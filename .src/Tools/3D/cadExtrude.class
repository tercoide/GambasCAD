' Gambas class file

Inherits ToolsBase
Create Static
Public Const Gender As String = "EXTRUDE"
Public Const Is3D As Boolean = True
Public Distance As Float
Public normal As Punto3d
Public e As Entity
Public f1 As Face
'' cadSelection o algun otro proceso nos devuelve el control

Public Function Start(Optional ElemToBuild As Variant, _mode As Integer = 0) As Boolean

    Me.PointsDone = 0
    Me.PointsTotal = 1
    Me.mode = _mode
    glx.VBOCurrent = Me.VBO

    Run

End

Public Sub Run()

    If gcd.Drawing.Sheet.EntitiesSelected.Count = 0 Then                                     ' we have no elements in the selection

        Me.Prompt = ("Select face")

        gcd.clsJobCallBack = Me
        gcd.clsJob = cadSelection

        cadSelection.ReturnOnFirstSelection = True

    Else

        ' voy calculando la normal
        e = gcd.Drawing.Sheet.EntitiesSelected[gcd.Drawing.Sheet.EntitiesSelected.First]
        f1 = e.faces[0]           ' TODO: por ahora funcionara para una mesh

        normal = puntos.CalcularNormalNewell(puntos.VertexToPunto3D(f1.vertex))                             ' need the first point

        'DrawingAids.CmdLineHelper = DrawingAids.CmdLineHelper & ": " & ("Base point")
        Me.Prompt = Str(gcd.Drawing.Sheet.EntitiesSelected.Count) & " " & ("elements") & "-> " & ("Distance")

        Me.NextParamType = "L"

        Me.PointsDone = 1

        gcd.SnapMode = gcd.SnapModeSaved                 ' vuelvo al Snap Guardado

        clsEntities.GLGenDrawListSel()                     ' genero drawing lists
        'clsEntities.GLGenDrawListAll(True)

        ' gcd.Drawing.uUndo.OpenUndoStage("Move entities", Undo.TypeModify)
        ' For Each E In gcd.Drawing.EntitiesSelected
        '     gcd.Drawing.uUndo.AddUndoItem(clsEntities.ClonEntity(E, False))
        ' Next
        gcd.Redraw

    Endif

End

Public Sub NewParameter(tipo As String, vValor As Variant, Optional definitive As Boolean = False) As Variant

    Dim distancia As Float
    Dim f2 As New Face
    Dim fRect As New Face
    Dim p, p2 As Vertex
    Dim i, i2 As Integer

    Select Case LCase(tipo)
        Case "text"

            ' extruimos una distancia
            ' 1-creamos nuevos puntos en la misma posicion del contorno
            ' 2-copiamos la cara a extruir? si es Mesh, si...y si no?
            ' 3-usamos la rutina del paralelepipedo para "subir" la cara en direccion al vector perpendicular

            ' Necesito el vector perpendicular normalizado, que ya saque al seleccionar
            ' y la distancia:
            Try distancia = Val(vValor)
            If distancia = 0 Then Return ' y error TODO:

            ' primero replicamos los puntos de la cara a la altura indicada

            For Each p In f1.vertex
                'p2 = gcd.NewVertex(pcg2.x + (p.x - pCG.x) * fx, pCG2.y + (p.y - pCG.y) * fy, pCG2.z + (p.z - pCG.z) * fz)
                p2 = gcd.NewVertex(p.x + distancia * normal.x, p.y + distancia * normal.y, p.z + distancia * normal.z)
                f2.vertex.Add(p2)
            Next

            e.faces.Add(f2)                                       ' Agregamos la tapa

            ' ahora creamos las caras rectangulares
            For i = 0 To f1.vertex.Max
                i2 = i + 1
                If i2 = f1.vertex.Count Then i2 = 0
                fRect = New Face

                fRect.vertex.Add(f1.vertex[i])
                fRect.vertex.Add(f1.vertex[i2])
                fRect.vertex.Add(f2.vertex[i2])
                fRect.vertex.Add(f2.vertex[i])
                e.faces.Add(fRect)

            Next
            If definitive Then

                Me.Finish()

            End If

            If Trim(LCase(vvalor)) = "_cancel" Then Me.Cancel
    End Select

End
