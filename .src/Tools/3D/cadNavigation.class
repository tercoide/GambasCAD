' Gambas class file

Inherits CadSelection

Public Const Gender As String = "NAVIGATION"

Public Sub MouseMove()
    ' debo transformar la cara 3D en puntos 2D segun la proyeccion

    Dim x, y As Integer
    Dim n As Integer
    Dim p0, p1, p2, hit As Punto3D
    Dim e1x, e1y, e1z As Float
    Dim e2x, e2y, e2z As Float
    Dim nx, ny, nz As Float
    Dim ndotd As Float
    Dim t As Float
    Dim wx, wy, wz As Float
    Dim hx, hy, hz As Float
    Dim i As Integer
    Dim axis As Integer
    Dim fPoly2D As New Float[]
    Dim hp2x, hp2y As Float

    Dim ray As New Float[3]                             ' es un rayo que atraviesa la pantalla en la posicion del mouse

    ray = gcd.Drawing.Sheet.camera.Get3DpointFromScreen(Mouse.x, Mouse.y, 0)

    Dim rayO, rayD As New Punto3d
    rayO.x = ray[0]
    rayO.y = ray[1]
    rayO.z = ray[2]               ' ??

    ray = gcd.Drawing.Sheet.camera.Get3DpointFromScreen(Mouse.x, Mouse.y, 1)

    rayD.x = ray[0] - rayO.x
    rayD.y = ray[1] - rayO.y
    rayD.z = ray[2] - rayO.z

    ' Dim inside As Boolean
    ' inside = puntos.RayPolygonIntersection3D(origen, direccion, puntos.VertexToPunto3D(e.pBlock.faces[0].vertex), hit)
    ' If inside Then
    '     Debug hit.x, hit.y, hit.z
    ' Endif
    ' 'inside = puntos.RayConcavePolygonIntersect(origen, gcd.Drawing.Sheet.camera.ViewDir, e.pBlock.vertex, rDist)
    ' Return inside

    If fMain.KeyControl Then

        ' Intersect ray with plane
        ndotd = 1 * rayD.x + 0 * rayD.y + 0 * rayD.z
        If Abs(ndotd) <= puntos.NumericTolerance Then
            ' Ray parallel to plane (including contained case)
            Stop
        Endif

        wx = -rayO.x
        wy = -rayO.y
        wz = -rayO.z

        t = (1 * wx + 0 * wy + 0 * wz) / ndotd
        If t < 0 Then Stop 'Return [0, 0, 0, 0, -1]

        ' 3D hit point
        hx = rayO.x + t * rayD.x  ' =0 ???
        hy = rayO.y + t * rayD.y
        hz = rayO.z + t * rayD.z

        Me.VBO.Clear
        glx.BeginVBO(Me.VBO)

        glx.DrawLines3D([hx, hy, hz, hx, 0, hz], Color.red)
        glx.DrawLines3D([hx, hy, hz, hx, hy, 0], Color.blue)

        glx.EndVBO()

    End If

End

Public Sub Draw()

    Me.VBO.Draw()
    Me.VBO.HoveredDraw = False
    Me.VBO.SelectedDraw = False

End