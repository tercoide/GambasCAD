' Gambas class file

' Esta clase tiene el objetivo de facilitar las comunicaciones entre las demas clases
Create Static
Public Const ParamType As String = "param"     ''El tipo de parametro esperado: Punto2D, Punto3D, Longitud, Angulo, Texto, Color, Etc
Public Const Prompt As String = "prompt"     ''El texto que se ofrece al User, ej: Dibuje una linea, altura, etc
Public Const xData As String = "data"       ''Valor por defecto
Public Const NextParamType As String = "next"  ''El tipo de parametro esperado: Punto2D, Punto3D, Longitud, Angulo, Texto, Color, Etc
Public Const Description As String = "desc"     '' una descripcion de lo que se comunica
