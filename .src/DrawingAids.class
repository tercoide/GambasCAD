    If gcd.Drawing.iEntity.Count = 0 Then Return
    If gcd.Drawing.iEntity["mode"] = 0 Then Return
    If gcd.Drawing.iEntity["desc"] = "" Then Return

    ' glx.BeginVBO(TextVBO, True)
