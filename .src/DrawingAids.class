Public Sub RebuildGrid()

    Dim x0, y0, x1, y1 As Float
    Dim espaciado As Float
    Dim x, y As Float

    x0 = gcd.Near(gcd.Xreal(0))
    Y0 = gcd.Near(gcd.Yreal(0))
    x1 = gcd.Near(gcd.Xreal(fmain.GLArea1.W))
    y1 = gcd.Near(gcd.Yreal(fmain.GLArea1.h))

    espaciado = gcd.Drawing.GridMinorSpacing

    Do
        If gcd.Pixels(espaciado) < 5 Then espaciado *= 10
    Loop Until Abs(gcd.Pixels(espaciado)) > 5

    GridVBO = New VBO
    glx.BeginVBO(GridVBO)
    Select Case gcd.Drawing.GridStyle
        Case 0 ' puntos

            Dim fpoints As New Float[]

            For y = y1 To y0 Step espaciado
                For x = x0 To x1 Step espaciado
                    fpoints.add(x)
                    fpoints.add(y)
                Next
            Next

            glx.Drawpoints(fpoints, Config.WhiteAndBlack)

        Case 1 ' cuadricula

            For y = y1 To y0 Step espaciado
                glx.DrawLines([x0, y, x1, y], Color.Gray, 1)
            Next

            For x = x0 To x1 Step espaciado
                glx.DrawLines([x, y0, x, y1], Color.Gray, 1)
            Next

    End Select

    gcd.Drawing.GridCurentSpacing = espaciado

    glx.EndVBO()

    ' aprovecho para recomponer las lineas de puntos

End

Public Sub RebuildGrid3D(s3d As Sheet, Optional XY As Boolean = True, XZ As Boolean = True, YZ As Boolean = True, Axis As Boolean = False)

    Dim x0, y0, x1, y1 As Float
    Dim espaciado As Float
    Dim x, y As Float

    ' x0 = gcd.Near(gcd.Xreal(0))
    ' Y0 = gcd.Near(gcd.Yreal(0))
    ' x1 = gcd.Near(gcd.Xreal(fmain.GLArea1.W))
    ' y1 = gcd.Near(gcd.Yreal(fmain.GLArea1.h))

    x0 = -100
    Y0 = -100
    x1 = 100
    y1 = 100

    espaciado = 5 'gcd.Drawing.GridMinorSpacing

    ' Do
    '     If gcd.Pixels(espaciado) < 5 Then espaciado *= 10
    ' Loop Until Abs(gcd.Pixels(espaciado)) > 5

    glx.BeginVBO(s3d.Grid3dVbo, True)
    Select Case gcd.Drawing.GridStyle
        Case 0 ' puntos

            Dim fpoints As New Float[]

            If xy Then
                ' Plano XY Z=0
                For y = y0 To y1 Step espaciado
                    For x = x0 To x1 Step espaciado
                        fpoints.add(x)
                        fpoints.add(y)
                        fpoints.Add(0)
                    Next
                Next

                glx.Drawpoints3d(fpoints, Color.red)
            End If

            fpoints.Clear
            If xz Then
                ' Plano XZ Y=0
                For y = y0 To y1 Step espaciado
                    If y = 0 Then Continue
                    For x = x0 To x1 Step espaciado
                        If x = 0 Then Continue
                        fpoints.add(x)
                        fpoints.add(0)
                        fpoints.Add(y)
                    Next
                Next

                glx.Drawpoints3d(fpoints, Color.green)

            End If

            fpoints.Clear
            If YZ Then
                ' Plano YZ X=0
                For y = y0 To y1 Step espaciado
                    For x = x0 To x1 Step espaciado
                        fpoints.add(0)
                        fpoints.add(y)
                        fpoints.Add(x)
                    Next
                Next

                glx.Drawpoints3d(fpoints, Color.blue)
            End If

            If Axis Then
                glx.DrawLines3D([-100, 0, 0, 100, 0, 0], Color.Red)
                glx.DrawLines3D([0, -100, 0, 0, 100, 0], Color.Green)
                glx.DrawLines3D([0, 0, -100, 0, 0, 100], Color.blue)

            Endif

        Case 1 ' cuadricula

            For y = y1 To y0 Step espaciado
                glx.DrawLines([x0, y, x1, y], Color.Gray, 1)
            Next

            For x = x0 To x1 Step espaciado
                glx.DrawLines([x, y0, x, y1], Color.Gray, 1)
            Next

    End Select

    gcd.Drawing.GridCurentSpacing = espaciado

    glx.EndVBO()

    ' aprovecho para recomponer las lineas de puntos

End

