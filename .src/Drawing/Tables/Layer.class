' Gambas class file

Public Const Gender As String = "LAYER"
Public Colour As Integer = 0
Public LineType As LineType' String = "CONTINUOUS"
Public Name As String = ""
Public LineWt As Integer = -3
Public id As String
Public Visible As Boolean = True
Public Frozen As Boolean = False
Public Locked As Boolean = False
Public Printable As Boolean = True
Public Hidden As Boolean = False                ' Esta propiedad no puede ser modificada por el user
Public glList As Integer
Public ShowWireframe As Boolean = True
Public ShowTexture As Boolean = False
Public ShowMode As Integer
Public Shader As Integer = 0
Public flgForDeletion As Boolean
Public flgForRegen As Boolean

' Variables utiles para automatizar procesos de edicion genralizados
Public _NoShow As String[] = ["gllist", "flgForDeletion", "flgForRegen"]
Public _ReadOnly As String[] = ["id"]
Public _EditWith As Collection = ["colour": fColors, "linetype": "linetypes"]

' nuevos VBO y Shaders

'Public VBO As New VBO
Public VBO As New VBO

'' Datos para el archivo JSON nativo (ver JsonFile)
Public Function ExportJson() As Collection

    Dim j As Collection

    j = JsonFile.ObjectToJson(Me,, ["glList", "flgForDeletion", "flgForRegen"])
    If Me.LineType Then j["LineType"] = Me.LineType.Name
    Return j

End

Public Sub ImportJson(c As Collection, drw As Drawing)

    JsonFile.JsonToObject(Me, c,, ["glList", "flgForDeletion", "flgForRegen"])
    If drw.LineTypes.Exist(c["LineType"]) Then
        Me.LineType = drw.LineTypes[c["LineType"]]
    Else
        Me.LineType = drw.LineTypes[drw.LineTypes.First]
    Endif

End
