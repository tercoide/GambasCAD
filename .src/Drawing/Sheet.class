Public Grips As New Grip[]

Public vertex As New Collection  ' xyz triplets de cada vertice

Property Plane2D As Integer
Private $plane2d As Integer

Public Sub _new()

    Me.Plane2D = Planes.YZ'Config.Plane2D

End

Private Function Plane2D_Read() As Integer

    Return $plane2d

End

Private Sub Plane2D_Write(Value As Integer)

    If value < 0 Or value > 2 Then Return
    $plane2d = Value
    Select Case $Plane2D
        Case Planes.XY      ' plano X+Y+
            Me.RotX = 0                                                         'X horizontal
            Me.RotY = 0                                                         'Y up
            Me.RotZ = 0                                                         'Z level
        Case Planes.XZ
            Me.RotX = 90                                                        'X horizontal
            Me.RotY = 0                                                         'Y level
            Me.RotZ = 0                                                         'Z- up
        Case Planes.YZ
            Me.RotX = 0                                                         'X level
            Me.RotY = -90                                                       'Y  is Up
            Me.RotZ = 0                                                         'Z- is Horizontal
    End Select
    glx.Plane2D = $plane2d

End
