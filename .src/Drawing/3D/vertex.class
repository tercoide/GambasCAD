' Gambas class file

Public IsBridge As Boolean
Public IsUsed As Boolean

Property XYZ As Float[]

Property pPunto3D As Punto3d


Public X As Float
Public Y As Float
Public Z As Float

Public Sub _new(Optional x As Float, y As Float, z As Float)

    Me.x = x
    Me.y = y
    Me.z = z

End

Private Function XYZ_Read() As Float[]

    Return [Me.x, Me.y, Me.z]

End

Private Sub XYZ_Write(Value As Float[])

    Me.x = value[0]
    Me.y = value[1]
    Me.z = value[2]

End


Private Function pPunto3D_Read() As Punto3d

    
    Return New Punto3d(Me.X, Me.Y, Me.z)

End

Private Sub pPunto3D_Write(Value As Punto3d)

    Me.X = value.x
    Me.y = value.y
    Me.z = value.z

End
