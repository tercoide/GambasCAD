' Gambas class file

' Esta clase representa una cara 3D originada por un poligono cerrado.
' Un cuerpo voluminoso puede tener muchas caras como esta.

Public Const name As String = "FACE"
Public Id As String
Public vertex As New Vertex[]       ' references for the Drawing collection of vertices
Public normals As New Float[]       ' las normales de la cara, para usar en iluminacion
Public UVs As New Single[]          ' las coordenadas de textura
Public wireframe As New Vertex[]    ' 1 por tramo

Public Function GetPlane() As Plane

    Dim pl As New Plane

    If vertex.Count = 0 Then Return Null
    pl.Point = vertex[0].pPunto3D
    pl.Normal = puntos.CalcularNormalNewell(Me.ToPuntos3D())
    If pl.Normal Then Return pl Else Return Null

End

Public Function ToPuntos3D() As Punto3d[]

    Dim pp As New Punto3d[]
    Dim v As Vertex

    For Each v In vertex
        pp.Add(v.pPunto3D)
    Next
    Return pp

End
