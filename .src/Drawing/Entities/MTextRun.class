'' Un tramo de texto de un MTEXT con su formato.
'' cadMText.ParseRuns los arma leyendo los codigos en linea, y ProcessText3 los acomoda en renglones.

Public Const KindText As Integer = 0
Public Const KindStack As Integer = 1       '' fraccion \S
Public Const KindParagraph As Integer = 2   '' fin de parrafo \P

Public Kind As Integer
Public Text As String
Public Height As Float
Public Font As String
Public Bold As Boolean
Public Italic As Boolean
Public Oblique As Float                     '' grados (\Q)
Public WidthFactor As Float = 1             '' \W
Public Tracking As Float = 1                '' \T
Public Underline As Boolean                 '' \L
Public Overline As Boolean                  '' \O
Public Strike As Boolean                    '' \K
Public VAlign As Integer                    '' \A 0 = abajo, 1 = centro, 2 = arriba

' propiedades del parrafo (\p), en alturas de texto
Public ParAlign As Integer = -1             '' -1 = segun el punto de insercion, 0 = izq, 1 = centro, 2 = der, 3 = justificado
Public IndentFirst As Float
Public IndentLeft As Float
Public IndentRight As Float

' fraccion
Public StackTop As String
Public StackBottom As String
Public StackType As String                  '' "/", "#" o "^"

' calculado al armar los renglones
Public Width As Float

Public Function Copy() As MTextRun

    Dim r As New MTextRun

    r.Kind = Kind
    r.Text = Text
    r.Height = Height
    r.Font = Font
    r.Bold = Bold
    r.Italic = Italic
    r.Oblique = Oblique
    r.WidthFactor = WidthFactor
    r.Tracking = Tracking
    r.Underline = Underline
    r.Overline = Overline
    r.Strike = Strike
    r.VAlign = VAlign
    r.ParAlign = ParAlign
    r.IndentFirst = IndentFirst
    r.IndentLeft = IndentLeft
    r.IndentRight = IndentRight
    r.StackTop = StackTop
    r.StackBottom = StackBottom
    r.StackType = StackType
    r.Width = Width

    Return r

End

'' Es un tramo que solo tiene espacios
Public Function IsSpace() As Boolean

    If InStr(Text, Chr$(3)) Then Return False       ' el cursor del editor (cadMText.CaretMark) no es un espacio
    Return Kind = KindText And Trim(Text) = ""

End
