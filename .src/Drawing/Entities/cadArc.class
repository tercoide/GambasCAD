Create Static
Inherits EntityBase
Public Const Gender As String = "ARC"
Public Const PointsToDraw As Integer = 2             ' minimal point requered for drawing something usefull
Public Const CmdLineHelper As String = ("Draws an arc: center")
Public Const ParamType As String = "point3d"
Public Const ParamHelper As String = "center"      ' a little text that is shown at the prompt waiting for user input during build
Public Const ParamDefault As String = "0,0;1;0;90"
' Public start As Float
' Public recorrido As Float
' Public anticlockwise As Boolean = True
Public Const TotalParams As Integer = 3
Public Const iTotalParams As Integer = 1
Public Const iiiAnticlockwise As Integer = 0
Public Const Regenerable As Boolean = True

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If Me.ExpectedParam = "center" Then

        If vParam[0] <> "point3d" Then Return False

        Try eBuild.P[0].x = vParam[1]
        Try eBuild.P[0].y = vParam[2]
        Try eBuild.P[0].z = vParam[3]

        If Definitive Then
            eBuild.fParam.Add(0)
            Me.ExpectedParam = "radius"
            Return ["next": "lenght", "prompt": "enter radius"]
        End If
    Else If Me.ExpectedParam = "radius" Then   ' radio

        If vParam[0] <> "float" Then Return False

        eBuild.fParam[0] = vParam[1]
        eBuild.fParam[1] = 0
        eBuild.fParam[2] = 360

        If Definitive Then

            'DrawingAIds.Helper.texto = Format$(ebuild.fParam[1], "0.0 deg") & (" to ") & Format$(ebuild.fParam[2], "0.0 deg")
            Me.makepolyline(eBuild)
            Me.ExpectedParam = "start"
            Return ["next": "angle", "prompt": "start angle"]
        End If
    Else If Me.ExpectedParam = "start" Then ' recibimos el angulo inicial

        If vParam[0] <> "float" Then Return False

        eBuild.fParam[1] = vParam[1]
        glx.DrawLines([ebuild.P[0].x, ebuild.P[0].y, ebuild.P[0].x + ebuild.fParam[0] * Cos(ebuild.fParam[1] / 180 * Pi), ebuild.P[0].y + ebuild.fParam[0] * Sin(ebuild.fParam[1] / 180 * Pi)], gcd.GetGBColor(ebuild.Colour, ebuild.pLayer))
        DrawingAIds.Helper.texto = Format$(ebuild.fParam[1], "0.0 deg")
        Me.makepolyline(ebuild)
        If Definitive Then
            Me.ExpectedParam = "end"
            Return ["next": "angle", "prompt": "end angle"]
        End If

    Else If Me.ExpectedParam = "end" Then   ' angulo final

        If vParam[0] <> "float" Then Return False

        eBuild.fParam[2] = vParam[1]

        If Definitive Then Return ["command": "end"]

    Else
        Return False
    End If

End

Public Sub Stretch(e As Entity, dX As Float, dY As Float)

End

Public Sub Rotate(e As Entity, radians As Float)

    puntos.RotateP(e.P, radians)

    ' el parametro lo tengo que pasar a grados porque la rutina que dibuja el texto usa eso
    E.fParam[1] += Deg(radians)
    E.fParam[2] += Deg(radians)

End

Public Sub Scale(e As Entity, sX As Float, sY As Float, Optional sZ As Float = 1)

    E.fParam[0] *= Abs(sX)

    puntos.ScaleP(e.P, sx, sy, sz)

    ' start/end
    If sx < 0 Then
        E.fParam[1] = 180 - E.fParam[1]
        E.fParam[2] = 180 - E.fParam[2]

        Swap E.fParam[1], E.fParam[2]

    Endif

    If sy < 0 Then
        E.fParam[1] = 360 - E.fParam[1]
        E.fParam[2] = 360 - E.fParam[2]

        Swap E.fParam[1], E.fParam[2]

    Endif

End

Public Sub makepolyline(oe As Entity)

    Dim x, y, theta, fRadio, fStart, fEnd, angle_increment As Float
    Dim iTramos As Integer
    Dim PolyAux As New Float[]
    Dim LargoPixels, LargoReal As Float

    fRadio = oE.fParam[0]
    fStart = Rad(oE.fParam[1])
    fEnd = Rad(oe.fParam[2])

    If fStart < 0 Then fStart += 2 * Pi
    If fend < 0 Then fEnd += 2 * Pi

    If fStart = fEnd Then Return
    If fRadio = 0 Then Return

    If fEnd < fStart Then fEnd += 2 * Pi

    ' veo el cuantos pixels tendria cada tramo
    LargoReal = fRadio * Abs(fEnd - fStart)
    LargoPixels = gcd.Pixels(LargoReal) ' > 0

    ' si quiero tramos de 10 pixels como maximo...
    iTramos = fRadio * Abs(fEnd - fStart) / gcd.metros(Config.ArcDensity)

    If iTramos < 6 Then iTramos = 18
    If iTramos > 360 Then iTramos = 360
    angle_increment = (fEnd - fStart) / iTramos
    'If angle_increment < Pi / 36 Then angle_increment = Pi / 36

    oE.polyline.Clear
    If oe.iParam[0] = 0 Then
        For theta = fStart To fEnd Step angle_increment

            ' el punto considerando 0,0 al centro
            x = fRadio * Cos(theta)
            y = fRadio * Sin(theta)
            PolyAux.Add(x)
            PolyAux.Add(y)

        Next

        x = fRadio * Cos(fEnd)
        y = fRadio * Sin(fEnd)
    Else

        For theta = fStart To fEnd Step angle_increment
            ' el punto considerando 0,0 al centro
            x = fRadio * Cos(theta)
            y = -fRadio * Sin(theta)
            PolyAux.Add(x)
            PolyAux.Add(y)

        Next

        x = fRadio * Cos(fEnd)
        y = -fRadio * Sin(fEnd)

    End If
    PolyAux.Add(x)
    PolyAux.Add(y)

    Dim pp As Punto3D
    'centro3 = oe.P[0].Copy()
    For iTramos = 0 To PolyAux.Max Step 2
        pp = puntos.LocalToGlobal(oe.P[0], gcd.Drawing.Sheet.LastNormal, PolyAux[iTramos], PolyAux[iTramos + 1])
        If pp Then oe.polyline.insert([pp.x, pp.y, pp.z])
    Next

    oe.Extrusion.Insert(gcd.Drawing.Sheet.LastNormal.ToXYZ())

End

Public Sub Draw(oE As Entity)

    If Not oE.Visible Then Return

    glx.PolyLines(oe.PolyLine, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

Public Sub DrawSelected(oE As Entity)

    glx.PolyLines(oE.PolyLine, Color.Darker(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

'' A fat version of the entity
Public Sub DrawRemark(oE As Entity)

    'glx.PolyLines(oE.PolyLine, Config.ColorForRemark, gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oE.LineType.TrameLength)
    glx.PolyLines(oE.PolyLine, Gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oE.LineType.TrameLength)

End

Public Function Draw2(oE As Entity)

    Dim fStart, fEnd As Float

    fStart = Rad(oE.fParam[1])
    fEnd = Rad(oe.fParam[2])
    If fEnd < fStart Then fEnd += 2 * Pi

    paint.ARC(oE.P[0].x, oE.P[0].y, oE.fParam[0], fStart, (fEnd - fStart))

    paint.Stroke

End

Public Function SaveDxfData(e As Entity) As Boolean

    ' stxExport.insert(["ARC", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCodeInv("AcDbCircle", "100")
    dxf.SaveCodeInv(CStr(e.P[0].x), dxf.codCenterX)
    dxf.SaveCodeInv(CStr(e.P[0].y), dxf.codCenterY)
    dxf.SaveCodeInv(CStr(e.fParam[0]), dxf.codRadius)
    dxf.SaveCodeInv("AcDbArc", "100")
    dxf.SaveCodeInv(CStr(e.fParam[1]), dxf.codAngleStart)
    dxf.SaveCodeInv(CStr(e.fParam[2]), dxf.codAngleEnd)
    If e.Extrusion[2] <> 1 Then
        dxf.SaveCodeInv(CStr(e.Extrusion[0]), "210")
        dxf.SaveCodeInv(CStr(e.Extrusion[1]), "220")
        dxf.SaveCodeInv(CStr(e.Extrusion[2]), "230")
    Endif

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i As Integer
    Dim flxP As New Float[]

    'If e.id = "17047" Then Stop

    For i = 0 To sClaves.Max
        If sClaves[i] = "10" Then flxP.Add(CFloat(sValues[i]))
        If sClaves[i] = "20" Then flxP.Add(CFloat(sValues[i]))
        If sClaves[i] = "40" Then e.fParam[0] = (CFloat(sValues[i]))
        If sClaves[i] = "50" Then e.fParam[1] = (CFloat(sValues[i]))
        If sClaves[i] = "51" Then e.fParam[2] = (CFloat(sValues[i]))

    Next
    e.P = puntos.FromXY(flxP)

    If e.fParam.Count = 0 Then Stop ' e.fParam.Add(0)  ' TODO: averiguar q pasa aca q algunas entidades CIRCLE
    ' vienen sin el radio

    Return True

    ' catch

    Return False

End

'' Return if that position is over the entity within the tolerance
Fast Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    Dim angle, a1, a2 As Float

    If puntos.Around(xr, yr, E.P[0].x, E.P[0].y, tolerance) Then Return True
    a1 = E.fParam[1]
    a2 = E.fParam[2]
    If a1 < 0 Then a1 += 360
    If a2 < 0 Then a2 += 360

    If Abs(puntos.distancia(xr, yr, E.P[0].x, E.P[0].y) - E.fParam[0]) < tolerance Then

        ' tengo que ver si esa en la porcion
        angle = Deg(Ang(xr - E.P[0].x, yr - E.P[0].y))
        If angle < 0 Then angle += 360

        If a1 <= a2 Then
            If angle >= a1 And angle <= a2 Then Return True
        Else
            If angle >= a1 Or angle <= a2 Then Return True
        End If

    End If

    Return False

End
