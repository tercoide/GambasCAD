' Gambas class file

Inherits CadMesh
Public Const Gender As String = "PARALLELEPIPED"
Public Const CmdLineHelper As String = ("a parallelepiped from a polyface base: Height vector:")
Public Const ParamType As String = "vec3"
Public Const ParamHelper As String = "height"      ' a little text that is shown at the prompt waiting for user input during build

Public zLevel As Float = 0

' Public Function NewEntity(Optional fPoints As Float[], bNewid As Boolean = False) As Entity
'
