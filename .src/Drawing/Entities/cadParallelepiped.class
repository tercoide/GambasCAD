' End

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim ok As Variant

    ok = Super.NewParameter(eBuild, vParam, definitive)

    'If Not ok Then Return

    If Me.ExpectedParam = "height" Then
        If vParam[0] = "vec3" Then
            If Definitive Then

                eBuild.fParam.Clear
                eBuild.fParam.Add(vParam[1])        'X
                eBuild.fParam.Add(vParam[2])        'Y
                eBuild.fParam.Add(vParam[3])        'Z

                zLevel = vParam[1]
                ok = New Communications
                Me.ExpectedParam = "base"
                ok.ParamType = "float"
                ok.Prompt = "Base factor"

                Return ok
            End If
        End If
    End If

    If Me.ExpectedParam = "base" Then
        If vParam[0] = "float" Then
            If Definitive Then

                eBuild.fParam.Add(vParam[1])        'base1/base2 factor: 1=equal 0=base2 is a point
                ok = New Communications
                Me.ExpectedParam = "point"
                ok.ParamType = "point3d"
                ok.Prompt = "Base points"

                Return ok
            End If
        End If
    End If

    Return ok

End

' This function will return False if the element couldn't be created for some reason: bad or incomple user input
' True means all is good, False will instruct the clsENTITYBUILDER to delete it

Public Sub Finish(oe As Entity) As Boolean

    Dim f As Face

    For Each f In oe.pBlock.faces
        gcd.Drawing.Sheet.Faces.Add(f, f.Id)

    Next

End

' '' Builds the geometry of the entity wthout drwing it
Public Function MakePolyLine(E As Entity)

    Dim iCaras As Integer
    Dim i As Integer
    Dim f1, f2, fRect As Face
    Dim p, p2 As Punto3d

    Dim pPolygon As Punto3d[]
    Dim i2 As Integer

    If e.fParam.Count < 4 Then Return
    If e.pBlock.faces.count = 0 Then Return

    f1 = e.pBlock.faces[0]
    If f1.Id = "" Then Return  ' la base no esta terminada
    Dim pCG, pCG2 As New Punto3d
    pCG = puntos.CenterGravity3dP(f1.vertex)                    ' obtengo el centro de la forma
    pCG2.x = pcg.x + e.fParam[0]                                ' el CG de la otra tapa, dezplazado
    pCG2.y = pcg.y + e.fParam[1]
    pCG2.z = pcg.z + e.fParam[2]

    Dim factor As Float = e.fParam[3]
    Dim fx, fy, fz As Float
    ' el factor de reduccion se aplica a los ejes 2D, pero no al eje que define la altura del paraleleppipedo

    ' necesito saber en que plano estamos trabajando
    If glx.Plane2D = Planes.XZ Then
        fx = factor
        fy = 1
        fz = factor
    Else If glx.Plane2D = Planes.XY Then
        fx = factor
        fy = factor
        fz = 1
    Else If glx.Plane2D = Planes.YZ Then
        fx = 1
        fy = factor
        fz = factor
    Endif
    ' primero replicamos los puntos de la cara a la altura indicada
    f2 = New Face
    f2.colour = e.Colour
    For Each p In f1.vertex
        p2 = gcd.NewVertex(pcg2.x + (p.x - pCG.x) * fx, pCG2.y + (p.y - pCG.y) * fy, pCG2.z + (p.z - pCG.z) * fz)
        f2.vertex.Add(p2)
    Next

    e.pBlock.faces.Add(f2)                                       ' Agregamos la tapa

    ' ahora creamos las caras rectangulares
    For i = 0 To f1.vertex.Max
        i2 = i + 1
        If i2 = f1.vertex.Count Then i2 = 0
        fRect = New Face
        fRect.colour = e.Colour
        fRect.vertex.Add(f1.vertex[i])
        fRect.vertex.Add(f1.vertex[i2])
        fRect.vertex.Add(f2.vertex[i2])
        fRect.vertex.Add(f2.vertex[i])
        e.pBlock.faces.Add(fRect)

    Next
    e.Generated = True
    '

End

Public Sub Draw(oE As Entity)

    Dim fPoints As Float[]
    Dim fColor4 As Integer
    Dim bIntersects As Boolean
    Dim f As Face
    Dim pTriangles As Punto3d
    Dim fTriangles As Float[]

    For Each f In oe.pBlock.faces

        clsEntities.DrawFace(f, 0, 0, oe.pLayer.ShowWireframe)

    Next

End
