' Gambas class file

' Represents a NURBS spline, fully 3D: every control point has its own x,y,z (no work plane)
' Element maintained by Terco

' The curve is evaluated with de Boor's algorithm in homogeneous coordinates (rational, uses the weights)
' https://pages.mtu.edu/~shene/COURSES/cs3621/NOTES/spline/B-spline/de-Boor.html
' https://www.codeproject.com/Articles/996281/NURBS-curve-made-easy
'
' SPline.ControlPoints, FitPoints and tangents are flat arrays with SPline.Dims values per point:
' 3 (x,y,z) for SPLINE entities, 2 (x,y) for HATCH boundaries. PolyLine comes out with the same Dims.

Create Static
Inherits EntityBase
Public Const Gender As String = "SPLINE"
Public Const PointsToDraw As Integer = 0             ' minimal point requered for drawing something usefull
Public Const CmdLineHelper As String = "SPLine : first point"
Public Const ParamType As String = "point3d"                             ' that is Point, Point, Float could be Color Text, etc
Public Const ParamHelper As String = "point3d"      ' a little text that is shown at the prompt waiting for user input during build
Public Const ParamDefault As String = "Close/Undo"
Public Const ContextMenu As String = ("Close SPLine;_CLOSE;;;Undo last point;_UNDO;;;End in last point;_END;;") ' el menu para el boton derecho, los comandos en mayusculas NO se traducen
Public Const Regenerable As Boolean = True
' otras const
Public Const TypeControls As Integer = 0
Public Const TypeTangent As Integer = 1

Public nTramos As Integer = 100

Public sp As SPline

Public Function NewEntity(Optional vPoints As Variant, bNewHandle As Boolean = False) As Entity

    Dim e As Entity

    e = Super.NewEntity(vPoints, bNewHandle)

    e.pBlock = New SPline
    e.pBlock.Dims = 3
    e.pBlock.ControlPoints.Insert([0.0, 0.0, 0.0])        ' el punto que sigue al mouse

    Return e

End

Public Sub ClonEntity(eOrigen As Entity, Optional GetNewid As Boolean = True) As Entity

    Dim e As Entity, s, bBase As SPline

    e = Super.ClonEntity(eOrigen)
    bBase = eOrigen.pBlock
    s = New SPline

    s.Dims = bBase.Dims
    s.ControlPoints.Insert(bBase.ControlPoints.copy())
    s.ControlTolerance = bBase.ControlTolerance
    s.Degree = bBase.Degree
    s.FitPoints.Insert(bBase.FitPoints.copy())
    s.FitTolerance = bBase.FitTolerance
    s.KnotTolerance = bBase.KnotTolerance
    s.KnotValues.Insert(bBase.KnotValues.copy())
    s.Periodic = bBase.Periodic
    s.Rational = bBase.Rational
    s.TangentFinal.Insert(bBase.TangentFinal.copy())
    s.TangentInitial.Insert(bBase.TangentInitial.copy())
    s.Weigths.Insert(bBase.Weigths.copy())
    e.pBlock = s
    Return e

End

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim sp As SPline
    Dim n As Integer

    sp = ebuild.pBlock
    n = sp.ControlPoints.Count / 3

    ' el ultimo punto de ControlPoints es el que sigue al mouse
    If vParam[0] = "point3d" Then

        sp.ControlPoints[sp.ControlPoints.Max - 2] = vParam[1]
        sp.ControlPoints[sp.ControlPoints.Max - 1] = vParam[2]
        If vParam.Count > 3 Then sp.ControlPoints[sp.ControlPoints.Max] = vParam[3]
        MakeKnots(sp)
        If Definitive Then
            sp.ControlPoints.Insert(sp.ControlPoints.Copy(sp.ControlPoints.Max - 2, 3))
            MakeKnots(sp)
            Return ["next": "point3d"]
        End If

    Else If vParam[1] = "_CLOSE" Then
        ' el punto del mouse pasa a ser el primero
        If n > 2 Then
            sp.ControlPoints[sp.ControlPoints.Max - 2] = sp.ControlPoints[0]
            sp.ControlPoints[sp.ControlPoints.Max - 1] = sp.ControlPoints[1]
            sp.ControlPoints[sp.ControlPoints.Max] = sp.ControlPoints[2]
        End If
        MakeKnots(sp)
        Inc gcd.StepsDone
        Return ["command": "end"]

    Else If vParam[1] = "_UNDO" Then
        If n > 2 Then
            sp.ControlPoints.Remove(sp.ControlPoints.Max - 2, 3)
            MakeKnots(sp)
        End If
        Return ["next": "point3d"]

    Else If vParam[1] = "_END" Then
        If n > 2 Then sp.ControlPoints.Remove(sp.ControlPoints.Max - 2, 3)
        MakeKnots(sp)
        Inc gcd.StepsDone
        Return ["command": "end"]

    Endif

End

'' Clamped uniform knot vector: degree + 1 zeros, evenly spaced inner knots, degree + 1 ones.
'' The curve starts at the first control point and ends at the last one.
Private Sub MakeKnots(sp As SPline)

    sp.KnotValues = UniformKnots(sp.ControlPoints.Count / sp.Dims, sp.Degree)

End

Private Function UniformKnots(n As Integer, p As Integer) As Float[]

    Dim i As Integer
    Dim k As New Float[]

    If n <= p Then Return k                 ' no alcanzan los puntos para este grado

    For i = 0 To p
        k.Add(0)
    Next
    For i = 1 To n - p - 1
        k.Add(i / (n - p))
    Next
    For i = 0 To p
        k.Add(1)
    Next

    Return k                                ' n + p + 1 nudos

End

Public Sub Translate(e As Entity, dX As Float, dY As Float, dZ As Float, Optional OnlySelected As Boolean = False)

    sp = e.pBlock

    TranslateD(sp.ControlPoints, sp.Dims, dx, dy, dz)
    TranslateD(sp.FitPoints, sp.Dims, dx, dy, dz)
    TranslateD(e.PolyLine, sp.Dims, dx, dy, dz)
    ' las tangentes son direcciones, no se trasladan

End

'' Rotates around the Z axis
Public Sub Rotate(e As Entity, radians As Float)

    sp = e.pBlock

    RotateD(sp.ControlPoints, sp.Dims, radians)
    RotateD(sp.FitPoints, sp.Dims, radians)
    RotateD(sp.TangentFinal, sp.Dims, radians)
    RotateD(sp.TangentInitial, sp.Dims, radians)
    RotateD(e.PolyLine, sp.Dims, radians)

End

Public Sub Scale(e As Entity, sX As Float, sY As Float, Optional sZ As Float = 1)

    sp = e.pBlock

    ScaleD(sp.ControlPoints, sp.Dims, sx, sy, sz)
    ScaleD(sp.FitPoints, sp.Dims, sx, sy, sz)
    ScaleD(sp.TangentFinal, sp.Dims, sx, sy, sz)
    ScaleD(sp.TangentInitial, sp.Dims, sx, sy, sz)
    ScaleD(e.PolyLine, sp.Dims, sx, sy, sz)

End

Private Sub TranslateD(a As Float[], D As Integer, dx As Float, dy As Float, dz As Float)

    Dim i As Integer

    For i = 0 To a.Count - D Step D
        a[i] += dx
        a[i + 1] += dy
        If D > 2 Then a[i + 2] += dz
    Next

End

Private Sub RotateD(a As Float[], D As Integer, radians As Float)

    Dim i As Integer
    Dim s, c, x As Float

    s = Sin(radians)
    c = Cos(radians)
    For i = 0 To a.Count - D Step D
        x = a[i] * c - a[i + 1] * s
        a[i + 1] = a[i] * s + a[i + 1] * c
        a[i] = x
    Next

End

Private Sub ScaleD(a As Float[], D As Integer, sx As Float, sy As Float, sz As Float)

    Dim i As Integer

    For i = 0 To a.Count - D Step D
        a[i] *= sx
        a[i + 1] *= sy
        If D > 2 Then a[i + 2] *= sz
    Next

End

'' x,y pairs of a flat array with D values per point (the projection on the XY plane)
Private Function ToXYD(a As Float[], D As Integer) As Float[]

    Dim i As Integer
    Dim r As New Float[]

    If D = 2 Then Return a
    For i = 0 To a.Count - D Step D
        r.Add(a[i])
        r.Add(a[i + 1])
    Next
    Return r

End

'' A fat version of the entity
Public Sub DrawSelected(oE As Entity)

    glx.PolyLines(oE.PolyLine, Gcd.ColorSelected(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

'' A fat version of the line
Public Sub DrawRemark(oE As Entity)

    If Not oE.Visible Then Return

    glx.PolyLines(oE.PolyLine, Gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oE.LineType.TrameLength)

End

Public Sub Draw2(oE As Entity)

    sp = oE.pBlock
    paintPlus.LineStripe(ToXYD(oe.PolyLine, sp.Dims))

End

Public Function SaveJsonData(e As Entity, j As Collection) As Boolean

    Super.SaveJsonData(e, j)
    j["spline"] = JsonFile.ObjectToJson(e.pBlock)
    Return True

End

Public Function ImportJson(e As Entity, c As Collection) As Boolean

    Super.ImportJson(e, c)
    sp = New SPline
    e.pBlock = sp
    JsonFile.JsonToObject(sp, c["spline"])

    ' los .gcd anteriores guardaban x,y
    If sp.Dims = 2 Then
        sp.ControlPoints = XYToXYZ(sp.ControlPoints)
        sp.FitPoints = XYToXYZ(sp.FitPoints)
        sp.TangentInitial = XYToXYZ(sp.TangentInitial)
        sp.TangentFinal = XYToXYZ(sp.TangentFinal)
        sp.Dims = 3
    End If
    Return True

End

Private Function XYToXYZ(a As Float[]) As Float[]

    Dim i As Integer
    Dim r As New Float[]

    For i = 0 To a.Count - 2 Step 2
        r.Insert([a[i], a[i + 1], 0.0])
    Next
    Return r

End

Public Function SaveDxfData(e As Entity) As Boolean

    Dim i, n As Integer
    Dim D As Integer

    sp = e.pBlock
    D = sp.Dims
    n = sp.ControlPoints.Count / D

    ' stxExport.insert(["SPLINE", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCodeInv("AcDbSpline", "100")
    If e.Extrusion[2] <> 1 Then
        dxf.SaveCodeInv(CStr(e.Extrusion[0]), "210")
        dxf.SaveCodeInv(CStr(e.Extrusion[1]), "220")
        dxf.SaveCodeInv(CStr(e.Extrusion[2]), "230")
    Endif
    dxf.SaveCodeInv(CStr(sp.Periodic), "70")
    ' 70' SPLINE flag(bit coded):
    ' 1 = Closed spline
    ' 2 = Periodic spline
    ' 4 = Rational spline
    ' 8 = Planar
    ' 16 = Linear(planar bit Is Also set)
    dxf.SaveCodeInv(CStr(sp.Degree), "71")                 ' 2 = quadrtic 3 = cubic
    dxf.SaveCodeInv(CStr(sp.KnotValues.Count), "72")
    dxf.SaveCodeInv(CStr(n), "73")
    dxf.SaveCodeInv(CStr(sp.FitPoints.Count / D), "74")
    dxf.SaveCodeInv(CStr(sp.KnotTolerance), "42")          ' 0.0000001
    dxf.SaveCodeInv(CStr(sp.ControlTolerance), "43")       ' 0.0000001
    dxf.SaveCodeInv(CStr(sp.FitTolerance), "44")           ' 0.0000000001
    For i = 0 To sp.KnotValues.max
        dxf.SaveCodeInv(CStr(sp.KnotValues[i]), "40")
    Next
    If sp.Weigths.Count = n Then
        For i = 0 To sp.Weigths.Max
            dxf.SaveCodeInv(CStr(sp.Weigths[i]), "41")
        Next
    End If
    For i = 0 To sp.ControlPoints.Count - D Step D
        dxf.SaveCodeInv(CStr(sp.ControlPoints[i]), dxf.codX0)
        dxf.SaveCodeInv(CStr(sp.ControlPoints[i + 1]), dxf.codY0)
        If D > 2 Then
            dxf.SaveCodeInv(CStr(sp.ControlPoints[i + 2]), dxf.codZ0)
        Else
            dxf.SaveCodeInv("0", dxf.codZ0)
        End If
    Next
    ' 74 dice cuantos fit points hay, asi que van tambien
    For i = 0 To sp.FitPoints.Count - D Step D
        dxf.SaveCodeInv(CStr(sp.FitPoints[i]), "11")
        dxf.SaveCodeInv(CStr(sp.FitPoints[i + 1]), "21")
        If D > 2 Then
            dxf.SaveCodeInv(CStr(sp.FitPoints[i + 2]), "31")
        Else
            dxf.SaveCodeInv("0", "31")
        End If
    Next

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i As Integer
    Dim f As Float

    sp = New SPline
    sp.Dims = 3
    e.pBlock = sp

    For i = 0 To sClaves.Max

        Select Case sClaves[i]
            Case "70"
                sp.Periodic = CInt(sValues[i])
            Case "71"
                sp.Degree = CInt(sValues[i])
            Case "42"
                sp.KnotTolerance = CFloat(sValues[i])
            Case "43"
                sp.Controltolerance = CFloat(sValues[i])
            Case "44"
                sp.FitTolerance = CFloat(sValues[i])
            Case "40"
                sp.KnotValues.Add(CFloat(sValues[i]))
            Case "41"
                sp.Weigths.Add(CFloat(sValues[i]))

                ' cada punto empieza con su X, Y y Z lo completan (Z puede faltar)
            Case "10"
                sp.ControlPoints.Insert([CFloat(sValues[i]), 0.0, 0.0])
            Case "20"
                sp.ControlPoints[sp.ControlPoints.Max - 1] = CFloat(sValues[i])
            Case "30"
                sp.ControlPoints[sp.ControlPoints.Max] = CFloat(sValues[i])

                ' Estos Fitting points no se usan en la construccion, se guardan para reescribirlos
            Case "11"
                sp.FitPoints.Insert([CFloat(sValues[i]), 0.0, 0.0])
            Case "21"
                sp.FitPoints[sp.FitPoints.Max - 1] = CFloat(sValues[i])
            Case "31"
                sp.FitPoints[sp.FitPoints.Max] = CFloat(sValues[i])

                ' tangentes, no se usan
            Case "12"
                sp.TangentInitial.Insert([CFloat(sValues[i]), 0.0, 0.0])
            Case "22"
                sp.TangentInitial[sp.TangentInitial.Max - 1] = CFloat(sValues[i])
            Case "32"
                sp.TangentInitial[sp.TangentInitial.Max] = CFloat(sValues[i])
            Case "13"
                sp.TangentFinal.Insert([CFloat(sValues[i]), 0.0, 0.0])
            Case "23"
                sp.TangentFinal[sp.TangentFinal.Max - 1] = CFloat(sValues[i])
            Case "33"
                sp.TangentFinal[sp.TangentFinal.Max] = CFloat(sValues[i])
        End Select

    Next

    If sp.ControlPoints.Count < 3 Then Return False

    e.P.Clear
    e.P.Add(puntos.P3d(sp.ControlPoints[0], sp.ControlPoints[1], sp.ControlPoints[2]))
    e.P.Add(puntos.P3d(sp.ControlPoints[sp.ControlPoints.Max - 2], sp.ControlPoints[sp.ControlPoints.Max - 1], sp.ControlPoints[sp.ControlPoints.Max]))

    Return True

End

'' Builds the PolyLine (Dims values per point) evaluating the curve
Public Sub makepolyline(oe As Entity)

    Dim i, j, n, p, D As Integer
    Dim t, t0, t1, fLen, dd As Float
    Dim aKnots, aWeights As Float[]

    sp = oe.pBlock
    D = sp.Dims
    oe.PolyLine.Clear

    n = sp.ControlPoints.Count / D
    If n < 2 Then Return

    p = sp.Degree
    If p < 1 Then p = 1

    ' con menos puntos que grado + 1 no hay curva: se dibuja el poligono de control
    If n <= p Then
        oe.PolyLine.Insert(sp.ControlPoints.Copy())
        Return
    End If

    aKnots = sp.KnotValues
    If aKnots.Count <> n + p + 1 Then aKnots = UniformKnots(n, p)

    If sp.Weigths.Count = n Then aWeights = sp.Weigths

    ' tramos segun el largo del poligono de control en 3D
    For i = 0 To sp.ControlPoints.Count - 2 * D Step D
        dd = 0
        For j = 0 To D - 1
            dd += (sp.ControlPoints[i + D + j] - sp.ControlPoints[i + j]) ^ 2
        Next
        fLen += Sqr(dd)
    Next

    nTramos = fLen / gcd.metros(Config.ArcDensity)
    If nTramos < 24 Then nTramos = 24
    If nTramos > 240 Then nTramos = 240

    ' la curva esta definida entre los nudos p y n
    t0 = aKnots[p]
    t1 = aKnots[n]

    For i = 0 To nTramos
        t = t0 + (t1 - t0) * i / nTramos
        oe.PolyLine.Insert(DeBoor(t, p, D, sp.ControlPoints, aKnots, aWeights))
    Next

End

'' Point of the curve at parameter t (de Boor). Points has D values per control point.
'' Weights may be Null (all 1). Returns D values.
Private Function DeBoor(t As Float, p As Integer, D As Integer, Points As Float[], Knots As Float[], Weights As Float[]) As Float[]

    Dim n, k, i, j, r, iPoint As Integer
    Dim w, alpha, den As Float
    Dim v As New Float[]          ' p + 1 puntos homogeneos de D + 1 valores: x*w, y*w, z*w, w
    Dim res As New Float[]
    Dim D1 As Integer = D + 1

    n = Points.Count / D

    ' tramo k: Knots[k] <= t < Knots[k + 1], con p <= k <= n - 1
    If t >= Knots[n] Then
        k = n - 1
        While k > p And Knots[k] >= Knots[n]      ' nudos repetidos al final
            Dec k
        Wend
    Else
        k = p
        While k < n - 1 And Knots[k + 1] <= t
            Inc k
        Wend
    End If

    ' los p + 1 puntos de control que afectan a este tramo
    v.Resize((p + 1) * D1)
    For j = 0 To p
        iPoint = j + k - p
        If Weights Then w = Weights[iPoint] Else w = 1
        For i = 0 To D - 1
            v[j * D1 + i] = Points[iPoint * D + i] * w
        Next
        v[j * D1 + D] = w
    Next

    For r = 1 To p
        For j = p DownTo r
            den = Knots[j + 1 + k - r] - Knots[j + k - p]
            If den = 0 Then
                alpha = 0
            Else
                alpha = (t - Knots[j + k - p]) / den
            End If
            For i = 0 To D
                v[j * D1 + i] = (1 - alpha) * v[(j - 1) * D1 + i] + alpha * v[j * D1 + i]
            Next
        Next
    Next

    ' de homogeneas a cartesianas
    w = v[p * D1 + D]
    If w = 0 Then w = 1
    For i = 0 To D - 1
        res.Add(v[p * D1 + i] / w)
    Next

    Return res

End

Public Sub Draw(oE As Entity)

    Me.makepolyline(oe)

    glx.PolyLines(oe.PolyLine, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

'' Bounding rectangle in XY of the curve
Public Sub Limits(e As Entity)

    Dim fLim As Float[]

    sp = e.pBlock
    If e.PolyLine.Count = 0 Then Me.makepolyline(e)
    If e.PolyLine.Count = 0 Then Return

    If sp.Dims = 3 Then
        fLim = puntos.Limits3d(e.PolyLine)
        e.Limits[0] = fLim[0]
        e.Limits[1] = fLim[1]
        e.Limits[2] = fLim[3]
        e.Limits[3] = fLim[4]
    Else
        fLim = puntos.Limits(e.PolyLine)
        e.Limits[0] = fLim[0]
        e.Limits[1] = fLim[1]
        e.Limits[2] = fLim[2]
        e.Limits[3] = fLim[3]
    End If

End

'' Return if that position is over the entity within the tolerance (XY projection)
Fast Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    Dim i As Integer
    Dim a As Float[]

    sp = e.pBlock
    a = ToXYD(e.PolyLine, sp.Dims)

    For i = 0 To a.Count - 4 Step 2
        If puntos.doIntersect(Xr - tolerance, Yr, Xr + tolerance, Yr, a[i], a[i + 1], a[i + 2], a[i + 3]) Or puntos.doIntersect(Xr, Yr - tolerance, Xr, Yr + tolerance, a[i], a[i + 1], a[i + 2], a[i + 3]) Then Return True
    Next

    Return False

End

' La seleccion es sobre la proyeccion XY de la curva
Public Function SelFull(eTesting As Entity, X1real As Float, Y1real As Float, X2real As Float, Y2real As Float) As Boolean

    sp = eTesting.pBlock
    Return puntos.IsPoligonInsideRect(ToXYD(eTesting.PolyLine, sp.Dims), X1real, Y1real, X2real, Y2real)

End

Public Function SelPartial(eTesting As Entity, X1real As Float, Y1real As Float, X2real As Float, Y2real As Float, Optional MarkPoints As Boolean = True) As Boolean

    Dim a As Float[]

    sp = eTesting.pBlock
    a = ToXYD(eTesting.PolyLine, sp.Dims)
    If puntos.IsPoligonInsideRect(a, X1real, Y1real, X2real, Y2real) Then Return True
    Return puntos.IsPoligonCrossingRect(a, X1real, Y1real, X2real, Y2real)

End

Public Function SelFullPoly(eTesting As Entity, Poly As Float[]) As Boolean

    sp = eTesting.pBlock
    Return puntos.isInsIdePolygons(ToXYD(eTesting.PolyLine, sp.Dims), Poly)

End

Public Function SelPartialPoly(eTesting As Entity, Poly As Float[]) As Boolean

    Dim i As Integer
    Dim a As Float[]

    sp = eTesting.pBlock
    a = ToXYD(eTesting.PolyLine, sp.Dims)
    For i = 0 To a.Count - 2 Step 2
        If puntos.isInsIde(Poly, a[i], a[i + 1]) Then Return True
    Next
    Return False

End

'' Genera un conjunto de grips para ser usados por cadSelection
Public Function GenerateGrips(e As Entity) As Integer

    Dim i As Integer
    Dim g As Grip, s As SPline
    Dim iCount As Integer

    s = e.pBlock

    For i = 0 To s.ControlPoints.Count - s.Dims Step s.Dims
        g = New Grip
        g.Shape = 0
        g.X = s.ControlPoints[i]
        g.Y = s.ControlPoints[i + 1]
        g.Action = 0 ' mover
        g.AsociatedEntity = e
        g.AsociatedPoint = iCount
        gcd.Drawing.Sheet.Grips.Add(g)
        g.ToolTip = ("Move control point")
        Inc iCount
    Next

    Return iCount

End

'' Moves the control point in X and Y, its Z stays
Public Function GripEdit(g As Grip) As Boolean

    Dim e As Entity, s As SPline

    e = g.AsociatedEntity
    s = e.pBlock
    s.ControlPoints[g.AsociatedPoint * s.Dims] = g.X
    s.ControlPoints[g.AsociatedPoint * s.Dims + 1] = g.y

End
