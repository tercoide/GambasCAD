End

'' Builds the geometry of the entity wthout drwing it
Public Sub makepolyline(oe As Entity)

    Dim d, fAng As Float

    cadMText.SetupMText(oe)

    If oe.Gender = "MTEXT" And If oe.P.Count > 1 Then
        d = puntos.distancia(oe.P[0].x, oe.P[0].y, oe.P[1].x, oe.P[1].y)
        If cadMText.Mode(oe) = ModeFit And d > 1e-9 Then
            ' Fit: mido sin caja y estiro el ancho de las letras para llenar de P0 a P1
            cadMText.TrimText = False
            cadMText.CurrentTextBoxWidth = 0
            cadMText.ProcessText3(oe)
            If cadMText.LastBoxWidth > 0 Then cadMText.CurrentTextRelScaleX *= d / cadMText.LastBoxWidth
        Endif
        cadMText.ProcessText3(oe)

        ' sin caja, si el punto 2 quedo encima del 1 lo pongo al final del texto
        If cadMText.Mode(oe) = ModeFree And d < 1e-9 Then
            fAng = oe.fParam[Me.ipaTextAngle]
            d = Max(cadMText.LastBoxWidth, cadMText.CurrentTextHeigth)
            oe.P[1].x = oe.P[0].x + d * Cos(fAng)
            oe.P[1].y = oe.P[0].y + d * Sin(fAng)
        Endif
        Return
    Endif

    cadMText.ProcessText3(oe)

End

'' Modo del MTEXT de dos puntos: ModeBox, ModeFree o ModeFit
Public Function Mode(e As Entity) As Integer

    If e.Gender <> "MTEXT" Then Return ModeBox
    Return CInt(e.fParam[Me.ipaHorizJustif])

End

'' Columna (0 izq, 1 centro, 2 der) y fila (0 arriba, 1 medio, 2 abajo) del punto de insercion
Public Function AttachCol(e As Entity) As Integer

    Dim i As Integer

    i = CInt(e.fParam[Me.ipaAttchmPoint])
    If i < 1 Or i > 9 Then i = 1
    Return (i - 1) Mod 3

End

Public Function AttachRow(e As Entity) As Integer

    Dim i As Integer

    i = CInt(e.fParam[Me.ipaAttchmPoint])
    If i < 1 Or i > 9 Then i = 1
    Return (i - 1) \ 3

End

Public Sub SetAttach(e As Entity, iRow As Integer, iCol As Integer)

    e.fParam[Me.ipaAttchmPoint] = iRow * 3 + iCol + 1

End

'' MTEXT de un solo punto (el de insercion, como viene del DXF): armo los dos puntos con el ancho y el angulo
Public Sub MakeTwoPoints(e As Entity)

    Dim fW, fAng, c, s As Float
    Dim iCol As Integer
    Dim p1 As Punto3d

    fW = e.fParam[Me.ipaRectangleWIdth]
    fAng = e.fParam[Me.ipaTextAngle]
    c = Cos(fAng)
    s = Sin(fAng)
    iCol = AttachCol(e)
    If fW > 0 Then
        e.fParam[Me.ipaHorizJustif] = ModeBox
        p1 = puntos.P3d(e.P[0].x - fW * iCol / 2 * c, e.P[0].y - fW * iCol / 2 * s, e.P[0].z)
    Else
        e.fParam[Me.ipaHorizJustif] = ModeFree       ' el punto 2 lo ubica makepolyline al final del texto
        p1 = e.P[0].Copy()
    Endif
    e.P[0] = p1
    e.P.Add(puntos.P3d(p1.x + fW * c, p1.y + fW * s, p1.z))

End

'' Angulo y ancho de la caja salen de los dos puntos
Public Sub SyncFields(e As Entity)

    Dim d As Float

    d = puntos.distancia(e.P[0].x, e.P[0].y, e.P[1].x, e.P[1].y)
    If d > 1e-9 Then e.fParam[Me.ipaTextAngle] = Ang(e.P[1].x - e.P[0].x, e.P[1].y - e.P[0].y)
    If Mode(e) = ModeFree Then
        e.fParam[Me.ipaRectangleWIdth] = 0
    Else
        e.fParam[Me.ipaRectangleWIdth] = d
    Endif

End

'' El punto de insercion del DXF: en la caja depende de la columna; sin caja y en Fit es el punto 1
Public Function InsertionOf(e As Entity) As Punto3d

    Dim iCol As Integer

    If e.Gender <> "MTEXT" Or e.P.Count < 2 Then Return e.P[0]
    If Mode(e) <> ModeBox Then Return e.P[0]
    iCol = AttachCol(e)
    Return puntos.P3d(e.P[0].x + (e.P[1].x - e.P[0].x) * iCol / 2, e.P[0].y + (e.P[1].y - e.P[0].y) * iCol / 2, e.P[0].z)

End

'' Carga las variables del motor de texto con los datos de un MTEXT
Public Sub SetupMText(oe As Entity)

    Dim iAttach As Integer
    Dim pIns As Punto3d

    If oe.Gender = "MTEXT" Then
        If oe.P.Count < 2 Then MakeTwoPoints(oe)
        SyncFields(oe)
    Endif
    pIns = InsertionOf(oe)
    OriginalTextPosX = pIns.x
    OriginalTextPosY = pIns.y
    CurrentTextHeigth = oE.fParam[Me.ipaTextHeight]
    If CurrentTextHeigth <= 0 Then CurrentTextHeigth = 1
    CurrentTextBoxWidth = oE.fParam[Me.ipaRectangleWidth]
    TrimText = CurrentTextBoxWidth > 0          ' sin ancho de caja no se corta en renglones (como en AutoCAD)
    CurrentTextRelScaleX = 1
    CurrentTextItalic = 0
    PlainText = False

    ' 1 2 3 arriba, 4 5 6 medio, 7 8 9 abajo; izq, centro, der
    iAttach = CInt(oe.fParam[Me.ipaAttchmPoint])
    If iAttach < 1 Or iAttach > 9 Then iAttach = 1
    CurrentTextAlignment = (iAttach - 1) Mod 3
    CurrentTextAlignmentVertical = (iAttach - 1) \ 3
    If Mode(oe) = ModeFit Then CurrentTextAlignment = 0       ' Fit va de P0 a P1

    CurrentTextAngle = Deg(oE.fParam[Me.ipaTextAngle])

    oe.pStyle = gcd.Drawing.TextStyles[oE.sParam[Me.sdaStyle]]
    If Not oe.pStyle Then oe.pStyle = gcd.Drawing.CurrTextStyle
    CurrentTextFont = StyleFont(oe.pStyle, "romans")

End

'' Fuente de dibujo de un estilo de texto
Public Function StyleFont(oStyle As TextStyle, sDefault As String) As String

    If Not oStyle Then Return sDefault
    Return ResolveFont(oStyle.sFont_3, sDefault)

End

'' Las fuentes que no tengo (TTF, SHX raras) se reemplazan por sDefault
Public Function ResolveFont(sFont As String, sDefault As String) As String

    sFont = Lower(Utils.FileWithoutExtension(Trim(sFont)))
    If sFont <> "" And If gcd.FontReplacements.Exist(sFont) Then Return gcd.FontReplacements[sFont]
    Return sDefault

End

'' Pone el formato general de la barra superior alrededor de todo el texto: {\fFuente|b1|i0;\K...\k}
'' (asi lo guarda AutoCAD; la altura y el color son de la entidad)
Public Function WrapFormat(sBody As String, sFont As String, bBold As Boolean, bItalic As Boolean, bStrike As Boolean) As String

    Dim s As String

    If sFont = "" And Not bBold And Not bItalic And Not bStrike Then Return sBody

    s = "{"
    If sFont <> "" Or bBold Or bItalic Then s &= "\\f" & sFont & "|b" & IIf(bBold, "1", "0") & "|i" & IIf(bItalic, "1", "0") & ";"
    If bStrike Then s &= "\\K"
    s &= sBody
    If bStrike Then s &= "\\k"
    Return s & "}"

End

'' Separa el formato general que pone WrapFormat.
'' Devuelve "body", "font", "bold", "italic" y "strike"; si el texto no lo tiene, body es todo el texto.
Public Function UnwrapFormat(sText As String) As Collection

    Dim cRet As New Collection
    Dim aParts As String[]
    Dim s As String
    Dim i, p, iDepth As Integer
    Dim bFound As Boolean

    cRet["body"] = sText
    cRet["font"] = ""
    cRet["bold"] = False
    cRet["italic"] = False
    cRet["strike"] = False

    If Left$(sText, 1) <> "{" Or Right$(sText, 1) <> "}" Then Return cRet

    ' la llave del principio tiene que ser la que cierra al final
    i = 1
    While i <= Len(sText)
        Select Case Mid$(sText, i, 1)
            Case "\\"
                Inc i               ' salteo el caracter escapado
            Case "{"
                Inc iDepth
            Case "}"
                Dec iDepth
                If iDepth = 0 And i < Len(sText) Then Return cRet
        End Select
        Inc i
    Wend

    s = Mid$(sText, 2, Len(sText) - 2)
    If Left$(s, 2) = "\\f" Then
        p = InStr(s, ";")
        If p = 0 Then Return cRet
        aParts = Split(Mid$(s, 3, p - 3), "|")
        cRet["font"] = aParts[0]
        For i = 1 To aParts.Max
            If aParts[i] = "b1" Then cRet["bold"] = True
            If aParts[i] = "i1" Then cRet["italic"] = True
        Next
        s = Mid$(s, p + 1)
        bFound = True
    Endif
    If Left$(s, 2) = "\\K" And Right$(s, 2) = "\\k" Then
        cRet["strike"] = True
        s = Mid$(s, 3, Len(s) - 4)
        bFound = True
    Endif
    If bFound Then cRet["body"] = s
    Return cRet

End

'' Arma el texto: lee los codigos, corta los renglones, alinea, gira y lo lleva al punto de insercion.
'' Usa las variables cargadas por SetupMText (o por cadText.SetMtextVars).
Public Sub ProcessText3(oe As Entity)

    Dim aRuns As MTextRun[]
    Dim aPieces As New MTextRun[]
    Dim r, rPar As MTextRun
    Dim aParEnd As New Integer[]
    Dim aLineFrom, aLineTo, aLinePar As New Integer[]
    Dim aLineWidth, aLineH, aBase As New Float[]
    Dim aLineFirst, aLineLast As New Boolean[]
    Dim i, j, iLine, iSpaces, iAlign As Integer
    Dim fW, fH, fAvail, fBoxW, fLeft, fX, fExtra, fIndL, fIndR, dy, fTotal, fBottom As Float
    Dim fAng, c, s As Float
    Dim bFirst As Boolean

    $flxAll.Clear
    CaretFound = False

    aRuns = ParseRuns(oe.sParam[Me.sdaText], PlainText)

    ' parto los tramos en palabras y espacios si tengo que cortar renglones
    For Each r In aRuns
        If TrimText And r.Kind = MTextRun.KindText Then
            SplitWords(r, aPieces)
        Else
            aPieces.Add(r)
        Endif
    Next

    For Each r In aPieces
        MeasureRun(r)
    Next

    ' cada parte sabe donde termina su parrafo, que tiene las sangrias y la alineacion
    aParEnd.Resize(aPieces.Count)
    j = aPieces.Max
    For i = aPieces.Max To 0 Step -1
        If aPieces[i].Kind = MTextRun.KindParagraph Then j = i
        aParEnd[i] = j
    Next

    ' renglones
    j = 0           ' primera parte del renglon
    fW = 0
    bFirst = True
    For i = 0 To aPieces.Max
        r = aPieces[i]
        If r.Kind = MTextRun.KindParagraph Then
            aLineFrom.Add(j)
            aLineTo.Add(i - 1)
            aLinePar.Add(i)
            aLineFirst.Add(bFirst)
            aLineLast.Add(True)
            j = i + 1
            fW = 0
            bFirst = True
            Continue
        Endif

        If fW = 0 And Not bFirst And r.IsSpace() Then   ' un renglon cortado no empieza con espacios
            r.Text = ""
            r.Width = 0
            Continue
        Endif

        If TrimText And fW > 0 And Not r.IsSpace() Then
            rPar = aPieces[aParEnd[i]]
            fAvail = CurrentTextBoxWidth - (rPar.IndentLeft + rPar.IndentRight + IIf(bFirst, rPar.IndentFirst, 0)) * CurrentTextHeigth
            If fW + r.Width > fAvail Then
                aLineFrom.Add(j)
                aLineTo.Add(i - 1)
                aLinePar.Add(aParEnd[i])
                aLineFirst.Add(bFirst)
                aLineLast.Add(False)
                j = i
                fW = 0
                bFirst = False
            Endif
        Endif
        fW += r.Width
    Next

    ' ancho y alto de cada renglon, sin los espacios del final
    For iLine = 0 To aLineFrom.Max
        j = aLineTo[iLine]
        While j >= aLineFrom[iLine]
            If Not aPieces[j].IsSpace() Then Break
            Dec j
        Wend
        aLineTo[iLine] = j
        fW = 0
        fH = 0
        For i = aLineFrom[iLine] To j
            fW += aPieces[i].Width
            If aPieces[i].Height > fH Then fH = aPieces[i].Height
        Next
        If fH = 0 Then fH = aPieces[aLinePar[iLine]].Height     ' renglon vacio
        aLineWidth.Add(fW)
        aLineH.Add(fH)
        If iLine = 0 Then
            aBase.Add(-fH)
        Else
            aBase.Add(aBase[iLine - 1] - fH * LineSpacingFactor)
        Endif
    Next
    fTotal = -aBase[aBase.Max]
    fBottom = fTotal + aLineH[aLineH.Max] / 3        ' con las colas de las letras

    ' la caja
    If TrimText Then
        fBoxW = CurrentTextBoxWidth
    Else
        fBoxW = 0
        For iLine = 0 To aLineFrom.Max
            rPar = aPieces[aLinePar[iLine]]
            fW = aLineWidth[iLine] + (rPar.IndentLeft + rPar.IndentRight + IIf(aLineFirst[iLine], rPar.IndentFirst, 0)) * CurrentTextHeigth
            If fW > fBoxW Then fBoxW = fW
        Next
    Endif
    LastBoxWidth = fBoxW
    fLeft = -fBoxW * CurrentTextAlignment / 2

    Select Case CurrentTextAlignmentVertical
        Case 0      ' arriba
            dy = 0
        Case 1      ' medio
            dy = fTotal / 2
        Case 2      ' abajo (linea base del ultimo renglon)
            dy = fTotal
        Case 3      ' linea base (TEXT)
            dy = aLineH[0]
        Case 4      ' abajo de las colas (TEXT)
            dy = fBottom
    End Select

    ' dibujo los renglones
    For iLine = 0 To aLineFrom.Max
        rPar = aPieces[aLinePar[iLine]]
        iAlign = rPar.ParAlign
        If iAlign < 0 Then iAlign = CurrentTextAlignment
        fIndL = (rPar.IndentLeft + IIf(aLineFirst[iLine], rPar.IndentFirst, 0)) * CurrentTextHeigth
        fIndR = rPar.IndentRight * CurrentTextHeigth
        fAvail = fBoxW - fIndL - fIndR
        fX = fLeft + fIndL
        fExtra = 0
        Select Case iAlign
            Case 1
                fX += (fAvail - aLineWidth[iLine]) / 2
            Case 2
                fX += fAvail - aLineWidth[iLine]
            Case 3      ' justificado, menos el ultimo renglon del parrafo
                If Not aLineLast[iLine] Then
                    iSpaces = 0
                    For i = aLineFrom[iLine] To aLineTo[iLine]
                        If aPieces[i].IsSpace() And aPieces[i].Width > 0 Then Inc iSpaces
                    Next
                    If iSpaces > 0 Then fExtra = (fAvail - aLineWidth[iLine]) / iSpaces
                Endif
        End Select

        If iLine = 0 Then
            TextOriginX = fX
            TextOriginY = aBase[0] + dy
            LastLineWidth = aLineWidth[0]
        Endif

        For i = aLineFrom[iLine] To aLineTo[iLine]
            r = aPieces[i]
            DrawRun(r, fX, aBase[iLine] + dy, aLineH[iLine])
            fX += r.Width
            If fExtra > 0 And r.IsSpace() And r.Width > 0 Then fX += fExtra
        Next
    Next
    LastTextHeight = fTotal

    ' giro y llevo al punto de insercion
    fAng = Rad(CurrentTextAngle)
    c = Cos(fAng)
    s = Sin(fAng)
    puntos.Rotate($flxAll, fAng)
    puntos.Translate($flxAll, OriginalTextPosX, OriginalTextPosY)

    fX = TextOriginX
    TextOriginX = OriginalTextPosX + fX * c - TextOriginY * s
    TextOriginY = OriginalTextPosY + fX * s + TextOriginY * c

    If CaretFound Then          ' el cursor tambien se gira y se lleva al punto de insercion
        fX = CaretX0
        fW = CaretY0
        CaretX0 = OriginalTextPosX + fX * c - fW * s
        CaretY0 = OriginalTextPosY + fX * s + fW * c
        fX = CaretX1
        fW = CaretY1
        CaretX1 = OriginalTextPosX + fX * c - fW * s
        CaretY1 = OriginalTextPosY + fX * s + fW * c
    Endif

    ' el poligono que lo rodea, para seleccionarlo
    If fBoxW = 0 Then fBoxW = CurrentTextHeigth
    oe.Polygon.Clear
    oE.Polygon.Insert([fLeft, dy, fLeft, dy - fBottom, fLeft + fBoxW, dy - fBottom, fLeft + fBoxW, dy, fLeft, dy])
    puntos.Rotate(oe.Polygon, fAng)
    puntos.Translate(oe.Polygon, OriginalTextPosX, OriginalTextPosY)

    oe.PolyLine.Clear
    oe.PolyLine.Insert($flxAll)
    $flxAll.Clear

End

'' Lee los codigos en linea del MTEXT y devuelve los tramos con su formato.
'' Siempre termina con un tramo de fin de parrafo. Plain = TEXT, que solo tiene codigos %%.
'' https://ezdxf.readthedocs.io/en/stable/dxfentities/mtext.html
Public Function ParseRuns(sText As String, Optional Plain As Boolean = False) As MTextRun[]

    Dim aRuns As New MTextRun[]
    Dim aSaved As New MTextRun[]
    Dim st, r As MTextRun
    Dim c, sCode, sArg As String
    Dim i, p, iLen As Integer

    st = New MTextRun
    st.Height = CurrentTextHeigth
    st.Font = CurrentTextFont
    st.WidthFactor = CurrentTextRelScaleX
    st.Oblique = CurrentTextItalic
    $sRunBuf = ""

    iLen = Len(sText)
    i = 1
    While i <= iLen
        c = Mid$(sText, i, 1)

        If c = "%" And Mid$(sText, i + 1, 1) = "%" Then       ' codigos de control %%
            sCode = LCase(Mid$(sText, i + 2, 1))
            i += 3
            Select Case sCode
                Case "d"
                    $sRunBuf &= String.Chr(176)                 ' grados
                Case "p"
                    $sRunBuf &= String.Chr(177)                 ' mas/menos
                Case "c"
                    $sRunBuf &= String.Chr(&H2205)              ' diametro
                Case "%"
                    $sRunBuf &= "%"
                Case "u", "o", "k"
                    FlushRun(aRuns, st)
                    If sCode = "u" Then st.Underline = Not st.Underline
                    If sCode = "o" Then st.Overline = Not st.Overline
                    If sCode = "k" Then st.Strike = Not st.Strike
                Case Else
                    If IsDigit(sCode) Then                      ' %%nnn = caracter por su codigo
                        p = i
                        While p < i + 2 And IsDigit(Mid$(sText, p, 1))
                            Inc p
                        Wend
                        Try $sRunBuf &= String.Chr(CInt(Mid$(sText, i - 1, p - i + 1)))
                        i = p
                    Else
                        $sRunBuf &= "%%" & sCode
                    Endif
            End Select

        Else If c = "\\" And Not Plain Then
            sCode = Mid$(sText, i + 1, 1)
            Select Case sCode
                Case "P", "X", "N"                              ' nuevo parrafo (X: en cotas, N: columna)
                    FlushRun(aRuns, st)
                    r = st.Copy()
                    r.Kind = MTextRun.KindParagraph
                    aRuns.Add(r)
                    i += 2
                Case "~"
                    $sRunBuf &= Chr$(1)                         ' espacio que no corta el renglon
                    i += 2
                Case "\\", "{", "}"
                    $sRunBuf &= sCode
                    i += 2
                Case "L", "l", "O", "o", "K", "k"
                    FlushRun(aRuns, st)
                    If sCode = "L" Then st.Underline = True
                    If sCode = "l" Then st.Underline = False
                    If sCode = "O" Then st.Overline = True
                    If sCode = "o" Then st.Overline = False
                    If sCode = "K" Then st.Strike = True
                    If sCode = "k" Then st.Strike = False
                    i += 2
                Case "U"                                        ' \U+00B0
                    If Mid$(sText, i + 2, 1) = "+" Then
                        Try $sRunBuf &= String.Chr(Val("&H" & Mid$(sText, i + 3, 4) & "&"))
                        i += 7
                    Else
                        i += 2
                    Endif
                Case "M"                                        ' \M+nXXXX multibyte, no lo soporto
                    i += 8
                Case Else                                       ' codigos con valor, terminan en ;
                    p = InStr(sText, ";", i + 2)
                    If p = 0 Then
                        i += 2
                        Continue
                    Endif
                    sArg = Mid$(sText, i + 2, p - i - 2)
                    i = p + 1
                    FlushRun(aRuns, st)
                    Select Case sCode
                        Case "H"
                            st.Height = RelValue(sArg, st.Height)
                        Case "W"
                            st.WidthFactor = RelValue(sArg, st.WidthFactor)
                        Case "T"
                            st.Tracking = RelValue(sArg, st.Tracking)
                        Case "Q"
                            st.Oblique = ToFloat(sArg, 0)
                        Case "A"
                            st.VAlign = CInt(ToFloat(sArg, 0))
                            ' \C y \c (colores) no se usan: todo el texto va del color de la entidad
                        Case "f", "F"
                            ParseFont(sArg, st)
                        Case "p"
                            ParseParagraph(sArg, st)
                        Case "S"
                            aRuns.Add(MakeStack(sArg, st))
                    End Select
            End Select

        Else If c = "{" And Not Plain Then
            FlushRun(aRuns, st)
            aSaved.Add(st.Copy())
            Inc i

        Else If c = "}" And Not Plain Then
            FlushRun(aRuns, st)
            If aSaved.Count > 0 Then st = aSaved.Pop()
            Inc i

        Else If c = "\t" Then
            $sRunBuf &= "    "
            Inc i

        Else If c = "^" And Mid$(sText, i + 1, 1) = "I" Then  ' tab en notacion caret
            $sRunBuf &= "    "
            i += 2

        Else If c = "\n" Then
            FlushRun(aRuns, st)
            r = st.Copy()
            r.Kind = MTextRun.KindParagraph
            aRuns.Add(r)
            Inc i

        Else If c = "\r" Then
            Inc i

        Else
            $sRunBuf &= c
            Inc i
        Endif
    Wend

    FlushRun(aRuns, st)
    r = st.Copy()
    r.Kind = MTextRun.KindParagraph
    aRuns.Add(r)

    Return aRuns

End

Private Sub FlushRun(aRuns As MTextRun[], st As MTextRun)

    Dim r As MTextRun

    If $sRunBuf = "" Then Return
    r = st.Copy()
    r.Kind = MTextRun.KindText
    r.Text = $sRunBuf
    aRuns.Add(r)
    $sRunBuf = ""

End

'' Valor de un codigo: "2" absoluto, "0.5x" relativo al actual
Private Function RelValue(sArg As String, fCurrent As Float) As Float

    Dim f As Float

    If LCase(Right$(sArg, 1)) = "x" Then
        f = ToFloat(Left$(sArg, -1), 1) * fCurrent
    Else
        f = ToFloat(sArg, fCurrent)
    Endif
    If f <= 0 Then Return fCurrent
    Return f

End

Private Function ToFloat(sValue As String, fDefault As Float) As Float

    Dim f As Float

    Try f = CFloat(Trim(sValue))
    If Error Then Return fDefault
    Return f

End

'' \fArial|b1|i0|c0|p34;  o  \Fromans;
Private Sub ParseFont(sArg As String, st As MTextRun)

    Dim aParts As String[]
    Dim i As Integer

    aParts = Split(sArg, "|")
    If aParts.Count = 0 Then Return
    st.Font = ResolveFont(aParts[0], CurrentTextFont)
    For i = 1 To aParts.Max
        Select Case Left$(aParts[i], 1)
            Case "b"
                st.Bold = Mid$(aParts[i], 2) = "1"
            Case "i"
                st.Italic = Mid$(aParts[i], 2) = "1"
        End Select
    Next

End

'' \pxqc;  \pi-3,l3,t3;  \pxql,i1,l2;  (las sangrias van en alturas de texto)
Private Sub ParseParagraph(sArg As String, st As MTextRun)

    Dim s As String

    For Each s In Split(sArg, ",")
        If Left$(s, 1) = "x" Then s = Mid$(s, 2)
        Select Case Left$(s, 1)
            Case "q"
                Select Case Mid$(s, 2, 1)
                    Case "l"
                        st.ParAlign = 0
                    Case "c"
                        st.ParAlign = 1
                    Case "r"
                        st.ParAlign = 2
                    Case "j", "d"
                        st.ParAlign = 3
                    Case Else
                        st.ParAlign = -1
                End Select
            Case "i"
                st.IndentFirst = ToFloat(Mid$(s, 2), 0)
            Case "l"
                st.IndentLeft = ToFloat(Mid$(s, 2), 0)
            Case "r"
                st.IndentRight = ToFloat(Mid$(s, 2), 0)
        End Select
    Next

End

'' \S1/2;  \S1#4;  \S+0.1^ -0.2;
Private Function MakeStack(sArg As String, st As MTextRun) As MTextRun

    Dim r As MTextRun
    Dim i As Integer
    Dim c As String

    r = st.Copy()
    r.Kind = MTextRun.KindStack
    r.Text = ""
    r.StackType = "^"
    r.StackTop = sArg
    r.StackBottom = ""

    i = 1
    While i <= Len(sArg)
        c = Mid$(sArg, i, 1)
        If c = "\\" Then                        ' caracter escapado
            i += 2
            Continue
        Endif
        If c = "^" Or c = "/" Or c = "#" Then
            r.StackType = c
            r.StackTop = Unescape(Left$(sArg, i - 1))
            r.StackBottom = Unescape(Mid$(sArg, i + 1))
            If c = "^" And Left$(r.StackBottom, 1) = " " Then r.StackBottom = Mid$(r.StackBottom, 2)
            Break
        Endif
        Inc i
    Wend

    Return r

End

Private Function Unescape(s As String) As String

    s = Replace(s, "\\/", "/")
    s = Replace(s, "\\#", "#")
    s = Replace(s, "\\^", "^")
    Return s

End

'' Parte un tramo en palabras y espacios para poder cortar renglones
Private Sub SplitWords(r As MTextRun, aPieces As MTextRun[])

    Dim rPart As MTextRun
    Dim i As Integer
    Dim c, sPart As String
    Dim bSpace As Boolean

    For i = 1 To Len(r.Text)
        c = Mid$(r.Text, i, 1)
        If sPart <> "" And (c = " ") <> bSpace Then
            rPart = r.Copy()
            rPart.Text = sPart
            aPieces.Add(rPart)
            sPart = ""
        Endif
        bSpace = c = " "
        sPart &= c
    Next
    If sPart <> "" Then
        rPart = r.Copy()
        rPart.Text = sPart
        aPieces.Add(rPart)
    Endif

End

Private Sub MeasureRun(r As MTextRun)

    Dim hs, wTop, wBottom As Float

    r.Width = 0
    If r.Kind = MTextRun.KindParagraph Then Return

    glx.SelectFont(r.Font)
    If r.Kind = MTextRun.KindText Then
        r.Width = glx.TextAdvance(Replace(r.Text, Chr$(1), " "), r.Height, r.WidthFactor, r.Tracking)
        If r.Bold And Not r.IsSpace() Then r.Width += r.Height * BoldOffset
    Else
        hs = r.Height * StackScale
        wTop = glx.TextAdvance(r.StackTop, hs, r.WidthFactor, r.Tracking)
        wBottom = glx.TextAdvance(r.StackBottom, hs, r.WidthFactor, r.Tracking)
        If r.StackType = "#" Then
            r.Width = wTop + wBottom + r.Height * 0.5
        Else
            r.Width = Max(wTop, wBottom) + r.Height * 0.1
        Endif
    Endif

End

Private Function RunOblique(r As MTextRun) As Float

    If r.Italic Then Return r.Oblique + 15
    Return r.Oblique

End

'' Genera la geometria de un tramo con su linea base en fBase
Private Sub DrawRun(r As MTextRun, fX As Float, fBase As Float, fLineH As Float)

    Dim fY, h, hs, wTop, wBottom, fW As Float
    Dim sText As String

    h = r.Height
    fY = fBase
    If h < fLineH Then                          ' \A: tramos mas chicos que el renglon
        If r.VAlign = 1 Then fY += (fLineH - h) / 2
        If r.VAlign = 2 Then fY += fLineH - h
    Endif

    glx.SelectFont(r.Font)

    If r.Kind = MTextRun.KindText Then
        sText = Replace(r.Text, Chr$(1), " ")
        If InStr(sText, Chr$(3)) Then           ' aca esta el cursor del editor (coordenadas locales, antes del giro)
            CaretFound = True
            CaretX0 = fX + glx.TextAdvance(Left$(sText, InStr(sText, Chr$(3)) - 1), h, r.WidthFactor, r.Tracking)
            CaretY0 = fY - h * 0.25
            CaretX1 = CaretX0
            CaretY1 = fY + h * 1.1
        Endif
        If Trim(sText) <> "" Then AddGlyphs(glx.DrawTextPoly(sText, h, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX, fY, r)

    Else If r.Kind = MTextRun.KindStack Then
        hs = h * StackScale
        wTop = glx.TextAdvance(r.StackTop, hs, r.WidthFactor, r.Tracking)
        wBottom = glx.TextAdvance(r.StackBottom, hs, r.WidthFactor, r.Tracking)
        If r.StackType = "#" Then                   ' fraccion en diagonal
            AddGlyphs(glx.DrawTextPoly(r.StackTop, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX, fY + h * 0.45, r)
            AddGeom([fX + wTop + h * 0.05, fY - h * 0.15, fX + wTop + h * 0.45, fY + h * 1.15])
            AddGlyphs(glx.DrawTextPoly(r.StackBottom, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX + wTop + h * 0.5, fY - h * 0.15, r)
        Else
            fW = Max(wTop, wBottom)
            If r.StackType = "/" Then               ' centrada, con raya
                AddGlyphs(glx.DrawTextPoly(r.StackTop, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX + h * 0.05 + (fW - wTop) / 2, fY + h * 0.65, r)
                AddGlyphs(glx.DrawTextPoly(r.StackBottom, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX + h * 0.05 + (fW - wBottom) / 2, fY - h * 0.35, r)
                AddGeom([fX, fY + h * 0.5, fX + fW + h * 0.1, fY + h * 0.5])
            Else                                    ' ^ tolerancias: a la izquierda, sin raya
                AddGlyphs(glx.DrawTextPoly(r.StackTop, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX + h * 0.05, fY + h * 0.6, r)
                AddGlyphs(glx.DrawTextPoly(r.StackBottom, hs, 0, RunOblique(r), r.WidthFactor, r.Tracking), fX + h * 0.05, fY - h * 0.3, r)
            Endif
        Endif
    Endif

    If r.Underline Then AddGeom([fX, fY - h * 0.2, fX + r.Width, fY - h * 0.2])
    If r.Overline Then AddGeom([fX, fY + h * 1.2, fX + r.Width, fY + h * 1.2])
    If r.Strike Then AddGeom([fX, fY + h * 0.45, fX + r.Width, fY + h * 0.45])

End

Private Sub AddGlyphs(flx As Float[], fX As Float, fY As Float, r As MTextRun)

    Dim flxBold As Float[]

    puntos.Translate(flx, fX, fY)
    If r.Bold Then                              ' negrita: repito el trazo un poco corrido
        flxBold = flx.Copy()
        puntos.Translate(flxBold, r.Height * BoldOffset, 0)
        flx.Insert(flxBold)
    Endif
    AddGeom(flx)

End

Private Sub AddGeom(flx As Float[])

    $flxAll.Insert(flx)

End

Public Function SaveDxfData(e As Entity) As Boolean

    Dim i As Integer, sText, sFull As String
    Dim pIns As Punto3d
    Dim fWidth As Float
    Dim iAttach As Integer

    ' el DXF no tiene los dos puntos: va el punto de insercion, el ancho y el angulo que salen de ellos
    sFull = e.sParam[Me.sdaText]
    iAttach = CInt(e.fParam[Me.ipaAttchmPoint])
    If e.Gender = "MTEXT" Then
        If e.P.Count < 2 Then MakeTwoPoints(e)
        SyncFields(e)
        If Mode(e) = ModeFit Then
            ' Fit no existe en el DXF: guardo el factor de ancho que lo estira, en una caja un poco mas ancha
            Me.BuildGeometry(e)
            sFull = "{\\W" & CStr(Round(cadMText.CurrentTextRelScaleX, -6)) & ";" & sFull & "}"
            iAttach = AttachRow(e) * 3 + 1
        Endif
    Endif
    pIns = InsertionOf(e)
    fWidth = e.fParam[Me.ipaRectangleWidth]
    If Mode(e) = ModeFit Then fWidth *= 1.001

    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCodeInv("AcDbMText", "100")

    dxf.SaveCodeInv(CStr(pIns.x), dxf.codX0)                    ' insertion point
    dxf.SaveCodeInv(CStr(pIns.y), dxf.codY0)
    dxf.SaveCodeInv("0", dxf.codZ0)

    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaTextHeight]), "40")       ' heigth
    dxf.SaveCodeInv(CStr(fWidth), "41")                           ' Rectang width
    dxf.SaveCodeInv(iAttach, "71")                                ' attchm point
    dxf.SaveCodeInv(e.fParam[Me.ipaDrawingDirec], "72")           ' drawing direction

    If sFull.Len > 250 Then
        dxf.SaveCodeInv(Left(sFull, 250), "1")                ' Texti = 250
        i = 251         ' next offset
        Do

            If sFull.Len - i > 250 Then
                sText = Mid(sFull, i, 250)
                dxf.SaveCodeInv(sText, "3")                ' Texti += 250
                i += 250
            Else
                sText = Mid(sFull, i)
                dxf.SaveCodeInv(sText, "3")                ' Texti += 250
                Break

            End If

        Loop
    Else
        dxf.SaveCodeInv(sFull, "1")                ' Text
    Endif

    dxf.SaveCodeInv(e.sParam[Me.sdaStyle], "7")               ' text style
    If e.Extrusion[2] <> 1 Then
        dxf.SaveCodeInv(CStr(e.Extrusion[0]), "210")
        dxf.SaveCodeInv(CStr(e.Extrusion[1]), "220")
        dxf.SaveCodeInv(CStr(e.Extrusion[2]), "230")
    Endif

    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaTextAngle]), "50")        ' rotation in radians

    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaBackFillType]), "90")     ' Background fill style

    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaBackColor]), "63")         ' Background color

    dxf.SaveCodeInv("0", "75") ' Column type
    dxf.SaveCodeInv("0", "76") ' Column count
    dxf.SaveCodeInv("0", "78") ' Column Flow Reversed
    dxf.SaveCodeInv("0", "79") ' Column Autoheight
    dxf.SaveCodeInv("0", "48") ' Column width
    dxf.SaveCodeInv("0", "49") ' Column gutter
    dxf.SaveCodeInv("0", "50") ' Column heights

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i As Integer
    Dim ax, ay, az As Single ' angulo del texto
    Dim s As String

    i = dxf.ReadCodePlus(10, sClaves, sValues, ByRef e.P[0].x,, 101, 100)
    i = dxf.ReadCodePlus(20, sClaves, sValues, ByRef e.P[0].y,, 101, 100)
    i = dxf.ReadCodePlus(40, sClaves, sValues, ByRef e.fParam[Me.ipaTextHeight],, 101, 100)
    i = dxf.ReadCodePlus(41, sClaves, sValues, ByRef e.fParam[Me.ipaRectangleWIdth],, 101, 100)

    i = dxf.ReadCodePlus(71, sClaves, sValues, ByRef e.fParam[Me.ipaAttchmPoint],, 101, 100)
    i = dxf.ReadCodePlus(72, sClaves, sValues, ByRef e.fParam[Me.ipaDrawingDirec],, 101, 100)
    i = dxf.ReadCodePlus(1, sClaves, sValues, ByRef e.sParam[Me.sdaText],, 101, 100)
    Do
        i = dxf.ReadCodePlus(3, sClaves, sValues, ByRef s,, 101, i)
        If s = "" Then Break
        e.sParam[Me.sdaText] &= s
    Loop Until i = 0
    i = dxf.ReadCodePlus(7, sClaves, sValues, ByRef e.sParam[Me.sdaStyle],, 101, 100)
    i = dxf.ReadCodePlus(11, sClaves, sValues, ByRef ax,, 101, 100)
    i = dxf.ReadCodePlus(21, sClaves, sValues, ByRef ay,, 101, 100)
    i = dxf.ReadCodePlus(31, sClaves, sValues, ByRef az,, 101, 100)
    i = dxf.ReadCodePlus(50, sClaves, sValues, ByRef e.fParam[Me.ipaTextAngle],, 101, 100)
    i = dxf.ReadCodePlus(90, sClaves, sValues, ByRef e.fParam[Me.ipaBackFillType],, 101, 100)
    i = dxf.ReadCodePlus(63, sClaves, sValues, ByRef e.fParam[Me.ipaBackColor],, 101, 100)

    If (ax <> 0) Or (ay <> 0) Or (az <> 0) Then

        e.fParam[Me.ipaTextAngle] = Ang(ax, ay)

    Endif
    e.sParam[Me.sdaStyle] = Lower(e.sParam[Me.sdaStyle])
    If e.sParam[Me.sdaStyle] = "" Then e.sParam[Me.sdaStyle] = "standard"
    If e.Gender = "MTEXT" Then MakeTwoPoints(e)        ' punto 1 y punto 2, ver los grips

    Return True

End

'' Genera un conjunto de grips para ser usados por cadSelection
Public Function GenerateGrips(e As Entity) As Integer

    Dim g As Grip
    Dim pA As Punto3d
    Dim fAng, fH, OffsetWidth As Float

    If e.Gender = "MTEXT" Then Return GripsTwoPoints(e)       ' el ATTDEF sigue con los de antes

    pA = e.P[Me.AnchorIndex(e)]
    fAng = Me.AngleRad(e)
    fH = e.fParam[Me.ipaTextHeight]

    g = New Grip
    g.Shape = 0
    g.p = pA.Copy()
    g.pRef = g.P.Copy()
    g.Action = 0 ' mover
    g.AsociatedEntity = e
    g.AsociatedPoint = -1
    gcd.Drawing.Sheet.Grips.Add(g)
    g.ToolTip = ("Move base")

    ' GRIP PARA EL ANCHO DEL AREA DEL TEXTO (solo MTEXT); depende del punto de insercion
    If e.Gender = "MTEXT" Then
        Select Case CInt(e.fParam[Me.ipaAttchmPoint])
            Case 2, 5, 8  ' mid
                OffsetWidth = e.fParam[Me.ipaRectangleWIdth] / 2
            Case 3, 6, 9  ' rigth
                OffsetWidth = -e.fParam[Me.ipaRectangleWIdth]
            Case Else ' left
                OffsetWidth = e.fParam[Me.ipaRectangleWIdth]
        End Select
        g = New Grip
        g.Shape = 1
        g.p = puntos.P3d(pA.x + OffsetWidth * Cos(fAng), pA.y + OffsetWidth * Sin(fAng), pA.z)
        g.pRef = g.P.Copy()
        g.Action = 1 ' este dato es propio de la clase
        g.AsociatedEntity = e
        g.AsociatedPoint = 0
        g.DrawLineToAsociatedGrip = True
        g.ToolTip = ("Change width")
        gcd.Drawing.Sheet.Grips.Add(g)
    Endif

    ' GRIP PARA CAMBIAR LA ALTURA DEL TEXTO
    g = New Grip
    g.Shape = 1
    g.p = puntos.P3d(pA.x - fH * Sin(fAng), pA.y + fH * Cos(fAng), pA.z)
    g.pRef = g.P.Copy()
    g.Value = fH
    g.Action = 2
    g.AsociatedEntity = e
    g.AsociatedPoint = 0
    g.DrawLineToAsociatedGrip = True
    g.ToolTip = ("Text height")
    gcd.Drawing.Sheet.Grips.Add(g)

    ' GRIP PARA GIRAR, del lado opuesto al texto
    g = New Grip
    g.Shape = 2
    g.p = puntos.P3d(pA.x - fH * Cos(fAng), pA.y - fH * Sin(fAng), pA.z)
    g.pRef = g.P.Copy()
    g.Action = 3
    g.AsociatedEntity = e
    g.AsociatedPoint = 0
    g.AsociatedGrip = 0
    g.iFillColor = Color.Red
    g.DrawLineToAsociatedGrip = True
    g.ToolTip = ("Rotate text")
    gcd.Drawing.Sheet.Grips.Add(g)

End

Public Function GripEdit(g As Grip) As Boolean

    Dim e As Entity
    Dim pA As Punto3d
    Dim fAng, dx, dy, fProj As Float

    e = g.AsociatedEntity
    If e.Gender = "MTEXT" Then
        GripEditTwoPoints(g)
        Return
    Endif
    pA = e.P[Me.AnchorIndex(e)]
    fAng = Me.AngleRad(e)
    dx = g.P.x - pA.x
    dy = g.P.y - pA.y

    Select Case g.Action
        Case 0 ' muevo todo el texto; el z se conserva
            puntos.TranslateP(e.P, dx, dy, 0)

        Case 1 ' cambiar el ancho: proyeccion sobre la direccion del texto
            fProj = dx * Cos(fAng) + dy * Sin(fAng)
            Select Case CInt(e.fParam[Me.ipaAttchmPoint])
                Case 2, 5, 8
                    fProj *= 2
                Case 3, 6, 9
                    fProj = -fProj
            End Select
            If fProj < 0 Then fProj = 0
            e.fParam[Me.ipaRectangleWIdth] = fProj

        Case 2 ' cambiar la altura: proyeccion sobre la perpendicular
            fProj = -dx * Sin(fAng) + dy * Cos(fAng)
            If fProj > 0 Then e.fParam[Me.ipaTextHeight] = fProj

        Case 3 ' rotar
            Me.SetAngleRad(e, Ang(dx, dy) - Pi)

    End Select
    Me.BuildGeometry(e)
    gcd.Drawing.Sheet.Grips.Clear
    Me.GenerateGrips(e)

End

' Grips del MTEXT (ver "grips for mtext.jpg"):
'   cuadrado 1: mueve todo el texto        cuadrado 2: direccion y ancho de la caja
'   triangulo a la derecha de 1: alinear a la izquierda
'   triangulo a la izquierda de 1: alinear a la derecha en el punto 1, sin usar el punto 2
'   triangulo arriba de 1: alinear abajo   triangulo abajo de 1: alinear arriba
'   triangulo junto a 2: alinear a la derecha (en el punto 2)
'   barra entre 1 y 2: Fit
Public Const GripMove As Integer = 0
Public Const GripPoint2 As Integer = 10
Public Const GripAlignLeft As Integer = 11
Public Const GripAlignRightFree As Integer = 12
Public Const GripAlignBottom As Integer = 13
Public Const GripAlignTop As Integer = 14
Public Const GripAlignRight As Integer = 15
Public Const GripFit As Integer = 16

Private Function GripsTwoPoints(e As Entity) As Integer

    Dim g As Grip
    Dim fAng, fOff As Float
    Dim iFirst As Integer

    If e.P.Count < 2 Then Me.BuildGeometry(e)       ' arma los dos puntos
    fAng = e.fParam[Me.ipaTextAngle]
    fOff = Config.GripSize * 1.4                     ' pixels desde el punto
    iFirst = gcd.Drawing.Sheet.Grips.Count

    AddGrip(e, e.P[0], GripMove, 0, 0, 0, ("Move text"))
    g = AddGrip(e, e.P[1], GripPoint2, 0, 0, 0, ("Direction and width of the text"))
    g.DrawLineToAsociatedGrip = True
    g.AsociatedGrip = iFirst
    AddGrip(e, e.P[0], GripAlignLeft, 3, fOff, fAng, ("Align left"))
    AddGrip(e, e.P[0], GripAlignRightFree, 3, fOff, fAng + Pi, ("Align right, without point 2"))
    AddGrip(e, e.P[0], GripAlignBottom, 3, fOff, fAng + Pi / 2, ("Align bottom"))
    AddGrip(e, e.P[0], GripAlignTop, 3, fOff, fAng - Pi / 2, ("Align top"))
    AddGrip(e, e.P[1], GripAlignRight, 3, fOff, fAng + Pi, ("Align right"))
    AddGrip(e, puntos.P3d((e.P[0].x + e.P[1].x) / 2, (e.P[0].y + e.P[1].y) / 2, e.P[0].z), GripFit, 4, 0, fAng, ("Fit between the points"))

End

Private Function AddGrip(e As Entity, p As Punto3d, iAction As Integer, iShape As Integer, fOffset As Float, fDirection As Float, sTip As String) As Grip

    Dim g As New Grip

    g.Shape = iShape
    g.p = p.Copy()
    g.pRef = g.P.Copy()
    g.Action = iAction
    g.Offset = fOffset
    g.Direction = fDirection
    g.AsociatedEntity = e
    g.AsociatedPoint = -1
    g.ToolTip = sTip
    gcd.Drawing.Sheet.Grips.Add(g)
    Return g

End

'' Los triangulos y la barra cambian la alineacion con un click (no importa donde se suelte el mouse)
Private Sub GripEditTwoPoints(g As Grip)

    Dim e As Entity

    e = g.AsociatedEntity
    Select Case g.Action
        Case GripMove           ' muevo todo el texto; el z se conserva
            puntos.TranslateP(e.P, g.P.x - e.P[0].x, g.P.y - e.P[0].y, 0)
        Case GripPoint2         ' el punto 2: si no habia caja, ahora la hay
            e.P[1].x = g.P.x
            e.P[1].y = g.P.y
            If Mode(e) = ModeFree Then e.fParam[Me.ipaHorizJustif] = ModeBox
        Case GripAlignLeft
            e.fParam[Me.ipaHorizJustif] = ModeBox
            SetAttach(e, AttachRow(e), 0)
        Case GripAlignRightFree
            e.fParam[Me.ipaHorizJustif] = ModeFree
            SetAttach(e, AttachRow(e), 2)
        Case GripAlignBottom
            SetAttach(e, 2, AttachCol(e))
        Case GripAlignTop
            SetAttach(e, 0, AttachCol(e))
        Case GripAlignRight
            e.fParam[Me.ipaHorizJustif] = ModeBox
            SetAttach(e, AttachRow(e), 2)
        Case GripFit
            e.fParam[Me.ipaHorizJustif] = ModeFit
    End Select
    Me.BuildGeometry(e)
    gcd.Drawing.Sheet.Grips.Clear
    Me.GenerateGrips(e)

End
