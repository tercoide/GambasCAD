' Fast
Inherits EntityBase
Public Const USEWITH As String = "TEXTBUILDER"    ' MTEXT y TEXT se crean con el editor fTextEditor (cadTextBuilder)
Public Const Gender As String = "MTEXT"
Public Const DrawingOrder As Integer = 100 ' 1 a 32.724 esto debe Drawse primero y ser sobreescrito por el resto
Public Const PointsToDraw As Integer = 1             ' minimal point requered for drawing something usefull
Public Const CmdLineHelper As String = ("Inserts a multiline text: insertion point")
Public Const ParamType As String = "point"
Public Const ParamHelper As String = "start"     ' a little text that is shown at the prompt waiting for user input during build
Public Const ParamDefault As String = " ; 0 ; 10 ; "
Public Const Regenerable As Boolean = True

' variables del motor de texto; cadText las carga antes de llamar a ProcessText3
Public CurrentTextHeigth As Float           '' altura base
Public OriginalTextPosX As Float            '' punto de insercion
Public OriginalTextPosY As Float
Public CurrentTextBoxWidth As Float         '' ancho de la caja del MTEXT, 0 = sin caja
Public CurrentTextAlignment As Integer      '' horizontal: 0 = izq, 1 = centro, 2 = der
Public CurrentTextAlignmentVertical As Integer  '' 0 = arriba, 1 = medio, 2 = abajo (ultima linea base), 3 = linea base (TEXT), 4 = abajo de las letras (TEXT)
Public CurrentTextRelScaleX As Float = 1    '' factor de ancho
Public CurrentTextItalic As Float           '' angulo oblicuo, grados
Public CurrentTextFont As String
Public CurrentTextAngle As Float            '' grados
Public TrimText As Boolean                  '' cortar en renglones al ancho de la caja
Public PlainText As Boolean                 '' TEXT: solo codigos %%, sin codigos en linea

' resultados del ultimo armado
Public TextOriginX As Float                 '' inicio de la linea base del primer renglon
Public TextOriginY As Float
Public LastLineWidth As Float               '' ancho del primer renglon
Public LastTextHeight As Float              '' alto total del texto
Public LastBoxWidth As Float                '' ancho de la caja, o del renglon mas largo si no hay caja

' el cursor del editor: cadTextBuilder pone CaretMark en el texto y ProcessText3 dice donde quedo
Public CaretFound As Boolean
Public CaretX0 As Float                     '' abajo del cursor
Public CaretY0 As Float
Public CaretX1 As Float                     '' arriba del cursor
Public CaretY1 As Float

' MTEXT de dos puntos: P0 = punto 1, P1 = punto 2 (ver los grips). El modo va en fParam[ipaHorizJustif]
Public Const ModeBox As Integer = 0         '' caja de P0 a P1: corta los renglones y alinea a izq (P0), centro o der (P1)
Public Const ModeFree As Integer = 1        '' sin caja: cuelga de P0 (a izq, centro o der); P1 solo da la direccion
Public Const ModeFit As Integer = 5         '' el texto se estira para ir de P0 a P1

Public Const LineSpacingFactor As Float = 1.6667    '' distancia entre renglones en alturas de texto, como AutoCAD
Public Const StackScale As Float = 0.7              '' tamaño de los numeros de una fraccion
Public Const BoldOffset As Float = 0.04             '' la negrita se simula repitiendo el trazo corrido

Private $sRunBuf As String                  '' texto acumulado mientras leo los codigos
Private $flxAll As New Float[]              '' geometria del texto

' fParam helpers
Public Const TotalParams As Integer = 13
Public Const ipaTextHeight As Integer = 0
Public Const ipaTextAngle As Integer = 1
Public Const ipaGenerationFlags As Integer = 2
Public Const ipaHorizJustif As Integer = 3
Public Const ipaVertJustif As Integer = 4
Public Const ipaRelativeFactor As Integer = 5
Public Const ipaHorizAngle As Integer = 6
Public Const ipaTextVisibility As Integer = 7
Public Const ipaAttchmPoint As Integer = 8
Public Const ipaRectangleWIdth As Integer = 9
Public Const ipaDrawingDirec As Integer = 10
Public Const ipaBackFillType As Integer = 11
Public Const ipaBackColor As Integer = 12

' stringdata helpers
Public Const sdaTotalParams As Integer = 2
Public Const sdaText As Integer = 0
Public Const sdaStyle As Integer = 1
Public Const TotalPoints As Integer = 1 ' 2021 cambie esto

Public PrintingType As Integer

Public MyPolygon As New Float[]

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If Me.ExpectedParam = "start" Then  '  posicion

        If vParam[0] <> "point" Then Return

        Try eBuild.P[0].x = vParam[1]
        Try eBuild.P[0].y = vParam[2]

        If Definitive Then
            Me.ExpectedParam = "angle"
            Return ["prompt": "angle", "next": "float"]
        End If

    Else If Me.ExpectedParam = "angle" Then ' angulo del texto

        If vParam[0] <> "float" Then Return

        eBuild.fParam[Me.ipaTextAngle] = vParam[1]
        eBuild.fParam[Me.ipaAttchmPoint] = 0
        eBuild.fParam[Me.ipaDrawingDirec] = 0

        If Definitive Then
            Me.ExpectedParam = "height"
            Return ["prompt": "height", "next": "float"]
        End If

    Else If Me.ExpectedParam = "height" Then   ' altura

        If vParam[0] <> "float" Then Return

        eBuild.fParam[Me.ipaTextHeight] = vParam[1]

        If Definitive Then
            Me.ExpectedParam = "text"
            Return ["prompt": "text", "next": "text"]
        End If
    Else If Me.ExpectedParam = "text" Then    ' texto

        If vParam[0] <> "text" Then Return

        eBuild.sParam[Me.sdaText] = vParam[1]

        If Definitive Then Return ["command": "end"]

    Else
        Return False
    End If

End

Public Sub Translate(e As Entity, dX As Float, dY As Float, dZ As Float, Optional OnlySelected As Boolean = False)

    Dim i As Integer

    If OnlySelected Then

        puntos.TranslateConditionalP(e.P, dX, dY, e.Psel, dZ)

    Else

        puntos.TranslateP(e.P, dX, dY, dZ)
    Endif
    puntos.Translate(e.PolyLine, dx, dy)
    puntos.Translate(e.Polygon, dx, dy)
    'depre BuildPOI(e)

End

Public Sub Rotate(e As Entity, radians As Float)

    puntos.RotateP(e.P, radians)

    Me.SetAngleRad(e, Me.AngleRad(e) + radians)
    puntos.Rotate(e.PolyLine, radians)
    puntos.Rotate(e.Polygon, radians)

End

'' Angulo del texto en radianes. El MTEXT lo guarda en radianes, el TEXT en grados (ver cadText)
Public Function AngleRad(e As Entity) As Float

    Return e.fParam[Me.ipaTextAngle]

End

Public Sub SetAngleRad(e As Entity, fRad As Float)

    e.fParam[Me.ipaTextAngle] = fRad

End

'' El punto que sostiene al texto: P0 en el MTEXT; en el TEXT justificado es P1 (ver cadText)
Public Function AnchorIndex(e As Entity) As Integer

    Return 0

End

Public Sub Scale(e As Entity, sX As Float, sY As Float, Optional sZ As Float = 1)

    E.fParam[Me.ipaTextHeight] *= sY
    puntos.ScaleP(e.P, sx, sy)
    puntos.Scale(e.PolyLine, sx, sy)
    puntos.Scale(e.Polygon, sx, sy)

End

'' A fat version of the line
Public Sub DrawSelected(oE As Entity)

    glx.DrawLines(oE.PolyLine, Gcd.ColorSelected(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer))

End

'' A fat version of the line
Public Sub DrawRemark(oE As Entity)

    If Not oE.Visible Then Return

    glx.DrawLines(oE.PolyLine, Gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer))

End

Public Function Draw2(oE As Entity)

    paintPlus.Lines(oe.PolyLine)

End

' '' Creo los puntos de interes
