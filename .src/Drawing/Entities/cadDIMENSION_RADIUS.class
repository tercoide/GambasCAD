'' Cota de radio. DXF tipo 4
''   P[0] = 10   centro
''   P[5] = 15   punto sobre la curva
''   P[1] = 11   centro del texto
'' Tambien arma las cotas de diametro (ver cadDIMENSION_DIAMETER)

Create Static
Inherits CadDimension

Public Const Gender As String = "DIMENSION_RADIUS"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert a radius dimension")
Public Const ParamType As String = "PPP"
Public Const ParamHelper As String = "Center;Point on the curve;Text location"
Public Const DimTypeCode As Integer = 4
Public Const DxfSubclass As String = "AcDbRadialDimension"
Public Const GripPoints As String = "0;5;1"
Public Const GripTips As String = ("Move center;Move point on the curve;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If vParam[0] <> "point" Then Return False

    If gcd.StepsDone = 0 Then           ' centro

        eBuild.P[0] = Me.ParamPoint(vParam)
        eBuild.P[5] = eBuild.P[0].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then      ' punto sobre la curva

        eBuild.P[5] = Me.ParamPoint(vParam)
        Me.SetUserText(eBuild, False)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Else If gcd.StepsDone = 2 Then      ' el texto

        eBuild.P[1] = Me.ParamPoint(vParam)
        Me.SetUserText(eBuild, True)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

Public Sub MakeBlock(e As Entity)

    MakeRadial(e, e.P[0].x, e.P[0].y, e.P[5].x, e.P[5].y, False)

End

'' Radios y diametros: xc,yc es el centro y px,py el punto sobre la curva donde va la flecha
Public Sub MakeRadial(e As Entity, xc As Float, yc As Float, px As Float, py As Float, bDiameter As Boolean)

    Dim d As DimStyle = e.pDimStyle
    Dim r, ux, uy, th, tw, gap, asz, tcx, tcy, ta, t As Float
    Dim sText As String
    Dim bInside As Boolean
    Dim flxText As Float[]

    r = Sqr((px - xc) ^ 2 + (py - yc) ^ 2)
    If r > 0 Then
        ux = (px - xc) / r
        uy = (py - yc) / r
    Else
        ux = 1
        uy = 0
    Endif

    If bDiameter Then
        e.fParam[Me.ipaRealMeasure] = r * 2 * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor
        sText = Me.LinearText(e, r * 2, "Ø")
    Else
        e.fParam[Me.ipaRealMeasure] = r * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor
        sText = Me.LinearText(e, r, "R")
    Endif

    th = Me.TextHeight(e)
    tw = Me.TextWidth(e, sText)
    gap = d.DIMGAP * Me.DimScale(e)
    asz = d.DIMASZ * Me.DimScale(e)

    ' donde va el texto
    If Me.UserText(e) Then
        tcx = e.P[1].x
        tcy = e.P[1].y
        bInside = Sqr((tcx - xc) ^ 2 + (tcy - yc) ^ 2) < r
    Else
        If bDiameter Then
            bInside = r * 2 > tw + asz * 4 + gap * 2
        Else
            bInside = r > tw + asz * 2 + gap * 2
        Endif
        If d.DIMTIX Then bInside = True
        If bInside Then
            If bDiameter Then t = 0 Else t = r / 2
            ta = Me.ReadableAngle(Ang(ux, uy))
            If d.DIMTIH Then ta = 0
            tcx = xc + ux * t
            tcy = yc + uy * t
            If d.DIMTAD <> 0 Then
                tcx += -Sin(ta) * (th / 2 + gap) * IIf(d.DIMTAD = 4, -1, 1)
                tcy += Cos(ta) * (th / 2 + gap) * IIf(d.DIMTAD = 4, -1, 1)
            Endif
        Else
            tcx = px + ux * (asz * 2 + gap + tw / 2)
            tcy = py + uy * (asz * 2 + gap + tw / 2)
        Endif
    Endif

    If bInside Then
        ' la linea de cota pasa por el centro (diametro) o sale del centro (radio)
        If bDiameter Then
            flxText = AddDimLineAt(e, xc - ux * r, yc - uy * r, px, py, sText, tcx, tcy)
        Else
            flxText = AddDimLineAt(e, xc, yc, px, py, sText, tcx, tcy, True)
        Endif
        tcx = flxText[0]
        tcy = flxText[1]
    Else
        ' flecha desde afuera y directriz hasta el texto
        Me.AddMarker(e, d.Marker(2), px, py, Ang(-ux, -uy))
        Me.AddLeaderText(e, px, py, sText, tcx, tcy, False)
        Me.AddCenterMark(e, xc, yc, r)
    Endif

    e.P[1].x = tcx
    e.P[1].y = tcy

End

'' Una linea de cota entre dos puntos con el texto en tcx,tcy (lo pone ahi aunque no sea UserText).
'' bOnlyEnd: solo lleva marcador en el segundo punto (radios)
Public Function AddDimLineAt(e As Entity, x1 As Float, y1 As Float, x2 As Float, y2 As Float, sText As String, tcx As Float, tcy As Float, Optional bOnlyEnd As Boolean) As Float[]

    Dim iFlags As Integer
    Dim flxRet As Float[]

    ' uso la linea de cota comun con el texto fijo en tcx,tcy
    iFlags = e.iParam[Me.iiiDimType]
    e.P[1].x = tcx
    e.P[1].y = tcy
    Me.SetUserText(e, True)
    flxRet = AddDimLineNoFirst(e, x1, y1, x2, y2, sText, bOnlyEnd)
    e.iParam[Me.iiiDimType] = iFlags
    Return flxRet

End

'' AddDimLine, pero sin el primer marcador si bNoFirst
Private Function AddDimLineNoFirst(e As Entity, x1 As Float, y1 As Float, x2 As Float, y2 As Float, sText As String, bNoFirst As Boolean) As Float[]

    Dim d As DimStyle = e.pDimStyle
    Dim iSah As Integer
    Dim sBlk, sBlk1, sBlk2 As String
    Dim flxRet As Float[]

    If Not bNoFirst Then Return Me.AddDimLine(e, x1, y1, x2, y2, sText)

    ' cambio el estilo por un momento: marcador 1 = ninguno
    iSah = d.DIMSAH
    sBlk = d.DIMBLK
    sBlk1 = d.DIMBLK1
    sBlk2 = d.DIMBLK2
    d.DIMBLK2 = d.Marker(2)
    d.DIMBLK1 = DimStyle.MarkerNone
    d.DIMSAH = 1
    flxRet = Me.AddDimLine(e, x1, y1, x2, y2, sText)
    d.DIMSAH = iSah
    d.DIMBLK = sBlk
    d.DIMBLK1 = sBlk1
    d.DIMBLK2 = sBlk2
    Return flxRet

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv(Me.DxfSubclass, "100")
    Me.SavePoint(e, 5)
    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaLeaderLength]), "40")

End
