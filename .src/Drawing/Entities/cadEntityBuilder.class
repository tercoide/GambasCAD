Public Function KeyText(EnteredText As String) ' esta rutina es llamada por FCAD en el evento FCAD_KeyPress cuando recibe una texto + <Enter>

    ' Lets see what are we expecting
    Dim Xt, yt, zt, f As Float, sText, ErrTxt As String, Relative As Boolean
    Dim bResult, Good As Boolean

    ' primero veo si el entorno nos pide algo
    Select Case UCase(EnteredText)
        Case "_CANCEL"
            Me.Cancel
            Return
        Case "_MIDPOINT", "_MID"
            gcd.SnapMode = gcd.poiMIdPoint
        Case "_ENDPOINT", "_END"
            gcd.SnapMode = gcd.poiEndPoint
        Case "_PERPENDICULAR", "_PER"
            gcd.SnapMode = gcd.poiPerpendicular
        Case "_NEAREST", "_NEA"
            gcd.SnapMode = gcd.poiNearest
        Case "_CENTER", "_CEN"
            gcd.SnapMode = gcd.poiCenter
        Case "_INTERSECTION", "_INT"
            gcd.SnapMode = gcd.poiIntersection
        Case "_BASEPOINT", "_BAS"
            gcd.SnapMode = gcd.poiBasePoint
        Case "_TANGENT", "_TAN"
            gcd.SnapMode = gcd.poiTangent
        Case "_QUADRANT", "_QUA"
            gcd.SnapMode = gcd.poiQuadrant
    End Select

    Select Case NextParamType

        Case "point", "M"
            errtxt = ", expected a valId point like 12.4,9.5  or @12.34,10.5"
            ' lets filter
            EnteredText = Trim$(UCase$(EnteredText))
            sText = Left(EnteredText, 1)
            ' So we expect a position x,y , but in some cases it can be
            ' C = close
            ' U = undo, delete last segment
            ' and others

            If InStr("+-@0123456789.", sText) > 0 Then ' es un numero
                If InStr(EnteredText, "@") > 0 Then    ' may be a point
                    Relative = True
                    EnteredText = Replace(EnteredText, "@", "")
                Endif
                Xt = CFloat(Eval(Split(EnteredText, ",")[0]))
                yt = CFloat(Eval(Split(EnteredText, ",")[1]))
                Try zt = CFloat(Eval(Split(EnteredText, ",")[2]))

                ' If Relative And (elem.P.count > 2) Then
                If Relative And Not IsNull(gcd.drawing.sheet.LastPoint) Then        '  this should work too
                    xt += gcd.drawing.sheet.LastPoint.x
                    yt += gcd.drawing.sheet.LastPoint.y
                    zt += gcd.drawing.sheet.LastPoint.z

                Endif

                GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["point", xt, yt, zt], True))
                gcd.drawing.sheet.lastpoint = New Punto3d(xt, yt, zt)

            Else    ' es una letra

                GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["text", EnteredText], True))

            End If

            ' esto no se maneja mas a este nivel, cada entidad lo maneja en NewParameter

            ' If Left(EnteredText, 1) = "C" Then          ' close the element
            '     ' got othe first point and exit
            '     If Gcd.CCC[elem.gender].NewParameter(elem, ["close"]) Then Me.Finish
            '
            ' Else If Left(EnteredText, 1) = "U" Then     ' undo last command and go
            '
            '     If Gcd.CCC[elem.gender].NewParameter(elem, ["undo"]) Then Me.Finish
            '
            ' Else
            '
        Case "vec3"          ' un vector representando 3 ejes: v1,v2,v3
            Try Xt = CFloat(Eval(Split(EnteredText, ",")[0]))
            Try yt = CFloat(Eval(Split(EnteredText, ",")[1]))
            Try zt = CFloat(Eval(Split(EnteredText, ",")[2]))

            GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["vec3", xt, yt, zt], True))

        Case "text"
            errtxt = ", expected text, not a point"

            GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["text", sText], True))

        Case "float", "angle", "lenght", "rectangle"                ' Float, Mixed, Angle, Longitud
            errtxt = "enter a valid text size"

            If EnteredText = "" Or EnteredText = "U" Then
                GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", ParamDefault[gcd.StepsDone]], True))

            Else

                Try f = CFloat(EnteredText)

                bResult = GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", f], True))

            Endif

        Case "color"                                ' color
            If Dialog.SelectColor() Then
                elem.fParam[iFloat] = CFloat(Dialog.Color)
                Inc iFloat

            Endif
            Key.Code

    End Select

    'Finally
    '
    Return
    '
    'Catch
    '
    '   ' unexpected input
    '   DrawingAIds.ErrorMessage = ("Bad input" & ErrTxt)

End

Public Sub KeyUp(iCode As Integer)

    If icode = Key.ControlKey Then gcd.Orthogonal = False

End

Public Sub MouseMove()

    Dim X, Y, Z, f As Float
    Dim MouseTry As Integer = -1000000
    Dim Dx As Float
    Dim Dy As Float
    Dim p As Punto3d
    Dim poi As Collection

    ' ' yo NO soy el responsable de chequear POI
    ' poi = clsMouseTracking.CheckBestPOI(x, Y)
    ' Me.LastP = poi["point"]

    ' Version moderna 3D
    If gcd.Drawing.Sheet.CurentTrackedPoint Then
        P = gcd.Drawing.Sheet.CurentTrackedPoint.Copy()
    Else
        P = gcd.Drawing.Sheet.CurrentPoint.Copy()
    End If

    If Not P Then Stop ' no deberia ocurrir

    ' X = gcd.Xreal(MouseX)                     ' El punto rastreado ya viene en coordenadas reales y en el plano de trabajo
    ' Y = gcd.Yreal(MouseY)

    X = gcd.Near(p.X)
    Y = gcd.Near(p.Y)
    Z = gcd.Near(p.Z)

    ' a very special case
    If elem.Gender = "SPLINE" And (Me.iPoints <> elem.P.Count - 1) Then Inc iPoints

    ' if we expect a parameter, it will be passed
    If NextParamType = "angle" Then

        ' return the angle from horizontal to us
        f = Ang(x - gcd.drawing.sheet.LastPoint.x, y - gcd.drawing.sheet.LastPoint.y)
        f *= 180 / Pi
        fMain.txtCommand.Text = "angle = " & Str(f)
        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", f]))

    End If

    If NextParamType = "relation" Then

        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["point", p.x, p.y, p.z]))
        ' nothing more to do here
    End If

    If NextParamType = "lenght" Then

        f = puntos.distancia(x, y, gcd.drawing.sheet.LastPoint.x, gcd.drawing.sheet.LastPoint.y)
        fMain.txtCommand.Text = "d = " & Str(f)

        getAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", f]))

    End If

    ' aca tengo que verificar el ortogonal

    If gcd.Orthogonal And Not IsNull(gcd.drawing.sheet.LastPoint) Then          ' hablame de operadores logicos

        If Abs(X - gcd.drawing.sheet.LastPoint.x) > Abs(Y - gcd.drawing.sheet.LastPoint.y) Then ' prevalece X
            Y = gcd.drawing.sheet.LastPoint.y
        Else
            X = gcd.drawing.sheet.LastPoint.x
        Endif

    End If

    If Not IsNull(gcd.drawing.sheet.LastPoint) Then
        If NextParamType = "point" Then
            fMain.txtCommand.Text = "@" & Str(x - gcd.drawing.sheet.LastPoint.x) & "," & Str(y - gcd.drawing.sheet.LastPoint.y)
        End If

    Endif

    If NextParamType = "point" Then

        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["point", P.x, P.y, P.z], False))
    End If

    gcd.redraw

End

Public Sub KeyPress(iCode As Integer, sKey As String)

End

Public Sub MouseUp()

    Dim X, Y, Z, f As Float
    Dim p As Punto3d

    If Mouse.Right Then ' si tengo un valor default, lo mando
        If Me.ParamDefault.Count > 0 Then
            Dim i As Integer
            Dim s, si As String
            s = Me.ParamDefault[0]
            For i = 1 To Me.ParamDefault.Max
                s &= ", " & si
            Next
        Endif
        gcd.clsJob.KeyText(s)
        Return
    End If

    DrawingAIds.ErrorMessage = ""
    'If InStr("LAPRM", NextParamType) = 0 Then Return ' we are expecting a parameter

    ' Version moderna 3D
    If gcd.Drawing.Sheet.CurentTrackedPoint Then
        P = gcd.Drawing.Sheet.CurentTrackedPoint.Copy()
    Else
        P = gcd.Drawing.Sheet.CurrentPoint.Copy()
    End If

    If Not P Then Stop ' no deberia ocurrir

    ' X = gcd.Xreal(MouseX)                     ' El punto rastreado ya viene en coordenadas reales y en el plano de trabajo
    ' Y = gcd.Yreal(MouseY)

    X = gcd.Near(p.X)
    Y = gcd.Near(p.Y)
    Z = gcd.Near(p.Z)                       ' esta funcion transforma coord de pantalla en 3D de acuerdo al plano de trabajo sie stoy en 2D

    ' if we expect a parameter, it will be passed
    If NextParamType = "angle" Then

        ' return the angle from horizontal to us
        f = Ang(x - gcd.drawing.sheet.LastPoint.x, y - gcd.drawing.sheet.LastPoint.y)
        f *= 180 / Pi
        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", f], True))

        gcd.redraw
        Return              ' nothing more to do here
    End If

    If NextParamType = "relation" Then

        If GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["point", p.x, p.y, p.z], True)) Then

        End If

    End If

    If NextParamType = "lenght" Then

        ' return the angle from horizontal to us
        f = puntos.distancia(x, y, gcd.drawing.sheet.LastPoint.x, gcd.drawing.sheet.LastPoint.y)

        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["float", f], True))

    End If

    If NextParamType = "point" Then

        GetAnswer(Gcd.CCC[elem.gender].NewParameter(elem, ["point", P.x, P.y, P.z], True))
    End If

    gcd.redraw

End

