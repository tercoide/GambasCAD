Public Gender As String = ""                '' Type of entity
Public P As New Punto3d[]                   '' Los puntos basicos que forman la entidad (x,y,z)
Public p3 As Punto3d[]                      '' for 3D
Public faces As Face[]                      '' 3D sin el New para evitar uso de memoria en 2D
Public sParam As New String[]               '' Array of Strings         '
Public fParam As New Float[]                '' Array of floats          ' estos 3 deberian ser un JSON
Public iParam As New Integer[]              '' Array of integers        '
Public Colour As Integer                    '' CAD color code
Public Material As Material
Public LineWidth As Integer = -3            '' This is it
Public pBlock As Variant                    '' Pointer to Block or Hatch (or null)
Public LineType As LineType                 '' 0=continuous, 1=dashed from flxDash
Public pLayer As Layer
Public pStyle As TextStyle                  ''
Public pDimStyle As DimStyle                ''
Public Visible As Boolean = True            '' Si esta entidad puede ser mostrada independientmente
Public PaperSpace As Boolean = False        '' Si esta entidad esta en algun paper space
'Public Sheet As Sheet                       '' La hoja o Layout donde esta dibujada
'Public Trackable As Boolean = True          '' Si esta entidad puede ser buscada en pantalla con el mouse
Public id As String
Public Container As Block                   '' Apunta al contenedor de esta entidad, util para UnDo y Redo
Public Children As Entity[]                 '' Contenedor de los hijos de esta entidad.
Public Group As Collection                  '' Grupos temporales de entidades. Esto apunta al grupo donde estoy o Null
Public Psel As New Boolean[]                '' Selected points
Public Polygon As New Float[]               '' This is a poligon built at element's contruction that defines a poligon used for detecting points inside me
Public PolyLine As New Float[]              '' Las lineas creadas a partir de la contruccion
Public Limits As New Float[4]               '' Point of interest
Public Extrusion As New Float[3]            '' Este plano, inutil en 2D pasa a ser importante en 3D para entidades que necesitan un plano, como el circulo.
'' Al momento de la creacion de la entidad, guardo este plano. Tambien viene con el DXF.

Public glVboVertexOffset As Integer
Public glVboTrianglesOffset As Integer
Public glVboPointsOffset As Integer
Public glVboVertexCount As Integer
Public glVboTrianglesCount As Integer
Public glVboPointsCount As Integer
Public Regenerable As Boolean = False
Public Generated As Boolean = False
Public Is3D As Boolean = False
