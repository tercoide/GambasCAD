' Gambas class file

Create Static
Inherits CadLine

' 0 CAMERA
' 5 C24
' 330 64
' 100 AcDbDbCamera
' Código 1: El nombre de la cámara.
' Códigos 10, 20, 30: Posición de la cámara en el espacio 3D (Coordenadas X, Y, Z del observador).
' Códigos 11,  21, 31: Pnto de mira o destino de la cámara (Coordenadas X, Y, Z hacia donde apunta el lente).
' Código 40: Distancia focal (en milímetros, por ejemplo, 50.0 para un lente estándar).
' Código 41: Distancia al plano de corte frontal (Front Clipping).
' Código 42: Distancia al plano de corte trasero (Back Clipping).
' Código 290: Bandera de corte de planos (1 si el corte está activado, 0 si está desactivado).
Public Const Gender As String = "CAMERA"

Public Sub Draw(oE As Entity)

    If Not oE.Visible Then Return

    Dim p3 As New Punto3d(oe.P[0], oe.P[1], 1.8)

    glx.DrawCubic(p3, 0.3, 0.3, 0.6, Color.Darker(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetGBColor(oE.Colour, oe.pLayer))

End
