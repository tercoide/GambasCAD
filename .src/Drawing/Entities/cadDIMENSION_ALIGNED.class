'' Cota alineada con los puntos medidos. DXF tipo 1
''   P[3] = 13   origen de la linea de referencia 1
''   P[4] = 14   origen de la linea de referencia 2
''   P[0] = 10   punto sobre la linea de cota
''   P[1] = 11   centro del texto

Create Static
Inherits CadDimension

Public Const Gender As String = "DIMENSION_ALIGNED"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert an aligned dimension")
Public Const ParamType As String = "PPP"
Public Const ParamHelper As String = "First point;Second point;Dimension line location"
Public Const DimTypeCode As Integer = 1
Public Const DxfSubclass As String = "AcDbAlignedDimension"
Public Const GripPoints As String = "3;4;0;1"
Public Const GripTips As String = ("Move first point;Move second point;Move dimension line;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If vParam[0] <> "point" Then Return False

    If gcd.StepsDone = 0 Then

        eBuild.P[3] = Me.ParamPoint(vParam)
        eBuild.P[4] = eBuild.P[3].Copy()
        eBuild.P[0] = eBuild.P[3].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then

        eBuild.P[4] = Me.ParamPoint(vParam)
        eBuild.P[0] = eBuild.P[4].Copy()
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Else If gcd.StepsDone = 2 Then

        eBuild.P[0] = Me.ParamPoint(vParam)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

Public Sub MakeBlock(e As Entity)

    cadDIMENSION_LINEAR.MakeLinear(e, Ang(e.P[4].x - e.P[3].x, e.P[4].y - e.P[3].y))

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv("AcDbAlignedDimension", "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)
    If e.fParam[Me.ipaObliqueAngle] <> 0 Then dxf.SaveCodeInv(CStr(e.fParam[Me.ipaObliqueAngle]), "52")

End
