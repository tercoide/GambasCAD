'' Cota de coordenada. DXF tipo 6
''   P[0] = 10   origen de las coordenadas
''   P[3] = 13   punto medido
''   P[4] = 14   fin de la directriz
''   P[1] = 11   centro del texto
''   bit 64 del codigo 70: mide X (la directriz es vertical); si no, mide Y

Create Static
Inherits CadDimension

Public Const Gender As String = "DIMENSION_ORDINATE"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert an ordinate dimension")
Public Const ParamType As String = "PPP"
Public Const ParamHelper As String = "Origin;Point to measure;Leader end"
Public Const DimTypeCode As Integer = 6
Public Const DxfSubclass As String = "AcDbOrdinateDimension"
Public Const GripPoints As String = "0;3;4;1"
Public Const GripTips As String = ("Move origin;Move measured point;Move leader end;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If vParam[0] <> "point" Then Return False

    If gcd.StepsDone = 0 Then           ' origen

        eBuild.P[0] = Me.ParamPoint(vParam)
        eBuild.P[3] = eBuild.P[0].Copy()
        eBuild.P[4] = eBuild.P[0].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then      ' punto medido

        eBuild.P[3] = Me.ParamPoint(vParam)
        eBuild.P[4] = eBuild.P[3].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 2 Then      ' fin de la directriz, que define si mide X o Y

        eBuild.P[4] = Me.ParamPoint(vParam)
        SetAxis(eBuild)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

'' Modo 1 mide X, modo 2 mide Y, si no depende de hacia donde va la directriz
Private Sub SetAxis(e As Entity)

    Dim bX As Boolean

    If e.iParam[Me.iiiMode] = 1 Then
        bX = True
    Else If e.iParam[Me.iiiMode] = 2 Then
        bX = False
    Else
        bX = Abs(e.P[4].y - e.P[3].y) >= Abs(e.P[4].x - e.P[3].x)
    Endif
    If bX Then
        e.iParam[Me.iiiDimType] = e.iParam[Me.iiiDimType] Or Me.DimFlagOrdinateX
    Else
        e.iParam[Me.iiiDimType] = e.iParam[Me.iiiDimType] And Not Me.DimFlagOrdinateX
    Endif

End

Public Sub GripMoved(e As Entity, iPoint As Integer)

    If iPoint = 4 Then SetAxis(e)

End

Public Sub MakeBlock(e As Entity)

    Dim d As DimStyle = e.pDimStyle
    Dim bX As Boolean
    Dim fValue, sgn, exo, k, th, tw, gap, tcx, tcy, ta, a, b As Float
    Dim sText As String

    bX = (e.iParam[Me.iiiDimType] And Me.DimFlagOrdinateX) <> 0
    If bX Then fValue = e.P[3].x - e.P[0].x Else fValue = e.P[3].y - e.P[0].y
    e.fParam[Me.ipaRealMeasure] = Abs(fValue) * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor
    sText = Me.LinearText(e, Abs(fValue))

    exo = d.DIMEXO * Me.DimScale(e)
    k = d.DIMASZ * Me.DimScale(e)
    th = Me.TextHeight(e)
    tw = Me.TextWidth(e, sText)
    gap = d.DIMGAP * Me.DimScale(e)

    ' trabajo en coordenadas a (a lo largo de la directriz) y b (de costado), y despues las paso a x,y
    If bX Then
        sgn = Sgn(e.P[4].y - e.P[3].y)
    Else
        sgn = Sgn(e.P[4].x - e.P[3].x)
    Endif
    If sgn = 0 Then sgn = 1

    If bX Then
        a = e.P[3].y + sgn * exo
        If Abs(e.P[4].x - e.P[3].x) < 1e-9 Then
            Me.AddLine(e, e.P[3].x, a, e.P[4].x, e.P[4].y, Me.PartExtLine)
        Else
            ' con quiebre
            b = e.P[4].y - sgn * k * 2
            If (b - a) * sgn < 0 Then b = a
            Me.AddLine(e, e.P[3].x, a, e.P[3].x, b, Me.PartExtLine)
            Me.AddLine(e, e.P[3].x, b, e.P[4].x, e.P[4].y - sgn * k, Me.PartExtLine)
            Me.AddLine(e, e.P[4].x, e.P[4].y - sgn * k, e.P[4].x, e.P[4].y, Me.PartExtLine)
        Endif
        ta = Pi / 2
        tcx = e.P[4].x
        tcy = e.P[4].y + sgn * (tw / 2 + gap)
    Else
        a = e.P[3].x + sgn * exo
        If Abs(e.P[4].y - e.P[3].y) < 1e-9 Then
            Me.AddLine(e, a, e.P[3].y, e.P[4].x, e.P[4].y, Me.PartExtLine)
        Else
            b = e.P[4].x - sgn * k * 2
            If (b - a) * sgn < 0 Then b = a
            Me.AddLine(e, a, e.P[3].y, b, e.P[3].y, Me.PartExtLine)
            Me.AddLine(e, b, e.P[3].y, e.P[4].x - sgn * k, e.P[4].y, Me.PartExtLine)
            Me.AddLine(e, e.P[4].x - sgn * k, e.P[4].y, e.P[4].x, e.P[4].y, Me.PartExtLine)
        Endif
        ta = 0
        tcx = e.P[4].x + sgn * (tw / 2 + gap)
        tcy = e.P[4].y
    Endif

    If Me.UserText(e) Then
        tcx = e.P[1].x
        tcy = e.P[1].y
    Endif
    If d.DIMTOH Then ta = 0

    Me.AddText(e, sText, tcx, tcy, ta)
    e.P[1].x = tcx
    e.P[1].y = tcy

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv(Me.DxfSubclass, "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)

End
