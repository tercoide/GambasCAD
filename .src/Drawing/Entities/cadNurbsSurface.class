' Gambas class file

' Superficie NURBS: producto tensorial de curvas NURBS en U y en V.
' La definicion (grilla de control, grados, nudos, pesos) esta en un NurbsSurface en e.pBlock.
' e.faces es solo su teselado: cuadrilateros de una grilla, rearmados por MakePolyLine.
' e.P[0] es el punto base donde se coloco la superficie.
'
' Por ahora se crea un parche de prueba de 4 x 4 puntos que sigue al mouse hasta que se elige el punto base;
' despues se le da forma con los grips de los puntos de control.
' En el DXF se guarda el teselado como MESH; la definicion NURBS solo se guarda en el .gcd.

Create Static
Inherits EntityBase

Public Const Gender As String = "NURBSSURFACE"
Public Const CmdLineHelper As String = ("NURBS surface (test patch): base point")
Public Const ParamType As String = "point3d"
Public Const ParamHelper As String = "point3d"
Public Const DrawingOrder As Integer = 1        ' 1 = draws first
Public Const Regenerable As Boolean = True
Public Const Is3D As Boolean = True
Public Const DxfName As String = "MESH"          ' en el DXF va el teselado, como MESH

Public Function NewEntity(Optional vPoints As Variant, bNewid As Boolean = False) As Entity

    Dim e As Entity

    e = Super.NewEntity(vPoints, bNewid)
    e.faces = New Face[]
    e.pBlock = TestPatch(e.P[0])

    Return e

End

'' A bicubic 4 x 4 patch of 3 x 3 units at the base point: the 4 inner points are raised
'' and one of them weighs more, so the surface is rational
Private Function TestPatch(pBase As Punto3d) As NurbsSurface

    Dim ns As New NurbsSurface
    Dim iu, iv As Integer
    Dim z As Float

    ns.CountU = 4
    ns.CountV = 4
    For iv = 0 To 3
        For iu = 0 To 3
            If iu > 0 And iu < 3 And iv > 0 And iv < 3 Then z = 1.5 Else z = 0
            ns.ControlPoints.Insert([pBase.x + iu, pBase.y + iv, pBase.z + z])
            ns.Weights.Add(1)
        Next
    Next
    ns.Weights[1 * 4 + 1] = 3                   ' tira de la superficie hacia el punto (1, 1)
    ns.KnotsU = puntos.UniformKnots(ns.CountU, ns.DegreeU)
    ns.KnotsV = puntos.UniformKnots(ns.CountV, ns.DegreeV)

    Return ns

End

'' The test patch follows the mouse until the base point is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim z As Float

    If vParam[0] <> "point3d" Then Return
    If vParam.Count > 3 Then z = vParam[3]

    Me.Translate(eBuild, vParam[1] - eBuild.P[0].x, vParam[2] - eBuild.P[0].y, z - eBuild.P[0].z)

    If Definitive Then Return ["command": "end"]

End

'' Builds the faces (a grid of quads), the 2D outline in Polygon used for picking and limits
Public Function MakePolyLine(e As Entity)

    Dim ns As NurbsSurface
    Dim nU, nV, i, j, k, kU, kV As Integer
    Dim fGrid As Float[]
    Dim aVertex As New Vertex[]
    Dim v As Vertex
    Dim f As Face

    If Not e.faces Then e.faces = New Face[]
    e.faces.Clear
    e.Polygon.Clear
    e.PolyLine.Clear
    ns = e.pBlock
    If Not ns Then Return

    nU = ns.SamplesU
    If nU < 1 Then nU = AutoSamples(ns, True)
    nV = ns.SamplesV
    If nV < 1 Then nV = AutoSamples(ns, False)

    fGrid = ns.Tessellate(nU, nV)
    If fGrid.Count = 0 Then Return

    ' un Vertex por punto de la grilla, compartido por las caras vecinas
    For k = 0 To fGrid.Max Step 3
        v = New Vertex(fGrid[k], fGrid[k + 1], fGrid[k + 2])
        aVertex.Add(v)
    Next

    ' wireframe: el borde y una isolinea cada kU / kV tramos
    kU = Max(1, nU \ 8)
    kV = Max(1, nV \ 8)

    For j = 0 To nV - 1
        For i = 0 To nU - 1
            f = New Face
            f.vertex.Add(aVertex[j * (nU + 1) + i])
            f.vertex.Add(aVertex[j * (nU + 1) + i + 1])
            f.vertex.Add(aVertex[(j + 1) * (nU + 1) + i + 1])
            f.vertex.Add(aVertex[(j + 1) * (nU + 1) + i])
            ' un booleano por lado; cada isolinea la dibuja una sola cara
            f.wireframe.Add(j Mod kV = 0)                       ' (i,j)-(i+1,j): isolinea en V y borde inicial
            f.wireframe.Add((i + 1) Mod kU = 0 Or i = nU - 1)   ' (i+1,j)-(i+1,j+1): isolinea en U y borde final
            f.wireframe.Add(j = nV - 1)                         ' (i+1,j+1)-(i,j+1): borde final en V
            f.wireframe.Add(i = 0)                              ' (i,j+1)-(i,j): borde inicial en U
            e.faces.Add(f)
        Next
    Next

    ' el contorno proyectado en XY, para OverMe y Limits
    For i = 0 To nU
        AddXY(e.Polygon, aVertex[i])
    Next
    For j = 1 To nV
        AddXY(e.Polygon, aVertex[j * (nU + 1) + nU])
    Next
    For i = nU - 1 DownTo 0
        AddXY(e.Polygon, aVertex[nV * (nU + 1) + i])
    Next
    For j = nV - 1 DownTo 0
        AddXY(e.Polygon, aVertex[j * (nU + 1)])
    Next

End

'' Number of segments in U (or V) from the longest control polygon in that direction, like SPLINE does
Private Function AutoSamples(ns As NurbsSurface, InU As Boolean) As Integer

    Dim a, b, i, k1, k2, n As Integer
    Dim fLen, fMax As Float

    For a = 0 To If(InU, ns.CountV, ns.CountU) - 1
        fLen = 0
        For b = 0 To If(InU, ns.CountU, ns.CountV) - 2
            If InU Then
                k1 = (a * ns.CountU + b) * 3
                k2 = k1 + 3
            Else
                k1 = (b * ns.CountU + a) * 3
                k2 = k1 + ns.CountU * 3
            Endif
            fLen += Sqr((ns.ControlPoints[k2] - ns.ControlPoints[k1]) ^ 2 + (ns.ControlPoints[k2 + 1] - ns.ControlPoints[k1 + 1]) ^ 2 + (ns.ControlPoints[k2 + 2] - ns.ControlPoints[k1 + 2]) ^ 2)
        Next
        If fLen > fMax Then fMax = fLen
    Next

    n = fMax / gcd.Metros(Config.ArcDensity)
    If n < 8 Then n = 8
    If n > 48 Then n = 48
    Return n

End

Private Sub AddXY(a As Float[], v As Vertex)

    a.Add(v.X)
    a.Add(v.Y)

End

Private Sub AddXYZ(a As Float[], v As Vertex)

    a.Add(v.X)
    a.Add(v.Y)
    a.Add(v.Z)

End

Public Sub Draw(e As Entity)

    Dim iColour As Integer

    iColour = gcd.GetGBColor(e.Colour, e.pLayer)
    DrawSurface(e, iColour, gcd.ColorRemark(iColour), e.pLayer.ShowWireframe)

End

Public Sub DrawRemark(e As Entity)

    Dim iColour As Integer

    iColour = gcd.GetGBColor(e.Colour, e.pLayer)
    DrawSurface(e, gcd.ColorRemark(iColour), iColour, e.pLayer.ShowWireframe)

End

Public Sub DrawSelected(e As Entity)

    Dim iColour As Integer

    iColour = gcd.GetGBColor(e.Colour, e.pLayer)
    DrawSurface(e, gcd.ColorSelected(iColour), iColour, e.pLayer.ShowWireframe)

End

Private Sub DrawSurface(e As Entity, iFaceColour As Integer, iLineColour As Integer, bWireframe As Boolean)

    Dim f As Face
    Dim i As Integer
    Dim fTriangles As New Float[]
    Dim fLines As New Float[]

    If Not e.faces Then Return

    For Each f In e.faces
        ' las caras son cuadrilateros: dos triangulos, sin pasar por la triangulacion general
        AddXYZ(fTriangles, f.vertex[0])
        AddXYZ(fTriangles, f.vertex[1])
        AddXYZ(fTriangles, f.vertex[2])
        AddXYZ(fTriangles, f.vertex[0])
        AddXYZ(fTriangles, f.vertex[2])
        AddXYZ(fTriangles, f.vertex[3])

        If bWireframe Then
            For i = 0 To 3
                If f.wireframe[i] Then
                    AddXYZ(fLines, f.vertex[i])
                    AddXYZ(fLines, f.vertex[(i + 1) Mod 4])
                End If
            Next
        End If
    Next

    glx.DrawTriangles3D(fTriangles, iFaceColour)
    If fLines.Count > 0 Then glx.DrawLines3D(fLines, iLineColour)

End

Public Sub Finish(e As Entity) As Boolean

    If Not e.faces Then e.faces = New Face[]
    If e.faces.Count = 0 Then Me.BuildGeometry(e)
    e.Psel.Resize(e.P.Count)

End

' Las transformaciones se aplican a los puntos de control y despues se rearma el teselado

'' Moves the whole surface (a stretch also moves all of it)
Public Sub Translate(e As Entity, dX As Float, dY As Float, dZ As Float, Optional OnlySelected As Boolean = False)

    Dim ns As NurbsSurface
    Dim i As Integer

    ns = e.pBlock
    For i = 0 To ns.ControlPoints.Count - 3 Step 3
        ns.ControlPoints[i] += dX
        ns.ControlPoints[i + 1] += dY
        ns.ControlPoints[i + 2] += dZ
    Next
    puntos.TranslateP(e.P, dX, dY, dZ)
    Me.BuildGeometry(e)

End

'' Rotates around the Z axis
Public Sub Rotate(e As Entity, radians As Float)

    Dim ns As NurbsSurface
    Dim i As Integer
    Dim s, c, x As Float

    ns = e.pBlock
    s = Sin(radians)
    c = Cos(radians)
    For i = 0 To ns.ControlPoints.Count - 3 Step 3
        x = ns.ControlPoints[i] * c - ns.ControlPoints[i + 1] * s
        ns.ControlPoints[i + 1] = ns.ControlPoints[i] * s + ns.ControlPoints[i + 1] * c
        ns.ControlPoints[i] = x
    Next
    puntos.RotateP(e.P, radians)
    Me.BuildGeometry(e)

End

Public Sub Scale(e As Entity, sX As Float, sY As Float, Optional sZ As Float = 1)

    Dim ns As NurbsSurface
    Dim i As Integer

    ns = e.pBlock
    For i = 0 To ns.ControlPoints.Count - 3 Step 3
        ns.ControlPoints[i] *= sX
        ns.ControlPoints[i + 1] *= sY
        ns.ControlPoints[i + 2] *= sZ
    Next
    puntos.ScaleP(e.P, sX, sY, sZ)
    Me.BuildGeometry(e)

End

'' Crea una nueva entidad a partir de otra, con su propia copia del NurbsSurface
Public Sub ClonEntity(eOrigen As Entity, Optional GetNewid As Boolean = True) As Entity

    Dim e As Entity

    e = Super.ClonEntity(eOrigen, GetNewid)
    e.pBlock = eOrigen.pBlock.Copy()
    e.faces = New Face[]
    Me.BuildGeometry(e)
    Return e

End

'' One grip per control point, and a move grip at the center of the control net
Public Function GenerateGrips(e As Entity) As Integer

    Dim ns As NurbsSurface
    Dim g As Grip
    Dim i, iCount As Integer
    Dim x, y, z As Float

    ns = e.pBlock
    For i = 0 To ns.ControlPoints.Count - 3 Step 3
        g = New Grip
        g.Shape = 0
        g.p = puntos.P3d(ns.ControlPoints[i], ns.ControlPoints[i + 1], ns.ControlPoints[i + 2])
        g.pRef = g.p.Copy()
        g.Action = 0 ' mover
        g.AsociatedEntity = e
        g.AsociatedPoint = iCount
        g.ToolTip = ("Move control point")
        gcd.Drawing.Sheet.Grips.Add(g)
        x += g.p.x
        y += g.p.y
        z += g.p.z
        Inc iCount
    Next
    If iCount = 0 Then Return 0

    g = New Grip
    g.Shape = 1
    g.p = puntos.P3d(x / iCount, y / iCount, z / iCount)
    g.pRef = g.p.Copy()
    g.Action = 0
    g.AsociatedEntity = e
    g.AsociatedPoint = -1
    g.ToolTip = ("Move surface")
    gcd.Drawing.Sheet.Grips.Add(g)

    Return iCount + 1

End

'' Moves a control point, or the whole surface with the move grip. cadSelection rebuilds the geometry after this.
Public Function GripEdit(g As Grip) As Boolean

    Dim e As Entity
    Dim ns As NurbsSurface
    Dim i As Integer

    e = g.AsociatedEntity
    If g.AsociatedPoint < 0 Then
        Me.Translate(e, g.p.x - g.pRef.x, g.p.y - g.pRef.y, g.p.z - g.pRef.z)
        g.pRef = g.p.Copy()
    Else
        ns = e.pBlock
        i = g.AsociatedPoint * 3
        ns.ControlPoints[i] = g.p.x
        ns.ControlPoints[i + 1] = g.p.y
        ns.ControlPoints[i + 2] = g.p.z
    Endif

End

'' While a grip is dragged, the surface and its control net
Public Sub DrawEditing(g As Grip)

    Dim e As Entity
    Dim ns As NurbsSurface
    Dim iu, iv, k As Integer
    Dim fLines As New Float[]

    e = g.AsociatedEntity
    Me.Draw(e)

    ns = e.pBlock
    For iv = 0 To ns.CountV - 1
        For iu = 0 To ns.CountU - 1
            k = (iv * ns.CountU + iu) * 3
            If iu < ns.CountU - 1 Then
                fLines.Insert(ns.ControlPoints.Copy(k, 3))
                fLines.Insert(ns.ControlPoints.Copy(k + 3, 3))
            Endif
            If iv < ns.CountV - 1 Then
                fLines.Insert(ns.ControlPoints.Copy(k, 3))
                fLines.Insert(ns.ControlPoints.Copy(k + ns.CountU * 3, 3))
            Endif
        Next
    Next
    If fLines.Count > 0 Then glx.DrawLines3D(fLines, gcd.ColorSelected(gcd.GetGBColor(e.Colour, e.pLayer)))

End

'' The tessellation as an AutoCAD MESH (DxfName); reading it back gives a MESH, not a NURBS surface
Public Function SaveDxfData(e As Entity) As Boolean

    cadMesh.SaveDxfFaces(e.faces)
    Return True

End

'' Saves the definition, not the faces: Finish rebuilds them
Public Function SaveJsonData(e As Entity, j As Collection) As Boolean

    j["pts"] = puntos.ToXYZ(e.P)
    j["nurbs"] = JsonFile.ObjectToJson(e.pBlock)
    Return True

End

Public Function ImportJson(e As Entity, c As Collection) As Boolean

    Dim ns As New NurbsSurface

    Super.ImportJson(e, c)
    JsonFile.JsonToObject(ns, c["nurbs"])
    e.pBlock = ns
    e.faces = New Face[]
    Return True

End
