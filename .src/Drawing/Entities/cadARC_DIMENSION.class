'' Cota de largo de arco (entidad ARC_DIMENSION del DXF)
''   P[5] = 15   centro del arco medido
''   P[3] = 13   comienzo del arco medido
''   P[4] = 14   fin del arco medido
''   P[0] = 10   ubicacion del arco de cota
''   P[1] = 11   centro del texto
''   fParam[ipaArcStart], fParam[ipaArcEnd]: DXF 40 y 41, angulos en radianes

Create Static
Inherits CadDimension

Public Const Gender As String = "ARC_DIMENSION"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert an arc length dimension")
Public Const ParamType As String = "PPPP"
Public Const ParamHelper As String = "Center of the arc;Start of the arc;End of the arc;Dimension location"
Public Const DimTypeCode As Integer = 8
Public Const DxfSubclass As String = "AcDbArcDimension"
Public Const GripPoints As String = "5;3;4;0;1"
Public Const GripTips As String = ("Move center;Move start;Move end;Move dimension arc;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Return cadDIMENSION_ANG3PT.NewParameter(eBuild, vParam, Definitive)

End

Public Sub MakeBlock(e As Entity)

    cadDIMENSION_ANG3PT.MakeAngular(e, True)

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv(Me.DxfSubclass, "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)
    Me.SavePoint(e, 5)
    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaArcStart]), "40")
    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaArcEnd]), "41")
    dxf.SaveCodeInv("0", "70")                  ' no es parcial
    dxf.SaveCodeInv("0", "71")                  ' sin directriz

End
