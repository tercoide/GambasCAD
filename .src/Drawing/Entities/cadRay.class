Create Static
'Fast
Inherits CadLine
Public Const Gender As String = "RAY"
Public Const DrawingOrder As Integer = 1        ' 1 = draws first
Public Const CmdLineHelper As String = ("an infinite ray")
' Public Const ParamType As String = "PPoint"                             ' that is Point, Point; could be Color Text, etc
' Public Const ParamHelper As String = "start"

Private p2 As New Float[]

Private Sub MakeRay(p As Punto3d[])

    p2.Clear

    If Me.ExpectedParam = "start" Then Return

    p2.Add(P[0].x)
    p2.Add(P[0].y)
    p2.Add(P[0].z)

    p2.Add((P[1].x - p[0].x) * 1e10)
    p2.Add((P[1].y - p[0].y) * 1e10)
    p2.Add((P[1].z - p[0].z) * 1e10)

    p2.Add(P[0].x)
    p2.Add(P[0].y)
    p2.Add(P[0].z)

    p2.Add((P[1].x - p[0].x) * -1e10)
    p2.Add((P[1].y - p[0].y) * -1e10)
    p2.Add((P[1].z - p[0].z) * -1e10)

End

Public Sub Draw(oE As Entity)

    If Not oE.Visible Then Return

    MakeRay(oe.p)

    glx.DrawLines3D(p2, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

'' A fat version of the line
Public Sub DrawSelected(oE As Entity)

    ' If oe.LineType = gcd.stiDashed Then iLineType = 0 Else iLineType = gcd.stiDashed
    MakeRay(oe.p)

    'glx.DrawLines(p2, config.WindowBackColor, gcd.GetLineWt(oE.LineWIdth, oe.pLayer), iLineType)

    glx.DrawLines3D(p2, Gcd.ColorSelected(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End
'' A fat version of the line

Public Sub DrawRemark(oE As Entity)

    If Not oE.Visible Then Return

    MakeRay(oe.P)

    glx.DrawLines3D(P2, Gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oE.LineType.TrameLength)

End

'' The paint version of the entity
Public Function Draw2(oE As Entity)

    paint.MoveTo(oE.P[0].x, oE.P[0].y)
    paint.LineTo(oE.P[1].x, oE.P[1].y)
    paint.Stroke

End

Public Function SaveDxfData(e As Entity) As Boolean

    ' stxExport.insert(["RAY", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCodeInv("AcDbRay", "100")
    dxf.SaveCodeInv(CStr(e.P[0].x), dxf.codX0)  ' Start
    dxf.SaveCodeInv(CStr(e.P[0].y), dxf.codY0)
    dxf.SaveCodeInv(CStr(e.P[1].x), DXF.codX1)  ' End
    dxf.SaveCodeInv(CStr(e.P[1].y), dxf.codY1)

End
