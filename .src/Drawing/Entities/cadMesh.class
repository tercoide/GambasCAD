Public Sub Draw(oE As Entity)

    Dim fPoints As Float[]
    Dim fColor4 As Integer
    Dim bIntersects As Boolean
    Dim f As Face
    Dim pTriangles As Punto3d
    Dim fTriangles As Float[]

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 0, 0, oe.pLayer.ShowWireframe)

    Next

    If oe.pLayer.ShowWireframe Then
        If f.wireframe.Count > 0 Then
            fPoints = puntos.ToXYZ(Wireframe(oe))    ' paso de Punto3D a XYZ triplets
            glx.PolyLines(fPoints, gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)))
        End If

    End If

End

Public Sub DrawRemark(oE As Entity)

    Dim f As Face

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 1, 0, oe.pLayer.ShowWireframe)

    Next

End

Public Sub DrawSelected(oE As Entity)

    Dim f As Face

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 2, 0, oe.pLayer.ShowWireframe)

    Next

End

'' Crea una nueva entidad a partir de otra. Opcionalmente nueva Handle y un bloque nuevo si es que tiene.
Public Sub ClonEntity(eOrigen As Entity, Optional GetNewid As Boolean = True) As Entity
    ' clona una entidad
    ' copia todos sus elementos
    ' llama a las rutinas de reconstruccion del contorno y de los POI

    Dim e As Entity

    e = Super.ClonEntity(eOrigen, GetNewid)
    Dim f, fn As Face
    Dim v, vn As Vertex
    ClearFlags(e)
    For Each f In eOrigen.faces
        fn = New Face
        e.faces.Add(fn)
        For Each v In f.vertex
            ' If v.WasMoved Then
            '     vn = v
            ' Else
            '
            '     v.WasMoved = True
            '     vn = gcd.NewVertex(v.X, v.Y, v.z, True)
            ' End If
            fn.vertex.Add(v.Copy())
        Next

        fn.wireframe.Insert(f.wireframe.Copy())

    Next
    ClearFlags(e)
    Return e

End

Public Sub Finish(e As Entity) As Boolean

    Dim f As Face
    Dim v As Vertex

    For Each f In e.faces

        f.wireframe.Resize(f.vertex.Count)
        If f.wireframe.Count > 0 Then f.wireframe.Fill(True)
    Next

    For Each f In e.faces

        gcd.Drawing.Sheet.Faces.Add(f, e.id)
    Next

    Super.Finish(e)

End

