' Gambas class file

' P[] son los vertices, puede haber vertices comunes pare varias caras.
' iParam[] son las caras triangulares, donde si ambos indices son -negativos, esa arista no se dibuja en el wireframe

Inherits CadLWPolyline
Public Const Is3D As Boolean = True

Public Function NewEntity(Optional fPoints As Float[], bNewid As Boolean = False) As Entity

    Dim e As Entity

    e = Super.NewEntity(fPoints, bNewid)
    e.pBlock = New Obj3d

End

