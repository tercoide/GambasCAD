' Gambas class file

' Esta clase representa una cara plana en el espacio
' Podria pensarse como una LWPolyline cerrada, pero no es alambrica sino llena.
' El minimo numero de lados es 3. Si tiene mas lados, seran triangulados internamente creando mas lados invisibles.

Inherits EntityBase
Public Const Gender As String = "MESH"
    ""
Public Const DrawingOrder As Integer = 1        ' 1 = draws first
Public Const CmdLineHelper As String = ("a polyface of segments: First point: ")
Public Const ParamType As String = "point3d"                             ' that is Point, Point, Float; could be Color Text, etc
Public Const ParamHelper As String = "point"      ' a little text that is shown at the prompt waiting for user input during build
Public Const ParamDefault As String = "Close/Undo"
Public Const ContextMenu As String = ("Close polyline;_CLOSE;;;Undo last point;_UNDO;;;End in last point;_ENDP;;") ' el menu para el boton derecho, los comandos
Public Const Is3D As Boolean = True

Public Function NewEntity(Optional fPoints As Float[], bNewid As Boolean = False) As Entity

    Dim e As New Entity
    Dim f As Face

    e = Super.NewEntity(fPoints, bNewid)
    e.Gender = Me.Gender

    e.pBlock = New PoliFace
    f = New Face
    e.pBlock.Faces.Add(f)

    Return e

End

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim p As Punto3d
    Dim comm As New Communications
    Dim f As Face
    ' ' 'If Definitive Then Stop
    ' If eBuild.Gender = Gender Then ' es polyface
    '     f = eBuild.pBlock
    ' Else

    f = eBuild.pBlock.faces[0]
    ' End If

    If f.vertex.Count = 0 Then
        p = gcd.NewVertex(0, 0, 0)
        f.vertex.Add(p)
        f.colour = eBuild.Colour
    End If
    If Me.ExpectedParam = "point"
        If vParam[0] = "point3d" Then

            f.vertex.Last.x = vParam[1]
            f.vertex.Last.y = vParam[2]
            f.vertex.Last.z = vParam[3]

            If Definitive Then

                p = gcd.NewVertex(f.vertex.Last.x, f.vertex.Last.y, f.vertex.Last.z, True)

                p = New Punto3d
                f.vertex.Add(p)

                comm.Prompt = "Next point"
                comm.ParamType = "point3d"
                comm.Options.Add("End")
                comm.Options.Add("Close")

                Return comm
            End If

        Else If vParam[0] = "text" Then

            If vParam[1] = "_UNDO" Then
                f.vertex.Remove(f.vertex.Max)
                Return comm
            Else If vParam[1] = "_ENDP" Or vParam[1] = "_CLOSE" Then
                f.vertex.Last.x = f.vertex.First.x
                f.vertex.Last.y = f.vertex.First.y
                f.vertex.Last.z = f.vertex.First.z
                f.vertex.Remove(f.vertex.Max)
                f.Id = gcd.NewId()

                Return ["command": "end"]

            Endif
        End If
    End If

End

