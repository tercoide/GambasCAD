Public Sub Draw(oE As Entity)

    clsEntities.DrawFace(oe.pBlock.faces[0], 0,, True)

End

Public Sub DrawRemark(oE As Entity)

    clsEntities.DrawFace(oe.pBlock.faces[0], 1,, True)

End

Public Sub Finish(e As Entity) As Boolean

    gcd.Drawing.Sheet.Faces.Add(e.pBlock.faces[0], e.pBlock.faces[0].id)

    Super.Finish(e)

End

'' Return if that position is over the entity within the tolerance
Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    ' debo transformar la cara 3D en puntos 2D segun la proyeccion
    Dim x, y As Integer
    Dim rDist As Float

    x = gcd.XPix(xr)            ' coordenadas de pantalla en pixeles
    y = gcd.YPix(yr)

    Dim ray As New Float[3]                             ' es un rayo que atraviesa la pantalla en la posicion del mouse
    ray = glx.Get3DpointFromScreen(x, y)

    Dim origen, direccion, hit As New Punto3d
    origen.x = xr 'ray[0]
    origen.y = yr' ray[1]
    origen.z = 1'ray[2]               ' ??

    direccion.x = 0                 ' Valores del 2D XY
    direccion.y = 0
    direccion.z = -1

    Dim inside As Boolean
    inside = puntos.RayPolygonIntersection3D(origen, direccion, e.pBlock.faces[0].vertex, hit)
    If inside Then
        Debug hit.x, hit.y, hit.z
    Endif
    'inside = puntos.RayConcavePolygonIntersect(origen, gcd.Drawing.Sheet.camera.ViewDir, e.pBlock.vertex, rDist)
    'Return inside

    If e.Polygon Then
        If puntos.isInside(puntos.RemoveAxisP3(e.pBlock.faces[0].vertex), xr, yr) Then Return True
    End If

    Return False

End

Public Function SaveDxfData(e As Entity) As Boolean

    Dim i, IMAX As Integer
    Dim f As Face
    Dim p, p2 As Punto3d
    Dim loTengo As Boolean

    ' stxExport.insert(["LWPOLYLINE", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCode("100", "AcDbSubMesh")
    dxf.SaveCode("71", "2")                                         ' version de la entidad Mesh
    dxf.SaveCode("72", "0")                                         ' bordes
    dxf.SaveCode("91", "0")                                         ' Tipo de malla 0=facetada 1=suavizado 2=nose 3=nose

    ' ahora van los vertices, pero la idea es no repetirlos, entonces hago una lista unica
    Dim vertexlist As New Punto3d[]
    For Each f In e.pBlock.faces
        For Each p In f.vertex
            For Each p2 In vertexlist
                If p = p2 Then ' es el mismo vertex
                    loTengo = True
                    Break
                End If

            Next
            If Not lotengo Then
                vertexlist.Add(p)
                lotengo = False
            Endif
        Next
    Next
    ' ahora que los recolecte, los guardo
    dxf.SaveCode("92", Str(vertexlist.Count))
    For Each p In vertexlist
        dxf.SaveCode("10", p.x)
        dxf.SaveCode("20", p.y)
        dxf.SaveCode("30", p.z)
    Next
    dxf.SaveCode("93", e.pBlock.faces.count)
    For Each f In e.pBlock.faces
        dxf.SaveCode("94", f.vertex.Count)
        For Each p In f.vertex                          ' busco el indice
            For i = 0 To vertexlist.Max
                If vertexlist[i] = p Then Break
            Next
            If i = vertexlist.count Then Stop
            dxf.SaveCode("90", i + 1)                   ' guardo el indice (a partir de 1)
        Next
    Next

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i, iv, nv, ifa, posv As Integer
    Dim n, np, nf As Integer
    Dim p As Punto3d
    Dim f As Face

    i = dxf.ReadCode(92, sClaves, sValues, n)                   ' nro de puntos
    Dim p3d As New Punto3d[n]
    For Each p In p3d
        i = dxf.ReadCode(10, sClaves, sValues, p.x, i)          ' x y z
        i = dxf.ReadCode(20, sClaves, sValues, p.y, i)
        i = dxf.ReadCode(30, sClaves, sValues, p.z, i)
    Next
    i = dxf.ReadCode(93, sClaves, sValues, ByRef nf, i)          ' nro de caras
    For ifa = 1 To nf
        f = New Face
        e.pBlock.faces.Add(f)
        i = dxf.ReadCode(94, sClaves, sValues, ByRef nv, i)      ' nro de vertices en esta cara
        For iv = 1 To n
            i = dxf.ReadCode(94, sClaves, sValues, ByRef posv, i)  ' vertice
            f.vertex.Add(p[posv])
        Next
    Next

    Return True

    ' catch

    Return False

End
