Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    Return False

End

Public Function SaveDxfData(e As Entity) As Boolean

    Dim i As Integer
    Dim f As Face
    Dim p, p2 As Vertex
    Dim loTengo As Boolean

    ' stxExport.insert(["LWPOLYLINE", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCode("100", "AcDbSubMesh")
    dxf.SaveCode("71", "2")                                         ' version de la entidad Mesh
    dxf.SaveCode("72", "0")                                         ' bordes
    dxf.SaveCode("91", "0")                                         ' Tipo de malla 0=facetada 1=suavizado 2=nose 3=nose

    ' ahora van los vertices, pero la idea es no repetirlos, entonces hago una lista unica
    Dim vertexlist As New Punto3d[]
    For Each f In e.faces
        For Each p In f.vertex
            For Each p2 In vertexlist
                If p = p2 Then ' es el mismo vertex
                    loTengo = True
                    Break
                End If

            Next
            If Not lotengo Then
                vertexlist.Add(p)
                lotengo = False
            Endif
        Next
    Next
    ' ahora que los recolecte, los guardo
    dxf.SaveCode("92", Str(vertexlist.Count))
    For Each p In vertexlist
        dxf.SaveCode("10", p.x)
        dxf.SaveCode("20", p.y)
        dxf.SaveCode("30", p.z)
    Next
    dxf.SaveCode("93", e.faces.count)
    For Each f In e.faces
        dxf.SaveCode("94", f.vertex.Count)
        For Each p In f.vertex                          ' busco el indice
            For i = 0 To vertexlist.Max
                If vertexlist[i] = p Then Break
            Next
            If i = vertexlist.count Then Stop
            dxf.SaveCode("90", i + 1)                   ' guardo el indice (a partir de 1)
        Next
    Next

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i, iv, nv, ifa, posv As Integer
    Dim n, np, nf As Integer
    Dim p As Vertex
    Dim f As Face

    'Stop
    i = dxf.ReadCode(92, sClaves, sValues, ByRef n)                   ' nro de puntos
    Dim p3d As New Vertex[n]
    For np = 0 To p3d.Max
        p = New Vertex
        i = dxf.ReadCode(10, sClaves, sValues, ByRef p.x, i)          ' x y z
        i = dxf.ReadCode(20, sClaves, sValues, ByRef p.y, i)
        i = dxf.ReadCode(30, sClaves, sValues, ByRef p.z, i)
        p3d[np] = p
    Next
    i = dxf.ReadCode(93, sClaves, sValues, ByRef nf, i)          ' nro de caras
    e.faces.clear
    For ifa = 1 To nf
        f = New Face
        e.faces.Add(f)

        F.Id = gcd.NewId()
        i = dxf.ReadCode(94, sClaves, sValues, ByRef nv, i)      ' nro de vertices en esta cara
        For iv = 1 To n

            i = dxf.ReadCode(90, sClaves, sValues, ByRef posv, i)  ' vertice
            Inc i
            f.vertex.Add(p3d[posv - 1])
        Next

    Next
    Stop
    Return True

    ' catch

    Return False

End

Public Sub Translate(e As Entity, dX As Float, dY As Float, dZ As Float, Optional OnlySelected As Boolean = False)

    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ClearFlags(e)

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For Each v In f.vertex
            If (Not OnlySelected Or (OnlySelected And v.IsSelected)) And Not v.WasMoved Then
                v.x += dx
                v.y += dy
                v.z += dz
                v.WasMoved = True
            End If
        Next

    Next
    ClearFlags(e)
    ' Endif
    '
    ' puntos.Translate(e.Polygon, dx, dy)
    ' puntos.Translate(e.PolyLine, dx, dy)
    Me.BuildGeometry(e)

End

Public Sub ClearFlags(e As Entity)

    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For Each v In f.vertex
            v.WasMoved = False
            v.IsSelected = False
        Next

    Next

End

Public Function Wireframe(e As Entity) As Punto3d[]

    Dim w As New Punto3d[]
    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For i = 1 To f.vertex.Count
            If f.wireframe[i - 1] Then ' agrego el tramo
                w.Add(f.vertex[i - 1].pPunto3D)
                If i = f.vertex.Count Then
                    w.Add(f.vertex[0].pPunto3D)
                Else
                    w.Add(f.vertex[i].pPunto3D)
                End If
            End If
        Next

    Next
    Return w

End
