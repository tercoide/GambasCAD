Public Sub Draw(oE As Entity)

    Dim fPoints As Float[]
    Dim fColor4 As Integer
    Dim bIntersects As Boolean
    Dim f As Face
    Dim pTriangles As Punto3d
    Dim fTriangles As Float[]

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 0, 0, oe.pLayer.ShowWireframe)

    Next

    If oe.pLayer.ShowWireframe Then
        fPoints = puntos.ToXYZ(Wireframe(oe))    ' paso de Punto3D a XYZ triplets, de a pares: un tramo cada dos puntos
        If fPoints.Count > 0 Then glx.DrawLines3D(fPoints, gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)))

    End If

End

Public Sub DrawRemark(oE As Entity)

    Dim f As Face

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 1, 0, oe.pLayer.ShowWireframe)

    Next

End

Public Sub DrawSelected(oE As Entity)

    Dim f As Face

    For Each f In oe.faces

        clsEntities.DrawFace(f, gcd.GetGBColor(oE.Colour, oe.pLayer), 2, 0, oe.pLayer.ShowWireframe)

    Next

End

'' Crea una nueva entidad a partir de otra. Opcionalmente nueva Handle y un bloque nuevo si es que tiene.
Public Sub ClonEntity(eOrigen As Entity, Optional GetNewid As Boolean = True) As Entity
    ' clona una entidad
    ' copia todos sus elementos
    ' llama a las rutinas de reconstruccion del contorno y de los POI

    Dim e As Entity

    e = Super.ClonEntity(eOrigen, GetNewid)
    Dim f, fn As Face
    Dim v, vn As Vertex
    ClearFlags(e)
    For Each f In eOrigen.faces
        fn = New Face
        e.faces.Add(fn)
        For Each v In f.vertex
            ' If v.WasMoved Then
            '     vn = v
            ' Else
            '
            '     v.WasMoved = True
            '     vn = gcd.NewVertex(v.X, v.Y, v.z, True)
            ' End If
            fn.vertex.Add(v.Copy())
        Next

        fn.wireframe.Insert(f.wireframe.Copy())

    Next
    ClearFlags(e)
    Return e

End

Public Sub Finish(e As Entity) As Boolean

    Dim f As Face
    Dim v As Vertex

    For Each f In e.faces

        f.wireframe.Resize(f.vertex.Count)
        If f.wireframe.Count > 0 Then f.wireframe.Fill(True)
    Next

    For Each f In e.faces

        gcd.Drawing.Sheet.Faces.Add(f, e.id)
    Next

    Super.Finish(e)

End

Public Sub MakePolyLine(e As Entity)

End

'' Return if that position is over the entity within the tolerance
Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    Return False

End

Public Function SaveDxfData(e As Entity) As Boolean

    SaveDxfFaces(e.faces)
    Return True

End

'' Writes the faces as an AutoCAD MESH (AcDbSubDMesh): the vertex list, then the face list with,
'' for each face, its vertex count and its 0-based vertex indices. Coincident vertices are merged.
Public Sub SaveDxfFaces(aFaces As Face[])

    Dim cIndex As New Collection
    Dim aVertex As New Vertex[]
    Dim aList As New Integer[]
    Dim f As Face
    Dim v As Vertex
    Dim i As Integer
    Dim sKey As String

    For Each f In aFaces
        If f.vertex.Count < 3 Then Continue
        aList.Add(f.vertex.Count)
        For Each v In f.vertex
            sKey = CStr(v.X) & " " & CStr(v.Y) & " " & CStr(v.Z)
            If Not cIndex.Exist(sKey) Then
                cIndex.Add(aVertex.Count, sKey)
                aVertex.Add(v)
            Endif
            aList.Add(cIndex[sKey])
        Next
    Next

    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCode("100", "AcDbSubDMesh")
    dxf.SaveCode("71", "2")                                         ' version de la entidad Mesh
    dxf.SaveCode("72", "0")                                         ' blend crease
    dxf.SaveCode("91", "0")                                         ' nivel de subdivision
    dxf.SaveCode("92", CStr(aVertex.Count))
    For Each v In aVertex
        dxf.SaveCode("10", CStr(v.X))
        dxf.SaveCode("20", CStr(v.Y))
        dxf.SaveCode("30", CStr(v.Z))
    Next
    dxf.SaveCode("93", CStr(aList.Count))                           ' largo de la lista de caras
    For Each i In aList
        dxf.SaveCode("90", CStr(i))
    Next
    dxf.SaveCode("94", "0")                                         ' aristas
    dxf.SaveCode("95", "0")                                         ' pliegues
    dxf.SaveCode("90", "0")                                         ' subentidades con propiedades propias

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i, k, n, nList, nv, iv, posv As Integer
    Dim p As Vertex
    Dim f As Face
    Dim p3d As Vertex[]

    ' AcDbSubDMesh: 92 cantidad de vertices, 10/20/30 los vertices, 93 largo de la lista de caras,
    ' y despues en codigos 90, por cada cara: su cantidad de vertices y sus indices (desde 0)
    i = dxf.ReadCode(92, sClaves, sValues, ByRef n)
    If i < 0 Then Return False
    p3d = New Vertex[n]
    For k = 0 To n - 1
        p = New Vertex
        i = dxf.ReadCode(10, sClaves, sValues, ByRef p.x, i)
        i = dxf.ReadCode(20, sClaves, sValues, ByRef p.y, i)
        i = dxf.ReadCode(30, sClaves, sValues, ByRef p.z, i)
        If i < 0 Then Return False
        p3d[k] = p
    Next

    i = dxf.ReadCode(93, sClaves, sValues, ByRef nList, i)
    If i < 0 Then Return False
    e.faces = New Face[]
    k = 0
    While k < nList
        i = dxf.ReadCode(90, sClaves, sValues, ByRef nv, i + 1)
        If i < 0 Then Return False
        Inc k
        f = New Face
        f.Id = gcd.NewId()
        For iv = 1 To nv
            i = dxf.ReadCode(90, sClaves, sValues, ByRef posv, i + 1)
            If i < 0 Then Return False
            Inc k
            If posv >= 0 And posv < n Then f.vertex.Add(p3d[posv])
        Next
        If f.vertex.Count >= 3 Then e.faces.Add(f)
    Wend
    Return True

End

Public Sub Translate(e As Entity, dX As Float, dY As Float, dZ As Float, Optional OnlySelected As Boolean = False)

    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ClearFlags(e)

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For Each v In f.vertex
            If (Not OnlySelected Or (OnlySelected And v.IsSelected)) And Not v.WasMoved Then
                v.x += dx
                v.y += dy
                v.z += dz
                v.WasMoved = True
            End If
        Next

    Next
    ClearFlags(e)
    ' Endif
    '
    ' puntos.Translate(e.Polygon, dx, dy)
    ' puntos.Translate(e.PolyLine, dx, dy)
    Me.BuildGeometry(e)

End

Public Sub ClearFlags(e As Entity)

    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For Each v In f.vertex
            v.WasMoved = False
            v.IsSelected = False
        Next

    Next

End

Public Function Wireframe(e As Entity) As Punto3d[]

    Dim w As New Punto3d[]
    Dim i As Integer
    Dim f As Face
    Dim v As Vertex
    Dim p As Vertex

    ' Tener en cuenta que los puntos son Ref entonces pueden recibir movimientos varias veces !!!
    For Each f In e.faces
        For i = 1 To f.vertex.Count
            If f.wireframe[i - 1] Then ' agrego el tramo
                w.Add(f.vertex[i - 1].pPunto3D)
                If i = f.vertex.Count Then
                    w.Add(f.vertex[0].pPunto3D)
                Else
                    w.Add(f.vertex[i].pPunto3D)
                End If
            End If
        Next

    Next
    Return w

End
