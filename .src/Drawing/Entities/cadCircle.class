Create Static

'Fast
Inherits EntityBase

Public Const Gender As String = "CIRCLE"
Public Const CmdLineHelper As String = ("Draw a circle: center point")
Public Const ParamType As String = "point3d"                             ' that is Point, Point, Float; could be Color Text, etc
Public Const ParamHelper As String = "center"      ' a little text that is shown at the prompt waiting for user input during build
Public Const ParamDefault As String = "0"
Public Const TotalParams As Integer = 1
Public Const Regenerable As Boolean = True

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is setc
' En 3D solo puede dibujarse un circulo en una cara

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    eBuild.Is3D = gcd.Drawing.Sheet.Is3D
    If eBuild.Is3D Then eBuild.p3 = New Punto3d[]
    If Me.ExpectedParam = "center" Then

        If (vParam[0] <> "point3d") Then Return
        puntos.ResizeP(eBuild.P, 1)

        Try eBuild.P[0].x = vParam[1]
        Try eBuild.P[0].y = vParam[2]
        Try eBuild.P[0].z = vParam[3]

        If Definitive Then
            eBuild.fParam.Add(0)
            Me.ExpectedParam = "radius"
            Return ["prompt": "enter radius", "next": "lenght"]
        End If
    Else If Me.ExpectedParam = "radius" Then

        If vParam[0] <> "float" Then Return

        eBuild.fParam[0] = vParam[1]

        If Definitive Then Return ["command": "end"]

    End If

    Return

End

Public Sub Scale(e As Entity, sX As Float, sY As Float, Optional sZ As Float = 1)

    E.fParam[0] *= (sX + sy + sz) / 3
    puntos.ScaleP(e.P, sx, sy, sz)

End

Public Sub Draw(oE As Entity)

    If Not oE.Visible Then Return

    glx.PolyLines(oe.PolyLine, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

    ' clsEntities.VboEntityDone(oe)

End

Public Sub makepolyline(oe As Entity)

    Dim x, y, theta, angle_increment As Float
    Dim iTramos As Integer
    Dim centro3 As Punto3d
    Dim px As Punto3D
    Dim PolyAux As New Float[]

    If oE.fParam[0] = 0 Then Return

    ' If oe.id = "DB8C" Then Stop
    iTramos = oE.fParam[0] * 2 * Pi / gcd.metros(Config.ArcDensity)

    If iTramos < 6 Then iTramos = 18
    If iTramos > 360 Then iTramos = 360
    angle_increment = 2 * Pi / iTramos

    oE.polyline.Clear

    For theta = 0 To 2 * Pi Step angle_increment
        ' el punto considerando 0,0 al centro
        x = oE.fParam[0] * Cos(theta)
        y = oE.fParam[0] * Sin(theta)
        PolyAux.Add(x)
        PolyAux.Add(y)

    Next
    x = oE.fParam[0]
    y = 0

    PolyAux.Add(x)
    PolyAux.Add(y)

    ' determino el plano
    centro3 = oe.P[0].Copy()
    For iTramos = 0 To PolyAux.Max Step 2
        px = puntos.LocalToGlobal(centro3, gcd.Drawing.Sheet.LastNormal, PolyAux[iTramos], PolyAux[iTramos + 1])
        If px Then oe.polyline.insert([px.x, px.y, px.z])
    Next
    oe.Extrusion.Insert(gcd.Drawing.Sheet.LastNormal.ToXYZ())

End

Public Sub DrawSelected(oE As Entity)

    glx.PolyLines(oE.PolyLine, gcd.ColorSelected(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End

'' A fat version of the entity
Public Sub DrawRemark(oE As Entity)

    glx.PolyLines(oE.PolyLine, gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oE.LineType.TrameLength)

End

Public Function Draw2(oE As Entity)

    paint.ARC(oE.P[0].x, oE.P[0].y, oE.fParam[0])

    paint.Stroke

End

Public Function SaveDxfData(e As Entity) As Boolean

    ' stxExport.insert(["CIRCLE", dxf.codEntity])
    ' Los datos comunes a todas las entidades son guardados por la rutina que llama a esta
    dxf.SaveCodeInv("AcDbCircle", "100")
    dxf.SaveCodeInv(CStr(e.P[0].x), dxf.codCenterX)
    dxf.SaveCodeInv(CStr(e.P[0].y), dxf.codCenterY)
    dxf.SaveCodeInv(CStr(e.fParam[0]), dxf.codRadius)
    If e.Extrusion[2] <> 1 Then
        dxf.SaveCodeInv(CStr(e.Extrusion[0]), "210")
        dxf.SaveCodeInv(CStr(e.Extrusion[1]), "220")
        dxf.SaveCodeInv(CStr(e.Extrusion[2]), "230")
    Endif

End

Public Function ImportDXF(e As Entity, sClaves As String[], sValues As String[]) As Boolean

    Dim i As Integer
    Dim flxP As New Float[]

    For i = 0 To sClaves.Max
        If sClaves[i] = "10" Then flxP.Add(CFloat(sValues[i]))
        If sClaves[i] = "20" Then flxP.Add(CFloat(sValues[i]))
        If sClaves[i] = "40" Then e.fParam[0] = (CFloat(sValues[i]))
    Next
    e.P = puntos.FromXY(flxP)

    If e.fParam.Count = 0 Then Stop ' e.fParam.Add(0)  ' TODO: averiguar q pasa aca q algunas entidades CIRCLE
    ' vienen sin el radio

    Return True

    ' catch

    Return False

End

'' Return if that position is over the entity within the tolerance
Fast Public Function OverMe(e As Entity, Xr As Float, Yr As Float, tolerance As Float) As Boolean

    If Abs(puntos.distancia(xr, yr, E.P[0].x, E.P[0].y) - E.fParam[0]) < tolerance Then Return True
    If puntos.Around(xr, yr, E.P[0].x, E.P[0].y, tolerance) Then Return True

    Return False

End

'' Genera un conjunto de grips para ser usados por cadSelection
Public Function GenerateGrips(e As Entity) As Integer

    Dim g As Grip
    Dim i, iCount As Integer
    Dim fAngle As Float
    Dim pQuad As Punto3d

    g = New Grip
    g.Shape = 0
    g.p = e.P[0].Copy()
    g.pRef = g.P.Copy()
    g.Action = 0 ' mover
    g.AsociatedEntity = e
    g.AsociatedPoint = 0
    gcd.Drawing.Sheet.Grips.Add(g)
    g.ToolTip = ("Move center")
    Inc iCount

    ' cuadrantes, en el mismo plano que usa makepolyline
    For i = 0 To 3
        fAngle = i * Pi / 2
        pQuad = puntos.LocalToGlobal(e.P[0], gcd.Drawing.Sheet.LastNormal, e.fParam[0] * Cos(fAngle), e.fParam[0] * Sin(fAngle))
        If Not pQuad Then Break
        g = New Grip
        g.Shape = 1
        g.p = pQuad
        g.pRef = g.P.Copy()
        g.Action = 1 ' este dato es propio de la clase
        g.AsociatedEntity = e
        g.AsociatedPoint = 0
        g.ToolTip = ("Change radius")
        gcd.Drawing.Sheet.Grips.Add(g)
        Inc iCount
    Next

    Return iCount

End

Public Function GripEdit(g As Grip) As Boolean

    Dim e As Entity
    Dim pLocal As Punto3d

    e = g.AsociatedEntity
    Select Case g.Action
        Case 0
            e.P[0] = g.P.Copy()

        Case 1
            ' distancia al centro medida en el plano del circulo
            pLocal = puntos.GlobalToLocal(g.P, e.P[0], gcd.Drawing.Sheet.LastNormal)
            If pLocal Then e.fParam[0] = Sqr(pLocal.x ^ 2 + pLocal.y ^ 2)
    End Select

    Me.BuildGeometry(e)

End

'' Determines if the entity was selected by a rectanle surrounding al points
'' by default, if ALL points are selected, it can.
Public Function SelFull(eTesting As Entity, X1real As Float, Y1real As Float, X2real As Float, Y2real As Float) As Boolean

    eTesting.PSel[0] = False
    If (eTesting.P[0].x - eTesting.fParam[0] > X1real) And (eTesting.P[0].x + eTesting.fParam[0] < X2real) And (eTesting.P[0].y - eTesting.fParam[0] > y1real) And (eTesting.P[0].y + eTesting.fParam[0] < y2real) Then
        eTesting.PSel[0] = True
        Return True

    Endif

End
