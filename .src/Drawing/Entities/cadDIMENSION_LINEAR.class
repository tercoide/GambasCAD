'' Cota lineal (horizontal, vertical o rotada). DXF tipo 0
''   P[3] = 13   origen de la linea de referencia 1
''   P[4] = 14   origen de la linea de referencia 2
''   P[0] = 10   punto sobre la linea de cota (queda en el extremo de la referencia 2)
''   P[1] = 11   centro del texto
''   fParam[ipaRotacion] = 50, el angulo de la medida en grados

Create Static
Inherits CadDimension

Public Const Gender As String = "DIMENSION_LINEAR"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert a linear dimension")
Public Const ParamType As String = "PPP"
Public Const ParamHelper As String = "First point;Second point;Dimension line location"
Public Const ParamDefault As String = " "
Public Const DimTypeCode As Integer = 0
Public Const DxfSubclass As String = "AcDbAlignedDimension"
Public Const GripPoints As String = "3;4;0;1"
Public Const GripTips As String = ("Move first point;Move second point;Move dimension line;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim eLast As Entity
    Dim iMode As Integer
    Dim fAng, nx, ny, fSide As Float

    If vParam[0] <> "point" Then Return False

    iMode = eBuild.iParam[Me.iiiMode]

    ' continuada (10) o de linea base (20): arranca de la ultima cota lineal
    If (iMode = 10 Or iMode = 20) And gcd.StepsDone = 0 Then
        eLast = gcd.Drawing.LastDimension
        If eLast Then
            If eLast.Gender <> cadDIMENSION_LINEAR.Gender And eLast.Gender <> cadDIMENSION_ALIGNED.Gender Then eLast = Null
        Endif
        If eLast Then
            fAng = LineAngle(eLast)
            eBuild.fParam[Me.ipaRotacion] = Deg(fAng)
            eBuild.iParam[Me.iiiMode] = 3
            eBuild.pDimStyle = eLast.pDimStyle.Copy()
            If iMode = 10 Then
                eBuild.P[3] = eLast.P[4].Copy()
                eBuild.P[0] = eLast.P[0].Copy()
            Else
                eBuild.P[3] = eLast.P[3].Copy()
                ' la nueva linea de cota, mas afuera
                nx = -Sin(fAng)
                ny = Cos(fAng)
                fSide = (eLast.P[0].x - eLast.P[3].x) * nx + (eLast.P[0].y - eLast.P[3].y) * ny
                If fSide < 0 Then
                    nx = -nx
                    ny = -ny
                Endif
                eBuild.P[0] = puntos.P3d(eLast.P[0].x + nx * eBuild.pDimStyle.DIMDLI * Me.DimScale(eBuild), eLast.P[0].y + ny * eBuild.pDimStyle.DIMDLI * Me.DimScale(eBuild), eLast.P[0].z)
            Endif
            Me.DimContinued = True
            gcd.StepsDone = 1
        Else
            eBuild.iParam[Me.iiiMode] = 0
            Me.DimContinued = False
        Endif
    Endif

    If gcd.StepsDone = 0 Then

        eBuild.P[3] = Me.ParamPoint(vParam)
        eBuild.P[4] = eBuild.P[3].Copy()
        eBuild.P[0] = eBuild.P[3].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then

        eBuild.P[4] = Me.ParamPoint(vParam)
        If Not Me.DimContinued Then eBuild.P[0] = eBuild.P[4].Copy()
        SetAngle(eBuild)
        Me.Rebuild(eBuild)
        If Definitive Then
            If Me.DimContinued Then Inc gcd.StepsDone
            Return True
        Endif

    Else If gcd.StepsDone = 2 Then

        eBuild.P[0] = Me.ParamPoint(vParam)
        SetAngle(eBuild)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

'' El angulo de la medida segun el modo de construccion
Private Sub SetAngle(e As Entity)

    Dim iMode As Integer
    Dim x1, x2, y1, y2 As Float

    iMode = e.iParam[Me.iiiMode]
    If iMode = 1 Then
        e.fParam[Me.ipaRotacion] = 0
    Else If iMode = 2 Then
        e.fParam[Me.ipaRotacion] = 90
    Else If iMode >= 1000 Then
        e.fParam[Me.ipaRotacion] = iMode / 1000
    Else If iMode = 0 Then
        ' depende de donde este la linea de cota respecto de los puntos
        x1 = Min(e.P[3].x, e.P[4].x)
        x2 = Max(e.P[3].x, e.P[4].x)
        y1 = Min(e.P[3].y, e.P[4].y)
        y2 = Max(e.P[3].y, e.P[4].y)
        If (e.P[0].x < x1 Or e.P[0].x > x2) And (e.P[0].y >= y1 And e.P[0].y <= y2) Then
            e.fParam[Me.ipaRotacion] = 90
        Else If (e.P[0].y < y1 Or e.P[0].y > y2) And (e.P[0].x >= x1 And e.P[0].x <= x2) Then
            e.fParam[Me.ipaRotacion] = 0
        Else If Abs(e.P[3].x - e.P[4].x) >= Abs(e.P[3].y - e.P[4].y) Then
            e.fParam[Me.ipaRotacion] = 0
        Else
            e.fParam[Me.ipaRotacion] = 90
        Endif
    Endif

End

'' El angulo de la linea de cota, en radianes
Public Function LineAngle(e As Entity) As Float

    If e.Gender = cadDIMENSION_ALIGNED.Gender Then Return Ang(e.P[4].x - e.P[3].x, e.P[4].y - e.P[3].y)
    Return Rad(e.fParam[Me.ipaRotacion])

End

Public Sub MakeBlock(e As Entity)

    MakeLinear(e, LineAngle(e))

End

'' Cotas lineales y alineadas: la linea de cota pasa por P[0] con el angulo fAng
Public Sub MakeLinear(e As Entity, fAng As Float)

    Dim ux, uy, t1, t2, d1x, d1y, d2x, d2y, vx, vy, fSide, fMeasure As Float
    Dim flxText As Float[]
    Dim sText As String

    ux = Cos(fAng)
    uy = Sin(fAng)

    ' proyecto los puntos medidos sobre la linea de cota
    t1 = (e.P[3].x - e.P[0].x) * ux + (e.P[3].y - e.P[0].y) * uy
    t2 = (e.P[4].x - e.P[0].x) * ux + (e.P[4].y - e.P[0].y) * uy
    d1x = e.P[0].x + ux * t1
    d1y = e.P[0].y + uy * t1
    d2x = e.P[0].x + ux * t2
    d2y = e.P[0].y + uy * t2

    fMeasure = Abs(t2 - t1)
    e.fParam[Me.ipaRealMeasure] = fMeasure * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor

    ' hacia donde queda la linea de cota respecto de los puntos medidos
    vx = -uy
    vy = ux
    fSide = (e.P[0].x - e.P[3].x) * vx + (e.P[0].y - e.P[3].y) * vy
    If fSide < 0 Then
        vx = -vx
        vy = -vy
    Endif

    If Not e.pDimStyle.DIMSE1 Then Me.AddExtLine(e, e.P[3].x, e.P[3].y, d1x, d1y)
    If Not e.pDimStyle.DIMSE2 Then Me.AddExtLine(e, e.P[4].x, e.P[4].y, d2x, d2y)

    sText = Me.LinearText(e, fMeasure)
    flxText = Me.AddDimLine(e, d1x, d1y, d2x, d2y, sText, vx, vy)

    ' como en el DXF, el 10 queda en el extremo de la referencia 2
    e.P[0].x = d2x
    e.P[0].y = d2y
    e.P[1].x = flxText[0]
    e.P[1].y = flxText[1]

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv("AcDbAlignedDimension", "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)
    dxf.SaveCodeInv("AcDbRotatedDimension", "100")
    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaRotacion]), "50")
    If e.fParam[Me.ipaObliqueAngle] <> 0 Then dxf.SaveCodeInv(CStr(e.fParam[Me.ipaObliqueAngle]), "52")

End
