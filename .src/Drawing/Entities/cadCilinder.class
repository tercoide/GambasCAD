' Gambas class file

Inherits CadParallelepiped
Public Const Gender As String = "CILINDER"
Public Const CmdLineHelper As String = ("Draws a cilinder: Height vector 3D")
Public Const ParamType As String = "point3d"                             ' that is Point, Point, Float; could be Color Text, etc
Public Const ParamHelper As String = "height"      ' a little text that is shown at the prompt waiting for user input during
Public Const TotalParams As Integer = 3

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    Dim f As Float
    Dim ip As Integer
    Dim rta As New Collection

    'If definitive Then Stop
    If Me.ExpectedParam = "height" Then
        If vParam[0] = "point3d" Then
            If Definitive Then

                eBuild.fParam.Clear
                eBuild.fParam.Add(vParam[1])        ' X
                eBuild.fParam.Add(vParam[2])        ' Y
                eBuild.fParam.Add(vParam[3])        ' Z
                eBuild.fParam.Add(0)                ' el factor de base es 0 en un cono

                eBuild.fParam.Add(0)                ' radius

                Me.ExpectedParam = "base"

                Return ["prompt": "Base factor", "next": "float"]
            End If
        End If
    End If

    If Me.ExpectedParam = "base" Then
        If vParam[0] = "float" Then
            If Definitive Then

                eBuild.fParam[3] = vParam[1]        'base1/base2 factor: 1=equal 0=base2 is a point

                Me.ExpectedParam = "center"

                Return ["prompt": "base center point", "next": "point3d"]
            End If
        End If
    End If

    If Me.ExpectedParam = "center"
        If vParam[0] = "point3d" Then

            eBuild.P.Clear
            eBuild.P.Insert([0, 0, 0])

            eBuild.P[0] = vParam[1]
            eBuild.P[1] = vParam[2]
            eBuild.P[2] = vParam[3]
            If Definitive Then

                Me.ExpectedParam = "radius"

                Return ["prompt": "radius", "next": "float"]
            End If
        End If
    End If

    If Me.ExpectedParam = "radius" Then
        If vParam[0] = "float" Then

            eBuild.fParam[4] = vParam[1]
            If Definitive Then
                eBuild.pBlock.Faces[0].Id = gcd.NewId()

                Return ["command": "end"]
            End If
        End If
    End If

    Return

End

Public Sub makepolyline(oe As Entity)

    Dim iCaras As Integer
    Dim i As Integer
    Dim f1, f2, fRect As Face
    Dim F As Face[]
    Dim p, p2 As Punto3d

    Dim pPolygon As Punto3d[]
    Dim i2 As Integer

    F = oe.pBlock.faces
    ' base
    If oe.P.Count < 3 Then Return
    Dim x, y, theta, angle_increment As Float
    Dim iTramos As Integer

    iTramos = oE.fParam[4] * 2 * Pi / gcd.metros(Config.ArcDensity)

    If iTramos < 6 Then iTramos = 18
    If iTramos > 64 Then iTramos = 64
    angle_increment = 2 * Pi / iTramos

    f1 = f[0]
    f1.vertex.Clear
    f1.colour = oe.Colour
    For theta = 0 To 2 * Pi Step angle_increment
        ' el punto considerando 0,0 al centro
        p2 = glx.XYZ(oE.fParam[4] * Cos(theta), oE.fParam[4] * Sin(theta))
        p = New Punto3d
        p.x = oE.p[0] + p2.x
        p.y = oE.p[1] + p2.y
        p.z = oE.p[2] + p2.z
        f1.vertex.Add(p)

    Next
    ' p = New Punto3d
    ' p.x = oE.p[0] + oE.fParam[0]
    ' p.y = oE.p[1]
    ' f1.vertex.Add(p)
    ' ahora que terminamos la cara le ponemos un Id

    Super.makepolyline(oe)

End
