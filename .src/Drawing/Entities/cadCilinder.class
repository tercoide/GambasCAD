' Gambas class file

Inherits CadParallelepiped
Public Const Gender As String = "CILINDER"
Public Const CmdLineHelper As String = ("Draws a cilinder")
Public Const ParamType As String = "FPL"                             ' that is Point, Point, Float; could be Color Text, etc
Public Const ParamHelper As String = "Height;Center;Radious"      ' a little text that is shown at the prompt waiting for user input during
Public Const TotalParams As Integer = 2

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Boolean

    Dim f As Float
    Dim ip As Integer

    If gcd.StepsDone = 0 Then

        If vParam[0] <> "float" Then Return False

        eBuild.fParam[1] = vParam[1]

        If definitive Then Return True

    Else If gcd.StepsDone = 1 Then

        If vParam[0] <> "point" Then Return False
        Try eBuild.P[0] = vParam[1]
        Try eBuild.P[1] = vParam[2]

        If definitive Then
            eBuild.fParam.Add(0)
            Return True
        End If
    Else If gcd.StepsDone = 2 Then

        If vParam[0] <> "float" Then Return False

        eBuild.fParam[0] = vParam[1]

        If definitive Then Return True

    End If

    Return False

End

Public Sub makepolyline(oe As Entity)

    Dim x, y, theta, angle_increment As Float
    Dim iTramos As Integer

    ' If oe.id = "DB8C" Then Stop
    iTramos = oE.fParam[0] * 2 * Pi / gcd.metros(Config.ArcDensity)

    If iTramos < 6 Then iTramos = 18
    If iTramos > 360 Then iTramos = 360
    angle_increment = 2 * Pi / iTramos

    oE.polyline.Clear

    For theta = 0 To 2 * Pi Step angle_increment
        ' el punto considerando 0,0 al centro
        x = oE.p[0] + oE.fParam[0] * Cos(theta)
        y = oE.p[1] + oE.fParam[0] * Sin(theta)
        oE.polyline.Add(x)
        oE.polyline.Add(y)

    Next
    x = oE.p[0] + oE.fParam[0]
    y = oE.p[1]

    oE.polyline.Add(x)
    oE.polyline.Add(y)

End

Public Sub Draw(oE As Entity)

    Dim fPoints As Float[]
    Dim fColor4 As Integer
    Dim bIntersects As Boolean
    Dim f As Face
    Dim pTriangles As Punto3d
    Dim fTriangles As Float[]

    ' If Not oe.Generated Then
    '     Super.Draw(oe)
    '     Return
    ' Endif

    glx.PolyLines(oe.PolyLine, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

    For Each f In oe.pBlock.faces

        If f.vertex.Count > 1 Then ' dibujo el contorno
            fPoints = puntos.RemoveAxis(puntos.Create3dArray(f.vertex))    ' paso de Punto3D a XYZ triplets y le saco el Z

            fColor4 = gcd.GetGBColor(oE.Colour, oe.pLayer)

            glx.Polygon(fPoints, fColor4, gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)
        End If
        If (f.vertex.Count >= 3) And Not bIntersects Then ' dibujo el contorno
            'pTriangles = puntos.PolygonTriangulation3D(f.vertex)
            fTriangles = puntos.PolygonTriangulation3D(f.vertex) ' puntos.Create3dArray(pTriangles)
            If f.vertex.Count = 4 Then
                fColor4 = 0
            End If
            '            If fTriangles.Count = 0 Then Stop
            glx.DrawTriangles3D(fTriangles, Color.Darker(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer))
        End If

    Next

    cadParallelepiped.DrawWireFrame(oe)

End
' This function will return False if the element couldn't be created for some reason: bad or incomple user input
' True means all is good, False will instruct the clsENTITYBUILDER to delete it

Public Sub Finish(oe As Entity) As Boolean

    Dim iCaras As Integer
    Dim i As Integer
    Dim f1, f2, fRect As Face
    Dim F As Face[]
    Dim p, p2 As Punto3d

    Dim pPolygon As Punto3d[]
    Dim i2 As Integer

    F = oe.pBlock.faces
    ' base

    Dim x, y, theta, angle_increment As Float
    Dim iTramos As Integer

    iTramos = oE.fParam[0] * 2 * Pi / gcd.metros(Config.ArcDensity)

    If iTramos < 6 Then iTramos = 18
    If iTramos > 64 Then iTramos = 64
    angle_increment = 2 * Pi / iTramos

    oE.polyline.Clear
    f1 = New Face
    For theta = 0 To 2 * Pi Step angle_increment
        ' el punto considerando 0,0 al centro
        p = New Punto3d
        p.x = oE.p[0] + oE.fParam[0] * Cos(theta)
        p.y = oE.p[1] + oE.fParam[0] * Sin(theta)
        p.z = 0
        f1.vertex.Add(p)

    Next
    p = New Punto3d
    p.x = oE.p[0] + oE.fParam[0]
    p.y = oE.p[1]
    f1.vertex.Add(p)

    F.Add(f1)

    ' primero replicamos los puntos de la cara a la altura indicada
    f2 = New Face
    For Each p In f1.vertex
        p2 = gcd.NewVertex(p.x, p.y, oE.fParam[1])
        f2.vertex.Add(p2)
    Next

    f.Add(f2)

    ' ahora creamos las caras rectangulares
    For i = 0 To f1.vertex.Max
        i2 = i + 1
        If i2 = f1.vertex.Count Then i2 = 0
        fRect = New Face
        fRect.vertex.Add(f1.vertex[i])
        fRect.vertex.Add(f1.vertex[i2])
        fRect.vertex.Add(f2.vertex[i2])
        fRect.vertex.Add(f2.vertex[i])
        f.Add(fRect)

    Next
    oe.Generated = True

End
