'' Cota angular de tres puntos. DXF tipo 5 (las de dos lineas, tipo 2, se pasan a esta al leerlas)
''   P[5] = 15   vertice del angulo
''   P[3] = 13   punto sobre el primer lado
''   P[4] = 14   punto sobre el segundo lado
''   P[0] = 10   ubicacion del arco de cota
''   P[1] = 11   centro del texto
'' Tambien arma las cotas de largo de arco (ver cadARC_DIMENSION)

Create Static
Inherits CadDimension

Public Const Gender As String = "DIMENSION_ANG3PT"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert an angular dimension")
Public Const ParamType As String = "PPPP"
Public Const ParamHelper As String = "Vertex;Point on first side;Point on second side;Arc location"
Public Const DimTypeCode As Integer = 5
Public Const DxfSubclass As String = "AcDb3PointAngularDimension"
Public Const GripPoints As String = "5;3;4;0;1"
Public Const GripTips As String = ("Move vertex;Move first side;Move second side;Move arc;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If vParam[0] <> "point" Then Return False

    If gcd.StepsDone = 0 Then

        eBuild.P[5] = Me.ParamPoint(vParam)
        eBuild.P[3] = eBuild.P[5].Copy()
        eBuild.P[4] = eBuild.P[5].Copy()
        eBuild.P[0] = eBuild.P[5].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then

        eBuild.P[3] = Me.ParamPoint(vParam)
        eBuild.P[4] = eBuild.P[3].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 2 Then

        eBuild.P[4] = Me.ParamPoint(vParam)
        ' el arco provisorio, a mitad de camino
        eBuild.P[0] = puntos.P3d((eBuild.P[3].x + eBuild.P[4].x) / 2, (eBuild.P[3].y + eBuild.P[4].y) / 2, eBuild.P[4].z)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Else If gcd.StepsDone = 3 Then

        eBuild.P[0] = Me.ParamPoint(vParam)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

Public Sub MakeBlock(e As Entity)

    MakeAngular(e, False)

End

'' Angulos y largo de arco. El arco de cota tiene centro en P[5] y pasa por P[0]
Public Sub MakeAngular(e As Entity, bArcLength As Boolean)

    Dim d As DimStyle = e.pDimStyle
    Dim vx, vy, r, a1, a2, aLoc, aStart, aEnd, fSweep, am, th, tw, gap, asz, tcx, tcy, ta, ra, fHalf, fArc, r1, fRel As Float
    Dim sText As String
    Dim bArrowsOut, bTextOnArc, bTick As Boolean

    vx = e.P[5].x
    vy = e.P[5].y
    r = Sqr((e.P[0].x - vx) ^ 2 + (e.P[0].y - vy) ^ 2)
    If r = 0 Then Return

    a1 = Ang(e.P[3].x - vx, e.P[3].y - vy)
    a2 = Ang(e.P[4].x - vx, e.P[4].y - vy)
    aLoc = Ang(e.P[0].x - vx, e.P[0].y - vy)

    ' el lado del angulo donde esta el arco
    If AngleInSweep(aLoc, a1, a2) Then
        aStart = a1
        aEnd = a2
    Else
        aStart = a2
        aEnd = a1
    Endif
    fSweep = Utils.fMod(aEnd - aStart, 2 * Pi)
    If fSweep < 0 Then fSweep += 2 * Pi

    r1 = Sqr((e.P[3].x - vx) ^ 2 + (e.P[3].y - vy) ^ 2)
    If bArcLength Then
        e.fParam[Me.ipaRealMeasure] = fSweep * r1 * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor
        e.fParam[Me.ipaArcStart] = aStart
        e.fParam[Me.ipaArcEnd] = aEnd
        sText = Me.LinearText(e, fSweep * r1, "L=")
    Else
        e.fParam[Me.ipaRealMeasure] = Deg(fSweep)
        sText = Me.AngularText(e, Deg(fSweep))
    Endif

    th = Me.TextHeight(e)
    tw = Me.TextWidth(e, sText)
    gap = d.DIMGAP * Me.DimScale(e)
    asz = d.DIMASZ * Me.DimScale(e)
    bTick = DimStyle.IsTick(d.Marker(1)) Or DimStyle.IsTick(d.Marker(2))

    ' lineas de referencia, sobre los lados
    If Not d.DIMSE1 Then AddRadialExt(e, vx, vy, a1, Sqr((e.P[3].x - vx) ^ 2 + (e.P[3].y - vy) ^ 2), r)
    If Not d.DIMSE2 Then AddRadialExt(e, vx, vy, a2, Sqr((e.P[4].x - vx) ^ 2 + (e.P[4].y - vy) ^ 2), r)

    fArc = fSweep * r
    bArrowsOut = Not bTick And fArc < asz * 2.2

    ' el texto
    am = aStart + fSweep / 2
    If Me.UserText(e) Then
        tcx = e.P[1].x
        tcy = e.P[1].y
        ta = Me.ReadableAngle(Ang(tcx - vx, tcy - vy) - Pi / 2)
    Else
        ra = r
        If d.DIMTAD = 1 Or d.DIMTAD = 2 Then ra = r + th / 2 + gap
        If d.DIMTAD = 4 Then ra = r - th / 2 - gap
        tcx = vx + ra * Cos(am)
        tcy = vy + ra * Sin(am)
        ta = Me.ReadableAngle(am - Pi / 2)
    Endif
    If d.DIMTIH Then ta = 0

    ' si el texto esta sobre el arco, lo corto
    bTextOnArc = Abs(Sqr((tcx - vx) ^ 2 + (tcy - vy) ^ 2) - r) < th / 2 + gap / 2 And AngleInSweep(Ang(tcx - vx, tcy - vy), aStart, aEnd)
    If bTextOnArc And sText <> "" Then
        fHalf = (tw / 2 + gap) / r
        fRel = Utils.fMod(Ang(tcx - vx, tcy - vy) - aStart, 2 * Pi)
        If fRel < 0 Then fRel += 2 * Pi
        If fRel - fHalf > 0 Then Me.AddArc(e, vx, vy, r, Deg(aStart), Deg(aStart + fRel - fHalf), Me.PartDimLine)
        If fRel + fHalf < fSweep Then Me.AddArc(e, vx, vy, r, Deg(aStart + fRel + fHalf), Deg(aStart + fSweep), Me.PartDimLine)
    Else If fSweep > 0 Then
        Me.AddArc(e, vx, vy, r, Deg(aStart), Deg(aStart + fSweep), Me.PartDimLine)
    Endif

    ' marcadores, tangentes al arco
    If bArrowsOut Then
        Me.AddMarker(e, d.Marker(1), vx + r * Cos(aStart), vy + r * Sin(aStart), aStart + Pi / 2)
        Me.AddMarker(e, d.Marker(2), vx + r * Cos(aEnd), vy + r * Sin(aEnd), aEnd - Pi / 2)
        Me.AddArc(e, vx, vy, r, Deg(aStart) - Deg(asz * 2 / r), Deg(aStart), Me.PartDimLine)
        Me.AddArc(e, vx, vy, r, Deg(aEnd), Deg(aEnd) + Deg(asz * 2 / r), Me.PartDimLine)
    Else
        Me.AddMarker(e, d.Marker(1), vx + r * Cos(aStart), vy + r * Sin(aStart), aStart - Pi / 2)
        Me.AddMarker(e, d.Marker(2), vx + r * Cos(aEnd), vy + r * Sin(aEnd), aEnd + Pi / 2)
    Endif

    Me.AddText(e, sText, tcx, tcy, ta)
    e.P[1].x = tcx
    e.P[1].y = tcy

End

'' La linea de referencia sobre un lado: desde el punto medido hasta el arco de cota
Public Sub AddRadialExt(e As Entity, vx As Float, vy As Float, fAng As Float, rPoint As Float, rArc As Float)

    Dim exo, exe As Float

    exo = e.pDimStyle.DIMEXO * Me.DimScale(e)
    exe = e.pDimStyle.DIMEXE * Me.DimScale(e)
    If rArc > rPoint + exo Then
        Me.AddLine(e, vx + (rPoint + exo) * Cos(fAng), vy + (rPoint + exo) * Sin(fAng), vx + (rArc + exe) * Cos(fAng), vy + (rArc + exe) * Sin(fAng), Me.PartExtLine)
    Else If rArc < rPoint - exo Then
        Me.AddLine(e, vx + (rPoint - exo) * Cos(fAng), vy + (rPoint - exo) * Sin(fAng), vx + (rArc - exe) * Cos(fAng), vy + (rArc - exe) * Sin(fAng), Me.PartExtLine)
    Endif

End

'' True si el angulo a esta en el barrido antihorario de a0 a a1
Public Function AngleInSweep(a As Float, a0 As Float, a1 As Float) As Boolean

    Dim fSweep, fA As Float

    fSweep = Utils.fMod(a1 - a0, 2 * Pi)
    If fSweep < 0 Then fSweep += 2 * Pi
    fA = Utils.fMod(a - a0, 2 * Pi)
    If fA < 0 Then fA += 2 * Pi
    Return fA <= fSweep

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv(Me.DxfSubclass, "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)
    Me.SavePoint(e, 5)

End
