Create Static
'Create Private
'Fast Unsafe
Inherits EntityBase

Public Const Gender As String = "LINE"
Public Const DrawingOrder As Integer = 1        ' 1 = draws first
Public Const CmdLineHelper As String = ("a line")
Public Const ParamType As String = "point2d"                             ' that is Point, Point; could be Color Text, etc
Public Const ParamHelper As String = "start"
Public Const TotalPoints As Integer = 2

' The entity handler receives a user action, and returns the number of expected parameter
' If definitive = true, means the parameter is set
Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    ' la linea solo recibe puntos

    If vParam[0] <> "point2d" Then Return False

    If Me.ExpectedParam = "start" Then
        Try eBuild.P[0].x = vParam[1]
        Try eBuild.P[0].y = vParam[2]
        eBuild.P[1].x = eBuild.P[0].x
        eBuild.P[1].y = eBuild.P[0].y
        If Definitive Then

            Me.ExpectedParam = "end"

            Return ["next": "point2d", "prompt": "end point"]
        End If
    Else If Me.ExpectedParam = "end" Then

        Try eBuild.P[1].x = vParam[1]
        Try eBuild.P[1].y = vParam[2]
        If Definitive Then Return ["command": "end"]

    Endif

End

Public Sub Draw(oE As Entity)

    Dim i As Integer

    If oe.LineType.TrameLength.Count > 0 Then
        oE.PolyLine = puntos.DashedLineStrip(puntos.ToXY(oe.P), oe.LineType.TrameLength)

        Dim fPoints As New Float[]

        For i = 0 To oE.PolyLine.Max - 3 Step 4
            If (oE.PolyLine[i] = oE.PolyLine[i + 2]) And (oE.PolyLine[i + 1] = oE.PolyLine[i + 3]) Then

                fPoints.Add(oE.PolyLine[i])
                fPoints.Add(oE.PolyLine[i + 1])
            End If

        Next
        glx.Drawpoints(fPoints, gcd.GetGBColor(oE.Colour, oe.pLayer), 1)
        glx.DrawLinesP(oe.P, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)
    Else
        glx.DrawLinesP(oe.P, gcd.GetGBColor(oE.Colour, oe.pLayer), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)
    End If

End

'' Hides the entity
Public Sub DrawShadow(e As Entity)

    glx.DrawLinesP(e.P, Config.ModelBackgroundColor)

End

'' A fat version of the line
Public Sub DrawSelected(oE As Entity)

    glx.DrawLinesP(oE.P, Gcd.ColorSelected(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer), oE.LineType.TrameLength)

End
'' A fat version of the line

Public Sub DrawRemark(oE As Entity)

    If Not oE.Visible Then Return

    glx.DrawLinesP(oE.P, Gcd.ColorRemark(gcd.GetGBColor(oE.Colour, oe.pLayer)), gcd.GetLineWt(oE.LineWIdth, oe.pLayer) + 1, oe.LineType.TrameLength)

End

'' The paint version of the entity
Public Function Draw2(oE As Entity)

    paintPlus.Lines(puntos.ToXY(oE.P))

End

