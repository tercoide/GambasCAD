'' Cota de radio grande, con quiebre (entidad LARGE_RADIAL_DIMENSION del DXF)
''   P[0] = 10   centro verdadero
''   P[5] = 15   punto sobre la curva
''   P[3] = 13   centro aparente, donde arranca la linea de cota
''   P[4] = 14   punto del quiebre
''   P[1] = 11   centro del texto

Create Static
Inherits CadDimension

Public Const Gender As String = "LARGE_RADIAL_DIMENSION"
Public Const DrawingOrder As Integer = 100
Public Const PointsToDraw As Integer = 1
Public Const CmdLineHelper As String = ("Insert a jogged radius dimension")
Public Const ParamType As String = "PPPP"
Public Const ParamHelper As String = "Center;Point on the curve;Apparent center;Jog location"
Public Const DimTypeCode As Integer = 9
Public Const DxfSubclass As String = "AcDbRadialDimensionLarge"
Public Const GripPoints As String = "0;5;3;4;1"
Public Const GripTips As String = ("Move center;Move point on the curve;Move apparent center;Move jog;Move text")

Public Function NewParameter(eBuild As Entity, vParam As Variant[], Optional Definitive As Boolean = False) As Variant

    If vParam[0] <> "point" Then Return False

    If gcd.StepsDone = 0 Then

        eBuild.P[0] = Me.ParamPoint(vParam)
        eBuild.P[5] = eBuild.P[0].Copy()
        eBuild.P[3] = eBuild.P[0].Copy()
        eBuild.P[4] = eBuild.P[0].Copy()
        If Definitive Then Return True

    Else If gcd.StepsDone = 1 Then

        eBuild.P[5] = Me.ParamPoint(vParam)
        eBuild.P[3] = eBuild.P[0].Copy()
        eBuild.P[4] = puntos.P3d((eBuild.P[0].x + eBuild.P[5].x) / 2, (eBuild.P[0].y + eBuild.P[5].y) / 2, eBuild.P[5].z)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Else If gcd.StepsDone = 2 Then

        eBuild.P[3] = Me.ParamPoint(vParam)
        eBuild.P[4] = puntos.P3d((eBuild.P[3].x + eBuild.P[5].x) / 2, (eBuild.P[3].y + eBuild.P[5].y) / 2, eBuild.P[5].z)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Else If gcd.StepsDone = 3 Then

        eBuild.P[4] = Me.ParamPoint(vParam)
        Me.Rebuild(eBuild)
        If Definitive Then Return True

    Endif

End

Public Sub MakeBlock(e As Entity)

    Dim d As DimStyle = e.pDimStyle
    Dim r, ux, uy, ax, ay, bx, by, t, th, gap, ta, tcx, tcy As Float
    Dim sText As String

    r = Sqr((e.P[5].x - e.P[0].x) ^ 2 + (e.P[5].y - e.P[0].y) ^ 2)
    If r > 0 Then
        ux = (e.P[5].x - e.P[0].x) / r
        uy = (e.P[5].y - e.P[0].y) / r
    Else
        ux = 1
        uy = 0
    Endif
    e.fParam[Me.ipaRealMeasure] = r * e.pDimStyle.DIMLFAC     ' como en el DXF, con el factor
    If e.fParam[Me.ipaJogAngle] = 0 Then e.fParam[Me.ipaJogAngle] = Pi / 4
    sText = Me.LinearText(e, r, "R")

    ' A: sobre la paralela que sale del centro aparente; B: sobre el radio verdadero; los dos a la altura del quiebre
    t = (e.P[4].x - e.P[3].x) * ux + (e.P[4].y - e.P[3].y) * uy
    ax = e.P[3].x + ux * t
    ay = e.P[3].y + uy * t
    t = (e.P[4].x - e.P[0].x) * ux + (e.P[4].y - e.P[0].y) * uy
    bx = e.P[0].x + ux * t
    by = e.P[0].y + uy * t

    Me.AddLine(e, e.P[3].x, e.P[3].y, ax, ay, Me.PartDimLine)
    Me.AddLine(e, ax, ay, e.P[4].x, e.P[4].y, Me.PartDimLine)
    Me.AddLine(e, e.P[4].x, e.P[4].y, bx, by, Me.PartDimLine)
    Me.AddLine(e, bx, by, e.P[5].x, e.P[5].y, Me.PartDimLine)
    Me.AddMarker(e, d.Marker(2), e.P[5].x, e.P[5].y, Ang(ux, uy))

    ' el texto sobre el ultimo tramo
    th = Me.TextHeight(e)
    gap = d.DIMGAP * Me.DimScale(e)
    ta = Me.ReadableAngle(Ang(ux, uy))
    If d.DIMTIH Then ta = 0
    If Me.UserText(e) Then
        tcx = e.P[1].x
        tcy = e.P[1].y
    Else
        tcx = (bx + e.P[5].x) / 2
        tcy = (by + e.P[5].y) / 2
        If d.DIMTAD <> 0 Then
            tcx += -Sin(ta) * (th / 2 + gap) * IIf(d.DIMTAD = 4, -1, 1)
            tcy += Cos(ta) * (th / 2 + gap) * IIf(d.DIMTAD = 4, -1, 1)
        Endif
    Endif
    Me.AddText(e, sText, tcx, tcy, ta)
    e.P[1].x = tcx
    e.P[1].y = tcy

End

Public Sub SaveDxfPoints(e As Entity)

    dxf.SaveCodeInv(Me.DxfSubclass, "100")
    Me.SavePoint(e, 3)
    Me.SavePoint(e, 4)
    Me.SavePoint(e, 5)
    dxf.SaveCodeInv(CStr(e.fParam[Me.ipaJogAngle]), "40")

End
